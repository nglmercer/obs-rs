import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { LocaleOption, ProfileRow } from "models.slint";
import { I18n } from "i18n.slint";

export component StudioHeader inherits Rectangle {
    in property <string> project-title;
    in property <string> profile-name;
    in property <string> locale;
    in property <bool> dirty;
    in property <[ProfileRow]> profile-rows;
    in property <[LocaleOption]> locale-options;
    callback select-profile(string);
    callback set-locale(string);
    horizontal-stretch: 1;

            HorizontalBox {
                spacing: 14px;

                VerticalBox {
                    spacing: 3px;
                    Text {
                        text: I18n.text.app_name;
                        color: rgb(249, 250, 251);
                        font-size: 26px;
                        font-weight: 700;
                    }
                    Text {
                        text: project-title + "  /  " + profile-name;
                        color: rgb(156, 163, 175);
                        font-size: 14px;
                    }
                    Text {
                        text: I18n.text.shortcuts;
                        color: rgb(100, 116, 139);
                        font-size: 11px;
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: I18n.text.profile;
                            color: rgb(148, 163, 184);
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        for profile in profile-rows : Button {
                            text: profile.name;
                            clicked => select-profile(profile.id);
                        }
                        Text {
                            text: I18n.text.language;
                            color: rgb(148, 163, 184);
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        for option in locale-options : Button {
                            text: option.label;
                            clicked => set-locale(option.code);
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: dirty
                        ? I18n.text.unsaved_project
                        : I18n.text.saved_project;
                    color: dirty ? rgb(251, 191, 36) : rgb(134, 239, 172);
                    vertical-alignment: center;
                    font-size: 14px;
                }
            }
}
