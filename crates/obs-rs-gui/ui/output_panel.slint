import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { MutedText, PanelHeading, StudioPanel } from "theme.slint";
import { I18n } from "i18n.slint";

export component OutputPanel inherits Rectangle {
    in property <string> locale;
    in property <string> transition;
    in property <bool> recording;
    in property <bool> streaming;
    in property <string> recording-path;
    in property <string> streaming-address;
    in property <string> output-status;
    in property <string> output-metrics;
    callback swap-scenes();
    callback cut-transition();
    callback fade-transition();
    callback toggle-recording();
    callback toggle-streaming();
    callback open-output-dialog();

    background: transparent;
    VerticalBox {
        spacing: 10px;
        PanelHeading {
            text: I18n.text.output_title;
        }
        MutedText {
            text: I18n.text.output_description;
        }
        StudioPanel {
            height: 94px;
            VerticalBox {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: I18n.text.current_transition + transition;
                    color: rgb(226, 232, 240);
                    font-size: 12px;
                    font-weight: 700;
                }
                HorizontalBox {
                    spacing: 6px;
                    Button {
                        text: I18n.text.swap_preview_program;
                        clicked => swap-scenes();
                    }
                    Button {
                        text: I18n.text.cut;
                        clicked => cut-transition();
                    }
                    Button {
                        text: I18n.text.fade;
                        clicked => fade-transition();
                    }
                }
            }
        }
        StudioPanel {
            height: 108px;
            VerticalBox {
                padding: 12px;
                spacing: 7px;
                Text {
                    text: I18n.text.destinations;
                    color: rgb(226, 232, 240);
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: I18n.text.record_prefix + recording-path;
                    color: rgb(148, 163, 184);
                    font-size: 11px;
                    overflow: elide;
                }
                Text {
                    text: I18n.text.stream_prefix + streaming-address;
                    color: rgb(148, 163, 184);
                    font-size: 11px;
                    overflow: elide;
                }
                HorizontalBox {
                    spacing: 6px;
                    Button {
                        text: I18n.text.configure;
                        clicked => open-output-dialog();
                    }
                    Button {
                        text: recording
                            ? I18n.text.stop_recording
                            : I18n.text.start_recording;
                        clicked => toggle-recording();
                    }
                    Button {
                        text: streaming
                            ? I18n.text.stop_streaming
                            : I18n.text.start_streaming;
                        clicked => toggle-streaming();
                    }
                }
            }
        }
        Text {
            text: output-status;
            color: rgb(251, 191, 36);
            font-size: 11px;
            wrap: word-wrap;
        }
        MutedText { text: output-metrics; }
        Rectangle { vertical-stretch: 1; }
    }
}
