    theme_midnight: string,
    theme_slate: string,
    theme_hint: string,
    group_service: string,
    stream_server: string,
    stream_hint: string,
    group_recording: string,
    recording_path: string,
    recording_format: string,
    recording_hint: string,
    group_audio_general: string,
