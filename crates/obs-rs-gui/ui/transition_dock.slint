import { Button, CheckBox, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";
import { CompactButton, DockHeader } from "theme.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";
import { TransitionDirectionField } from "transition_direction.slint";

export component TransitionDock inherits Rectangle {
    in property <string> locale;
    in property <string> transition;
    in property <string> transition-kind;
    in-out property <int> transition-direction-index: 0;
    in-out property <bool> swipe-in: false;
    in property <int> panel-kind;
    in property <bool> floating;
    callback move-panel(int, int);
    callback dock-drag-start(int, float, float);
    callback dock-drag-moved(int, float, float);
    callback dock-drag-end(int, float, float);
    callback float-panel(int);
    callback close-panel(int);
    callback cut-transition();
    callback fade-transition();
    callback fade-transition-duration(string);
    callback slide-transition(string);
    callback swipe-transition(string);
    callback slide-transition-direction(string, int);
    callback swipe-transition-direction(string, int);
    callback swipe-transition-direction-mode(string, int, bool);
    callback fade-to-color(string, string);
    callback set-scene-transition(string, string, string);
    callback set-scene-transition-direction(string, string, string, int);
    callback set-scene-transition-direction-mode(string, string, string, int, bool);
    callback clear-scene-transition();
    property <string> duration: "300";
    property <string> fade-color: "#000000FF";

    background: Palette.tokens.panel-bg;
    border-width: 1px;
    border-color: Palette.tokens.border;

    VerticalBox {
        padding: 0px;
        spacing: 0px;
        DockHeader {
            title: I18n.text.transition_title;
            panel-kind: root.panel-kind;
            floating: root.floating;
            move-panel(kind, delta) => { root.move-panel(kind, delta); }
            dock-drag-start(kind, x, y) => { root.dock-drag-start(kind, x, y); }
            dock-drag-moved(kind, x, y) => { root.dock-drag-moved(kind, x, y); }
            dock-drag-end(kind, x, y) => { root.dock-drag-end(kind, x, y); }
            float-panel(kind) => { root.float-panel(kind); }
            close-panel(kind) => { root.close-panel(kind); }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalBox {
                padding: 8px;
                spacing: 7px;
                Button {
                    text: I18n.text.fade;
                    height: 30px;
                    clicked => fade-transition-duration(root.duration);
                }
                Button {
                    text: I18n.text.slide;
                    height: 30px;
                    clicked => slide-transition-direction(
                        root.duration,
                        root.transition-direction-index
                    );
                }
                Button {
                    text: I18n.text.swipe;
                    height: 30px;
                    clicked => swipe-transition-direction-mode(
                        root.duration,
                        root.transition-direction-index,
                        root.swipe-in
                    );
                }
                TransitionDirectionField {
                    direction-index <=> root.transition-direction-index;
                }
                CheckBox {
                    text: I18n.text.swipe_in;
                    checked <=> root.swipe-in;
                }
                HorizontalBox {
                    spacing: 5px;
                    Text {
                        text: I18n.text.duration;
                        color: Palette.tokens.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> duration;
                        width: 68px;
                        height: 28px;
                    }
                    Text {
                        text: "ms";
                        color: Palette.tokens.text-muted;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                HorizontalBox {
                    spacing: 5px;
                    Text {
                        text: I18n.text.property_ui.color;
                        color: Palette.tokens.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> fade-color;
                        width: 104px;
                        height: 28px;
                    }
                }
                Button {
                    text: I18n.text.fade_to_color;
                    height: 30px;
                    clicked => fade-to-color(root.fade-color, root.duration);
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 4px;
                    CompactButton {
                        icon-name: "add";
                        hint: I18n.text.add_transition;
                        clicked => set-scene-transition-direction-mode(
                            root.transition-kind,
                            root.duration,
                            root.fade-color,
                            root.transition-direction-index,
                            root.swipe-in
                        );
                    }
                    CompactButton {
                        icon-name: "remove";
                        hint: I18n.text.remove_transition;
                        clicked => clear-scene-transition();
                    }
                    CompactButton {
                        icon-name: "more";
                        hint: I18n.text.more_options;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: I18n.text.cut;
                        clicked => cut-transition();
                    }
                }
            }
        }
    }
}
