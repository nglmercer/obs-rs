import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";
import { CompactButton, DockHeader } from "theme.slint";

export component TransitionDock inherits Rectangle {
    in property <string> locale;
    in property <string> transition;
    in property <int> panel-kind;
    callback move-panel(int, int);
    callback cut-transition();
    callback fade-transition();
    property <string> duration: "300";

    background: rgb(31, 34, 41);
    border-width: 1px;
    border-color: rgb(55, 60, 69);

    VerticalBox {
        DockHeader {
            title: locale == "es" ? "Transiciones de escena" : "Scene Transitions";
            panel-kind: root.panel-kind;
            move-panel(kind, delta) => { root.move-panel(kind, delta); }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalBox {
                padding: 8px;
                spacing: 7px;
                Button {
                    text: locale == "es" ? "Desvanecimiento ▾" : "Fade ▾";
                    height: 30px;
                    clicked => fade-transition();
                }
                HorizontalBox {
                    spacing: 5px;
                    Text {
                        text: locale == "es" ? "Duración" : "Duration";
                        color: rgb(203, 213, 225);
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> duration;
                        width: 68px;
                        height: 28px;
                    }
                    Text {
                        text: "ms";
                        color: rgb(148, 163, 184);
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 4px;
                    CompactButton {
                        label: "＋";
                        hint: locale == "es" ? "Añadir transición" : "Add transition";
                    }
                    CompactButton {
                        label: "⌫";
                        hint: locale == "es" ? "Eliminar transición" : "Remove transition";
                    }
                    CompactButton {
                        label: "⋮";
                        hint: locale == "es" ? "Más opciones" : "More options";
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: locale == "es" ? "Corte" : "Cut";
                        clicked => cut-transition();
                    }
                }
            }
        }
    }
}
