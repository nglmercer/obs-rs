import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";
import { CompactButton, DockHeader } from "theme.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

export component TransitionDock inherits Rectangle {
    in property <string> locale;
    in property <string> transition;
    in property <int> panel-kind;
    callback move-panel(int, int);
    callback cut-transition();
    callback fade-transition();
    property <string> duration: "300";

    background: Palette.tokens.panel-bg;
    border-width: 1px;
    border-color: Palette.tokens.border;

    VerticalBox {
        padding: 0px;
        spacing: 0px;
        DockHeader {
            title: I18n.text.transition_title;
            panel-kind: root.panel-kind;
            move-panel(kind, delta) => { root.move-panel(kind, delta); }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalBox {
                padding: 8px;
                spacing: 7px;
                Button {
                    text: I18n.text.fade;
                    height: 30px;
                    clicked => fade-transition();
                }
                HorizontalBox {
                    spacing: 5px;
                    Text {
                        text: I18n.text.duration;
                        color: Palette.tokens.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> duration;
                        width: 68px;
                        height: 28px;
                    }
                    Text {
                        text: "ms";
                        color: Palette.tokens.text-muted;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 4px;
                    CompactButton {
                        icon-name: "add";
                        hint: I18n.text.add_transition;
                    }
                    CompactButton {
                        icon-name: "remove";
                        hint: I18n.text.remove_transition;
                    }
                    CompactButton {
                        icon-name: "more";
                        hint: I18n.text.more_options;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: I18n.text.cut;
                        clicked => cut-transition();
                    }
                }
            }
        }
    }
}
