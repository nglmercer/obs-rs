import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component StudioPanel inherits Rectangle {
    background: rgb(31, 41, 55);
    border-width: 1px;
    border-color: rgb(45, 58, 78);
    border-radius: 8px;
}

export component PanelHeading inherits Text {
    color: rgb(249, 250, 251);
    font-size: 16px;
    font-weight: 700;
}

export component FieldHeading inherits Text {
    color: rgb(203, 213, 225);
    font-size: 12px;
    font-weight: 700;
}

export component MutedText inherits Text {
    color: rgb(148, 163, 184);
    font-size: 11px;
    wrap: word-wrap;
}

// SVGs are embedded by Slint at build time. Keeping the name-to-resource map
// in one component gives every panel the same sizing and visual treatment.
export component Icon inherits Rectangle {
    in property <string> name;
    in property <length> icon-size: 16px;
    width: icon-size;
    height: icon-size;
    background: transparent;

    Image {
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        source: root.name == "add" ? @image-url("icons/add.svg")
            : root.name == "remove" ? @image-url("icons/remove.svg")
            : root.name == "settings" ? @image-url("icons/settings.svg")
            : root.name == "pause" ? @image-url("icons/pause.svg")
            : root.name == "more" ? @image-url("icons/more.svg")
            : root.name == "eye" ? @image-url("icons/eye.svg")
            : root.name == "eye-off" ? @image-url("icons/eye-off.svg")
            : root.name == "lock" ? @image-url("icons/lock.svg")
            : root.name == "unlock" ? @image-url("icons/unlock.svg")
            : root.name == "up" ? @image-url("icons/up.svg")
            : root.name == "down" ? @image-url("icons/down.svg")
            : root.name == "volume" ? @image-url("icons/volume.svg")
            : root.name == "volume-mute" ? @image-url("icons/volume-mute.svg")
            : root.name == "brand" ? @image-url("icons/brand.svg")
            : root.name == "drag" ? @image-url("icons/drag.svg")
            : root.name == "file" ? @image-url("icons/file.svg")
            : root.name == "edit" ? @image-url("icons/edit.svg")
            : root.name == "view" ? @image-url("icons/view.svg")
            : root.name == "panels" ? @image-url("icons/panels.svg")
            : root.name == "profile" ? @image-url("icons/profile.svg")
            : root.name == "collection" ? @image-url("icons/collection.svg")
            : root.name == "tools" ? @image-url("icons/tools.svg")
            : @image-url("icons/help.svg");
    }
}

export component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    min-width: 64px;
    height: 34px;
    background: active ? rgb(45, 61, 83) : rgb(25, 34, 48);
    border-radius: 5px;

    Text {
        text: root.label;
        color: root.active ? rgb(249, 250, 251) : rgb(148, 163, 184);
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.active ? rgb(96, 165, 250) : transparent;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component NavMenuButton inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    in property <bool> active;
    callback clicked();
    height: 32px;
    min-width: 58px;
    background: active ? rgb(61, 66, 75) : transparent;
    border-radius: 3px;

    HorizontalBox {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 4px;
        Icon {
            name: root.icon-name;
            icon-size: 14px;
        }
        Text {
            text: root.label;
            color: rgb(226, 232, 240);
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <bool> destructive;
    callback clicked();
    width: 208px;
    height: 28px;
    background: transparent;

    Text {
        text: root.label;
        x: 12px;
        width: parent.width - 24px;
        color: root.destructive ? rgb(252, 165, 165) : rgb(226, 232, 240);
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component ModeButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    min-width: 76px;
    height: 26px;
    background: active ? rgb(59, 130, 246) : rgb(39, 45, 54);
    border-radius: 3px;

    Text {
        text: root.label;
        color: root.active ? white : rgb(203, 213, 225);
        font-size: 11px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component CompactButton inherits Rectangle {
    in property <string> icon-name;
    in property <string> hint;
    in property <bool> enabled: true;
    callback clicked();
    width: 28px;
    height: 24px;
    opacity: enabled ? 1 : 0.45;
    background: rgb(39, 52, 73);
    border-width: 1px;
    border-color: rgb(71, 85, 105);
    border-radius: 3px;

    Icon {
        x: (parent.width - 15px) / 2;
        y: (parent.height - 15px) / 2;
        name: root.icon-name;
        icon-size: 15px;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => root.clicked();
    }
}

// OBS dock title bars are grab handles for the whole strip, not just a grip
// glyph, so the touch area spans the header and every 24px of horizontal travel
// swaps the dock with its neighbour.
export component DockHeader inherits Rectangle {
    in property <string> title;
    in property <int> panel-kind;
    callback move-panel(int, int);
    property <length> drag-origin-x: 0px;
    property <bool> dragging: drag-area.pressed;

    height: 24px;
    background: dragging ? rgb(58, 63, 74) : rgb(43, 47, 56);
    border-width: 1px;
    border-color: rgb(58, 63, 73);

    Text {
        x: 8px;
        width: parent.width - 34px;
        text: root.title;
        color: rgb(226, 232, 240);
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 26px;
        y: (parent.height - 14px) / 2;
        name: "drag";
        icon-size: 14px;
        opacity: 0.7;
    }
    drag-area := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag-origin-x = self.mouse-x;
            } else if (event.kind == PointerEventKind.move && self.pressed) {
                if (self.mouse-x - root.drag-origin-x > 24px) {
                    root.drag-origin-x = self.mouse-x;
                    root.move-panel(root.panel-kind, 1);
                } else if (self.mouse-x - root.drag-origin-x < -24px) {
                    root.drag-origin-x = self.mouse-x;
                    root.move-panel(root.panel-kind, -1);
                }
            }
        }
    }
}

// Horizontal grab bar between the canvas and the dock row. It reports the
// pointer delta so the owner keeps the authoritative height.
export component HorizontalSplitter inherits Rectangle {
    callback resized(length);
    property <length> origin-y: 0px;

    height: 6px;
    background: handle.pressed || handle.has-hover ? rgb(59, 130, 246) : rgb(38, 42, 50);

    handle := TouchArea {
        mouse-cursor: MouseCursor.row-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.origin-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.move && self.pressed) {
                root.resized(self.mouse-y - root.origin-y);
            }
        }
    }
}

// Menu bar entries in OBS are plain text with a mnemonic, no iconography.
export component MenuBarButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 24px;
    width: text-label.preferred-width + 18px;
    background: active ? rgb(61, 66, 75) : transparent;

    text-label := Text {
        text: root.label;
        color: rgb(226, 232, 240);
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component ModalShell inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> subtitle;
    in property <string> accept-label;
    in property <string> cancel-label;
    in property <length> panel-width: 560px;
    in property <length> panel-height: 390px;
    callback close();
    callback accepted();

    visible: open;
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    background: rgb(2, 6, 23, 214);
    z: 20;

    TouchArea {
        clicked => root.close();
    }

    Rectangle {
        x: Math.max(18px, (root.width - root.panel-width) / 2);
        y: Math.max(18px, (root.height - root.panel-height) / 2);
        width: Math.min(root.panel-width, root.width - 36px);
        height: Math.min(root.panel-height, root.height - 36px);
        background: rgb(31, 41, 55);
        border-width: 1px;
        border-color: rgb(71, 85, 105);
        border-radius: 9px;

        TouchArea { }

        VerticalBox {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.title;
                color: rgb(249, 250, 251);
                font-size: 18px;
                font-weight: 700;
            }
            Text {
                text: root.subtitle;
                color: rgb(148, 163, 184);
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle {
                vertical-stretch: 1;
                @children
            }
            HorizontalBox {
                alignment: end;
                spacing: 8px;
                Button {
                    text: root.cancel-label;
                    clicked => root.close();
                }
                Button {
                    text: root.accept-label;
                    clicked => root.accepted();
                }
            }
        }
    }
}
