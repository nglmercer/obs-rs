import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Palette } from "palette.slint";

export component StudioPanel inherits Rectangle {
    background: Palette.tokens.panel-bg;
    border-width: 1px;
    border-color: Palette.tokens.border;
    border-radius: 8px;
}

export component PanelHeading inherits Text {
    color: Palette.tokens.text-strong;
    font-size: 16px;
    font-weight: 700;
}

export component FieldHeading inherits Text {
    color: Palette.tokens.text-muted;
    font-size: 12px;
    font-weight: 700;
}

export component MutedText inherits Text {
    color: Palette.tokens.text-muted;
    font-size: 11px;
    wrap: word-wrap;
}

// SVGs are embedded by Slint at build time. Keeping the name-to-resource map
// in one component gives every panel the same sizing and visual treatment.
export component Icon inherits Rectangle {
    in property <string> name;
    in property <length> icon-size: 16px;
    width: icon-size;
    height: icon-size;
    background: transparent;

    Image {
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        source: root.name == "add" ? @image-url("icons/add.svg")
            : root.name == "remove" ? @image-url("icons/remove.svg")
            : root.name == "settings" ? @image-url("icons/settings.svg")
            : root.name == "pause" ? @image-url("icons/pause.svg")
            : root.name == "more" ? @image-url("icons/more.svg")
            : root.name == "eye" ? @image-url("icons/eye.svg")
            : root.name == "eye-off" ? @image-url("icons/eye-off.svg")
            : root.name == "lock" ? @image-url("icons/lock.svg")
            : root.name == "unlock" ? @image-url("icons/unlock.svg")
            : root.name == "up" ? @image-url("icons/up.svg")
            : root.name == "down" ? @image-url("icons/down.svg")
            : root.name == "volume" ? @image-url("icons/volume.svg")
            : root.name == "volume-mute" ? @image-url("icons/volume-mute.svg")
            : root.name == "brand" ? @image-url("icons/brand.svg")
            : root.name == "source-color" ? @image-url("icons/source-color.svg")
            : root.name == "source-pattern" ? @image-url("icons/source-pattern.svg")
            : root.name == "source-screen" ? @image-url("icons/source-screen.svg")
            : root.name == "source-window" ? @image-url("icons/source-window.svg")
            : root.name == "source-camera" ? @image-url("icons/source-camera.svg")
            : root.name == "source-generic" ? @image-url("icons/source-generic.svg")
            : root.name == "plus-large" ? @image-url("icons/plus-large.svg")
            : root.name == "appearance" ? @image-url("icons/appearance.svg")
            : root.name == "stream" ? @image-url("icons/stream.svg")
            : root.name == "output" ? @image-url("icons/output.svg")
            : root.name == "audio" ? @image-url("icons/audio.svg")
            : root.name == "video" ? @image-url("icons/video.svg")
            : root.name == "hotkeys" ? @image-url("icons/hotkeys.svg")
            : root.name == "accessibility" ? @image-url("icons/accessibility.svg")
            : root.name == "advanced" ? @image-url("icons/advanced.svg")
            : root.name == "drag" ? @image-url("icons/drag.svg")
            : root.name == "file" ? @image-url("icons/file.svg")
            : root.name == "edit" ? @image-url("icons/edit.svg")
            : root.name == "view" ? @image-url("icons/view.svg")
            : root.name == "panels" ? @image-url("icons/panels.svg")
            : root.name == "profile" ? @image-url("icons/profile.svg")
            : root.name == "collection" ? @image-url("icons/collection.svg")
            : root.name == "tools" ? @image-url("icons/tools.svg")
            : @image-url("icons/help.svg");
    }
}

export component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    accessible-role: tab;
    accessible-label: root.label;
    accessible-enabled: true;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => root.clicked();
    min-width: 64px;
    height: 34px;
    background: active ? Palette.tokens.row-selected-bg : Palette.tokens.row-bg;
    border-radius: 5px;

    Text {
        text: root.label;
        color: root.active ? Palette.tokens.text-strong : Palette.tokens.text-muted;
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.active ? Palette.tokens.preview-border : transparent;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component NavMenuButton inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    in property <bool> active;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: true;
    accessible-action-default => root.clicked();
    height: 32px;
    min-width: 58px;
    background: active ? Palette.tokens.header-active-bg : transparent;
    border-radius: 3px;

    HorizontalBox {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 4px;
        Icon {
            name: root.icon-name;
            icon-size: 14px;
        }
        Text {
            text: root.label;
            color: Palette.tokens.text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <bool> destructive;
    // A disabled entry stays visible so the menu keeps a stable shape, but it
    // is dimmed and swallows the click rather than firing a no-op action.
    in property <bool> enabled: true;
    // Set for the toggle entries — dock visibility and view mode — so the menu
    // reports the current state instead of only offering to change it.
    in property <bool> checkable;
    in property <bool> checked;
    // Right-aligned accelerator text, e.g. "Ctrl+Z". Empty hides the column.
    in property <string> shortcut;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    width: 208px;
    height: 28px;
    background: root.enabled && touch.has-hover
        ? Palette.tokens.row-selected-bg
        : transparent;
    border-radius: 3px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Text {
            width: 14px;
            text: root.checkable && root.checked ? "✓" : "";
            color: Palette.tokens.accent;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            horizontal-stretch: 1;
            color: !root.enabled
                ? Palette.tokens.text-muted
                : (root.destructive ? rgb(252, 165, 165) : Palette.tokens.text);
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.shortcut;
            color: Palette.tokens.text-muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        // The area stays enabled so a disabled entry still absorbs the click
        // instead of letting it fall through to whatever is behind the menu.
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component ModeButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    min-width: 76px;
    height: 26px;
    background: active ? Palette.tokens.accent : Palette.tokens.row-bg;
    border-radius: 3px;

    Text {
        text: root.label;
        color: root.active ? white : Palette.tokens.text-muted;
        font-size: 11px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component CompactButton inherits Rectangle {
    in property <string> icon-name;
    in property <string> hint;
    in property <bool> enabled: true;
    callback clicked();
    // Compact controls have no visible text; expose the existing localized
    // hint as the button's accessible name for keyboard and screen-reader
    // traversal.
    accessible-role: button;
    accessible-label: root.hint;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    width: 28px;
    height: 24px;
    opacity: enabled ? 1 : 0.45;
    background: Palette.tokens.control-bg;
    border-width: 1px;
    border-color: Palette.tokens.border-strong;
    border-radius: 3px;

    Icon {
        x: (parent.width - 15px) / 2;
        y: (parent.height - 15px) / 2;
        name: root.icon-name;
        icon-size: 15px;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => root.clicked();
    }
}

// A small icon button sized for the dock header strip.
component HeaderButton inherits Rectangle {
    in property <string> icon-name;
    callback clicked();
    width: 19px;
    height: 20px;
    y: 2px;
    background: touch.has-hover ? Palette.tokens.row-bg : transparent;
    border-radius: 2px;
    Icon {
        name: root.icon-name;
        icon-size: 12px;
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// OBS dock title bars are grab handles for the whole strip, not just a grip
// glyph. Pointer coordinates are reported to the Rust dock tree so a drag can
// become a reorder, tab insertion, or directional split.
export component DockHeader inherits Rectangle {
    in property <string> title;
    in property <int> panel-kind;
    // A floating dock shows the button that returns it to the dock row.
    in property <bool> floating;
    callback move-panel(int, int);
    callback dock-drag-start(int, float, float);
    callback dock-drag-moved(int, float, float);
    callback dock-drag-end(int, float, float);
    callback float-panel(int);
    callback close-panel(int);

    property <bool> dragging: drag-area.pressed;

    height: 24px;
    background: dragging ? Palette.tokens.header-active-bg : Palette.tokens.header-bg;
    border-width: 1px;
    border-color: Palette.tokens.border;

    drag-area := TouchArea {
        width: parent.width - 44px;
        mouse-cursor: root.floating
            ? MouseCursor.default
            : (self.pressed ? MouseCursor.grabbing : MouseCursor.grab);
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && !root.floating) {
                root.dock-drag-start(
                    root.panel-kind,
                    (self.absolute-position.x + self.mouse-x) / 1px,
                    (self.absolute-position.y + self.mouse-y) / 1px);
            } else if (event.kind == PointerEventKind.up && !root.floating) {
                root.dock-drag-end(
                    root.panel-kind,
                    (self.absolute-position.x + self.mouse-x) / 1px,
                    (self.absolute-position.y + self.mouse-y) / 1px);
            }
        }
        moved => {
            if (!root.floating && self.pressed) {
                root.dock-drag-moved(
                    root.panel-kind,
                    (self.absolute-position.x + self.mouse-x) / 1px,
                    (self.absolute-position.y + self.mouse-y) / 1px);
            }
        }
        Text {
            x: 8px;
            width: parent.width - 8px;
            height: 100%;
            text: root.title;
            color: Palette.tokens.text;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // Undock / redock, then hide. Both are laid out by hand so the drag area
    // above can claim the whole remaining width.
    HeaderButton {
        x: parent.width - 42px;
        icon-name: root.floating ? "down" : "up";
        clicked => { root.float-panel(root.panel-kind); }
    }
    HeaderButton {
        x: parent.width - 21px;
        icon-name: "remove";
        clicked => { root.close-panel(root.panel-kind); }
    }
}


// Horizontal grab bar between the canvas and the dock row. It reports the
// pointer delta so the owner keeps the authoritative height.
export component HorizontalSplitter inherits Rectangle {
    callback resized(length);
    // The drag reports increments, so the caller clamps a running size rather
    // than recomputing one from a press origin it cannot see.
    property <length> last-y: 0px;

    height: 6px;
    background: handle.pressed || handle.has-hover ? Palette.tokens.accent : Palette.tokens.header-bg;

    handle := TouchArea {
        mouse-cursor: MouseCursor.row-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.last-y = self.mouse-y;
            }
        }
        // `moved` is the callback Slint raises while a press is held; the
        // pointer-event `move` kind is not delivered during a drag.
        moved => {
            if (self.pressed) {
                root.resized(self.mouse-y - root.last-y);
                root.last-y = self.mouse-y;
            }
        }
    }
}

// The grab strip between two docks in the row, mirroring the horizontal one.
export component VerticalSplitter inherits Rectangle {
    callback resized(length);
    property <length> last-x: 0px;

    width: 6px;
    background: handle.pressed || handle.has-hover ? Palette.tokens.accent : Palette.tokens.header-bg;

    handle := TouchArea {
        mouse-cursor: MouseCursor.col-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.last-x = self.mouse-x;
            }
        }
        moved => {
            if (self.pressed) {
                root.resized(self.mouse-x - root.last-x);
                root.last-x = self.mouse-x;
            }
        }
    }
}

// Menu bar entries in OBS are plain text with a mnemonic, no iconography.
export component MenuBarButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: true;
    accessible-action-default => root.clicked();
    height: 24px;
    width: text-label.preferred-width + 18px;
    background: active ? Palette.tokens.header-active-bg : transparent;

    text-label := Text {
        text: root.label;
        color: Palette.tokens.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component ModalShell inherits FocusScope {
    in property <bool> open;
    in property <string> title;
    in property <string> subtitle;
    in property <string> accept-label;
    in property <string> alternate-label;
    in property <string> cancel-label;
    in property <length> panel-width: 560px;
    in property <length> panel-height: 390px;
    callback close();
    callback accepted();
    callback alternate();

    visible: open;
    // The shell itself is the keyboard owner. Keeping the visual scrim in a
    // child Rectangle lets the FocusScope receive keys even when the dialog's
    // text editor or buttons are the current focused item.
    enabled: true;
    focus-on-click: false;
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    z: 20;

    changed visible => {
        if self.visible {
            self.focus();
        }
    }

    // Keep keyboard events inside the active modal. Child editors and buttons
    // handle their own input first; anything they do not consume must not fall
    // through to the main window's output or project shortcuts.
    capture-key-pressed(event) => {
        // TextInput and Button implementations may consume Escape or Return
        // before the event reaches this scope. Capture the modal commands
        // first, while leaving ordinary typing to the child.
        if !event.modifiers.control
            && !event.modifiers.shift
            && !event.modifiers.alt
            && !event.modifiers.meta
            && event.text == Key.Escape {
            root.close();
            return accept;
        }
        if !event.modifiers.control
            && !event.modifiers.shift
            && !event.modifiers.alt
            && !event.modifiers.meta
            && event.text == Key.Return {
            root.accepted();
            return accept;
        }
        reject
    }
    key-pressed(event) => {
        if !event.modifiers.control
            && !event.modifiers.shift
            && !event.modifiers.alt
            && !event.modifiers.meta
            && event.text == Key.Escape {
            root.close();
            return accept;
        }
        if !event.modifiers.control
            && !event.modifiers.shift
            && !event.modifiers.alt
            && !event.modifiers.meta
            && event.text == Key.Return {
            root.accepted();
            return accept;
        }
        // The modal is the keyboard boundary while it is open. A child input
        // that rejected a key has already had its chance above.
        accept
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: rgb(2, 6, 23, 214);

        TouchArea {
            clicked => root.close();
        }

        Rectangle {
            x: Math.max(18px, (root.width - root.panel-width) / 2);
            y: Math.max(18px, (root.height - root.panel-height) / 2);
            width: Math.min(root.panel-width, root.width - 36px);
            height: Math.min(root.panel-height, root.height - 36px);
            background: Palette.tokens.panel-bg;
            border-width: 1px;
            border-color: Palette.tokens.border-strong;
            border-radius: 9px;

            TouchArea { }

            VerticalBox {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.title;
                    color: Palette.tokens.text-strong;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.subtitle;
                    color: Palette.tokens.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                    @children
                }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    // An informational dialog has nothing to cancel, so an empty
                    // label drops the button instead of showing a blank one.
                    if root.cancel-label != "" : Button {
                        text: root.cancel-label;
                        clicked => root.close();
                    }
                    if root.alternate-label != "" : Button {
                        text: root.alternate-label;
                        clicked => root.alternate();
                    }
                    Button {
                        text: root.accept-label;
                        clicked => root.accepted();
                    }
                }
            }
        }
    }
}
