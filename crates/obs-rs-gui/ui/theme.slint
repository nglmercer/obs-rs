import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component StudioPanel inherits Rectangle {
    background: rgb(31, 41, 55);
    border-width: 1px;
    border-color: rgb(45, 58, 78);
    border-radius: 8px;
}

export component PanelHeading inherits Text {
    color: rgb(249, 250, 251);
    font-size: 16px;
    font-weight: 700;
}

export component FieldHeading inherits Text {
    color: rgb(203, 213, 225);
    font-size: 12px;
    font-weight: 700;
}

export component MutedText inherits Text {
    color: rgb(148, 163, 184);
    font-size: 11px;
    wrap: word-wrap;
}

export component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    min-width: 64px;
    height: 34px;
    background: active ? rgb(45, 61, 83) : rgb(25, 34, 48);
    border-radius: 5px;

    Text {
        text: root.label;
        color: root.active ? rgb(249, 250, 251) : rgb(148, 163, 184);
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.active ? rgb(96, 165, 250) : transparent;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component NavMenuButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 32px;
    min-width: 58px;
    background: active ? rgb(61, 66, 75) : transparent;
    border-radius: 3px;

    Text {
        text: root.label;
        color: rgb(226, 232, 240);
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <bool> destructive;
    callback clicked();
    width: 208px;
    height: 28px;
    background: transparent;

    Text {
        text: root.label;
        x: 12px;
        width: parent.width - 24px;
        color: root.destructive ? rgb(252, 165, 165) : rgb(226, 232, 240);
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component ModeButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    min-width: 76px;
    height: 26px;
    background: active ? rgb(59, 130, 246) : rgb(39, 45, 54);
    border-radius: 3px;

    Text {
        text: root.label;
        color: root.active ? white : rgb(203, 213, 225);
        font-size: 11px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => root.clicked();
    }
}

export component CompactButton inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> enabled: true;
    callback clicked();
    width: 28px;
    height: 24px;
    opacity: enabled ? 1 : 0.45;
    background: rgb(39, 52, 73);
    border-width: 1px;
    border-color: rgb(71, 85, 105);
    border-radius: 3px;

    Text {
        text: root.label;
        color: rgb(226, 232, 240);
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => root.clicked();
    }
}

export component DockHeader inherits Rectangle {
    in property <string> title;
    in property <int> panel-kind;
    callback move-panel(int, int);
    property <length> drag-origin-x: 0px;

    height: 28px;
    background: rgb(43, 47, 56);
    border-width: 1px;
    border-color: rgb(58, 63, 73);

    Text {
        x: 9px;
        width: parent.width - 42px;
        text: root.title;
        color: rgb(226, 232, 240);
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 31px;
        width: 22px;
        text: "⋮⋮";
        color: rgb(148, 163, 184);
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        x: parent.width - 34px;
        width: 34px;
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag-origin-x = self.mouse-x;
            } else if (event.kind == PointerEventKind.move && self.pressed) {
                if (self.mouse-x - root.drag-origin-x > 18px) {
                    root.drag-origin-x = self.mouse-x;
                    root.move-panel(root.panel-kind, 1);
                } else if (self.mouse-x - root.drag-origin-x < -18px) {
                    root.drag-origin-x = self.mouse-x;
                    root.move-panel(root.panel-kind, -1);
                }
            }
        }
    }
}

export component ModalShell inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> subtitle;
    in property <string> accept-label;
    in property <string> cancel-label;
    callback close();
    callback accepted();

    visible: open;
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    background: rgb(2, 6, 23, 214);
    z: 20;

    TouchArea {
        clicked => root.close();
    }

    Rectangle {
        x: Math.max(18px, (root.width - 560px) / 2);
        y: Math.max(18px, (root.height - 390px) / 2);
        width: Math.min(560px, root.width - 36px);
        height: Math.min(390px, root.height - 36px);
        background: rgb(31, 41, 55);
        border-width: 1px;
        border-color: rgb(71, 85, 105);
        border-radius: 9px;

        TouchArea { }

        VerticalBox {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.title;
                color: rgb(249, 250, 251);
                font-size: 18px;
                font-weight: 700;
            }
            Text {
                text: root.subtitle;
                color: rgb(148, 163, 184);
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle {
                vertical-stretch: 1;
                @children
            }
            HorizontalBox {
                alignment: end;
                spacing: 8px;
                Button {
                    text: root.cancel-label;
                    clicked => root.close();
                }
                Button {
                    text: root.accept-label;
                    clicked => root.accepted();
                }
            }
        }
    }
}
