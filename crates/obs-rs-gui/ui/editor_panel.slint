import { Button, HorizontalBox, LineEdit, TextEdit, VerticalBox } from "std-widgets.slint";
import { FieldHeading, MutedText, PanelHeading, StudioPanel } from "theme.slint";
import { I18n } from "i18n.slint";

export component EditorPanel inherits Rectangle {
    in property <string> locale;
    in property <string> preview-scene;
    in property <string> selected-source;
    in property <string> capture-capabilities;
    in property <string> source-settings-version;
    in-out property <string> source-settings;
    in-out property <string> source-transform;
    in-out property <string> source-filters;
    in-out property <string> scene-name;
    in-out property <string> new-scene-id;
    in-out property <string> new-scene-name;
    callback open-scene-dialog();
    callback rename-scene();
    callback open-source-dialog();
    callback apply-source-settings();
    callback apply-source-transform();
    callback apply-source-filters();

    background: transparent;
    VerticalBox {
        spacing: 10px;
        PanelHeading {
            text: I18n.text.editor_title;
        }
        MutedText {
            text: I18n.text.preview_scene_prefix + preview-scene;
        }
        HorizontalBox {
            spacing: 8px;
            Button {
                text: I18n.text.new_scene;
                clicked => open-scene-dialog();
            }
            Button {
                text: I18n.text.new_source;
                clicked => open-source-dialog();
            }
        }
        StudioPanel {
            height: 70px;
            VerticalBox {
                padding: 12px;
                spacing: 7px;
                FieldHeading {
                    text: I18n.text.scene_name;
                }
                HorizontalBox {
                    spacing: 6px;
                    LineEdit {
                        text <=> scene-name;
                        placeholder-text: I18n.text.scene_name_placeholder;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: I18n.text.rename;
                        clicked => rename-scene();
                    }
                }
            }
        }
        StudioPanel {
            vertical-stretch: 1;
            min-height: 180px;
            VerticalBox {
                padding: 12px;
                spacing: 7px;
                Text {
                    text: I18n.text.selected_source_prefix + selected-source;
                    color: rgb(226, 232, 240);
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: source-settings-version == ""
                        ? I18n.text.select_source_hint
                        : I18n.text.properties_synced;
                    color: rgb(134, 239, 172);
                    font-size: 11px;
                }
                FieldHeading {
                    text: I18n.text.source_settings;
                }
                TextEdit {
                    text <=> source-settings;
                    placeholder-text: "width=640\nheight=360\ncolor=#202840FF";
                    height: 54px;
                }
                Button {
                    text: I18n.text.apply_settings;
                    clicked => apply-source-settings();
                }
                FieldHeading {
                    text: I18n.text.transform;
                }
                HorizontalBox {
                    spacing: 6px;
                    LineEdit {
                        text <=> source-transform;
                        placeholder-text: "1000,1000,0,0,0,0,255";
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: I18n.text.apply;
                        clicked => apply-source-transform();
                    }
                }
                FieldHeading {
                    text: I18n.text.filters_prefix + source-filters;
                    overflow: elide;
                }
                HorizontalBox {
                    spacing: 6px;
                    LineEdit {
                        text <=> source-filters;
                        placeholder-text: "gray,brightness:750,opacity:200";
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: I18n.text.apply;
                        clicked => apply-source-filters();
                    }
                }
            }
        }
        MutedText { text: capture-capabilities; }
    }
}
