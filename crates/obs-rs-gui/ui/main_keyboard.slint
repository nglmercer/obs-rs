import { HotkeyLabel } from "hotkey_label.slint";

// Keeps keyboard normalization, shortcut execution, and transient push-key
// handling outside the window shell. MainWindow remains the Rust-facing owner
// of every state mutation; this component only forwards typed callbacks.
export component MainKeyboard inherits Rectangle {
    visible: false;
    width: 0px;
    height: 0px;
    in property <bool> recording;
    in property <bool> streaming;
    in property <bool> replay-buffering;
    in property <string> selected-source;
    in property <bool> selected-source-is-group;
    in property <bool> selected-source-is-scene;
    in property <bool> selected-source-first;
    in property <bool> selected-source-last;
    in property <int> source-count;
    in property <bool> can-paste;
    in property <string> preview-scene;
    in-out property <bool> space-held: false;

    callback swap-scenes();
    callback navigate-preview-scene(int);
    callback trigger-shortcut(string) -> int;
    callback request-recording();
    callback request-streaming();
    callback undo-edit();
    callback redo-edit();
    callback save-project();
    callback cut-transition();
    callback fade-transition();
    callback save-replay-buffer();
    callback toggle-replay-buffer();
    callback toggle-mixer-mute(string);
    callback set-mixer-muted(string, bool);
    callback toggle-studio-mode();
    callback toggle-source-visibility(string);
    callback toggle-source-locked(string);
    callback open-source-projector();
    callback open-scene-projector(string);
    callback move-source(string, int);
    callback move-source-to(string, int);
    callback copy-source(string);
    callback paste-reference(string);
    callback select-all-sources();
    callback remove-selected-sources();
    callback canvas-nudged(int, int);

    public function release-held-push() -> bool {
        hotkey-labeler.release-held-push()
    }

    hotkey-labeler := HotkeyLabel {
        visible: false;
        width: 0px;
        height: 0px;
        set-mixer-muted(id, muted) => { root.set-mixer-muted(id, muted); }
    }

    function execute-shortcut(action: int) -> bool {
        if (action == 1) {
            root.swap-scenes();
            true
        } else if (action == 16) {
            root.navigate-preview-scene(-1);
            true
        } else if (action == 17) {
            root.navigate-preview-scene(1);
            true
        } else if (action == 2 && !root.recording) {
            root.request-recording();
            true
        } else if (action == 3 && root.recording) {
            root.request-recording();
            true
        } else if (action == 4 && !root.streaming) {
            root.request-streaming();
            true
        } else if (action == 5 && root.streaming) {
            root.request-streaming();
            true
        } else if (action == 6) {
            root.undo-edit();
            true
        } else if (action == 7) {
            root.redo-edit();
            true
        } else if (action == 8) {
            root.save-project();
            true
        } else if (action == 15) {
            root.cut-transition();
            true
        } else if (action == 9) {
            root.fade-transition();
            true
        } else if (action == 10) {
            root.save-replay-buffer();
            true
        } else if (action == 11 && !root.replay-buffering) {
            root.toggle-replay-buffer();
            true
        } else if (action == 12 && root.replay-buffering) {
            root.toggle-replay-buffer();
            true
        } else if (action == 13) {
            root.toggle-mixer-mute("mic");
            true
        } else if (action == 14) {
            root.toggle-mixer-mute("desktop");
            true
        } else if (action == 23) {
            hotkey-labeler.held-push-action = action;
            root.set-mixer-muted("mic", false);
            true
        } else if (action == 24) {
            hotkey-labeler.held-push-action = action;
            root.set-mixer-muted("mic", true);
            true
        } else if (action == 18) {
            root.toggle-studio-mode();
            true
        } else if (action == 19
            && root.selected-source != ""
            && root.selected-source != "none") {
            root.toggle-source-visibility(root.selected-source);
            true
        } else if (action == 20
            && root.selected-source != ""
            && root.selected-source != "none") {
            root.toggle-source-locked(root.selected-source);
            true
        } else if (action == 21
            && root.selected-source != ""
            && root.selected-source != "none"
            && !root.selected-source-is-group
            && !root.selected-source-is-scene) {
            root.open-source-projector();
            true
        } else if (action == 22
            && root.preview-scene != ""
            && root.preview-scene != "none") {
            root.open-scene-projector(root.preview-scene);
            true
        } else {
            false
        }
    }

    public function handle-key-pressed(
        text: string,
        control: bool,
        shift: bool,
        alt: bool,
    ) -> bool {
        let action = root.trigger-shortcut(hotkey-labeler.label(
                text,
                control,
                shift,
                alt));
        if (root.execute-shortcut(action)) {
            if (action == 23 || action == 24) {
                hotkey-labeler.held-push-key = hotkey-labeler.key-name(text);
            }
            return true;
        }
        if control
            && !shift
            && !alt
            && hotkey-labeler.key-name(text) == "C"
            && root.selected-source != ""
            && root.selected-source != "none" {
            root.copy-source(root.selected-source);
            return true;
        }
        if control
            && !shift
            && !alt
            && hotkey-labeler.key-name(text) == "V"
            && root.can-paste {
            // A selected leaf resolves to its parent in the shared paste
            // command; an empty/"none" selection pastes at the scene root.
            root.paste-reference(
                root.selected-source == "none" ? "" : root.selected-source
            );
            return true;
        }
        if control
            && !shift
            && !alt
            && root.selected-source != ""
            && root.selected-source != "none"
            && (text == Key.UpArrow
                || text == Key.DownArrow
                || text == Key.Home
                || text == Key.End) {
            // Source ordering is a scene edit, not canvas movement. The
            // boundary consumes even a no-op at an edge so Ctrl+Up/Down can
            // never fall through to the one-pixel canvas nudge below.
            if text == Key.UpArrow && !root.selected-source-first {
                root.move-source(root.selected-source, -1);
            } else if text == Key.DownArrow && !root.selected-source-last {
                root.move-source(root.selected-source, 1);
            } else if text == Key.Home && !root.selected-source-first {
                root.move-source-to(root.selected-source, 0);
            } else if text == Key.End
                && !root.selected-source-last
                && root.source-count > 0 {
                root.move-source-to(root.selected-source, root.source-count - 1);
            }
            return true;
        }
        if control
            && !shift
            && !alt
            && hotkey-labeler.key-name(text) == "A" {
            root.select-all-sources();
            return true;
        }
        if !control
            && !alt
            && (text == Key.Delete || text == Key.Backspace)
            && root.selected-source != ""
            && root.selected-source != "none" {
            // The canvas and Sources dock share the selected target; the
            // existing Rust callback therefore applies the same locked and
            // nested-item rules from either focused surface.
            root.remove-selected-sources();
            return true;
        }
        if (text == " ") {
            root.space-held = true;
            return true;
        }
        // Arrow keys move every unlocked selected item by one canvas pixel;
        // Shift makes the same command coarse (ten pixels). The Rust callback
        // owns selection validation and commits the whole nudge as one bounded
        // project command.
        if !alt
            && (text == Key.LeftArrow
                || text == Key.RightArrow
                || text == Key.UpArrow
                || text == Key.DownArrow) {
            let step = shift ? 10 : 1;
            if (text == Key.LeftArrow) {
                root.canvas-nudged(-step, 0);
            } else if (text == Key.RightArrow) {
                root.canvas-nudged(step, 0);
            } else if (text == Key.UpArrow) {
                root.canvas-nudged(0, -step);
            } else {
                root.canvas-nudged(0, step);
            }
            return true;
        }
        false
    }

    public function handle-key-released(
        text: string,
        control: bool,
        shift: bool,
        alt: bool,
    ) -> bool {
        let action = root.trigger-shortcut(hotkey-labeler.label(
                text,
                control,
                shift,
                alt));
        if (hotkey-labeler.release(action)) {
            return true;
        }
        if (hotkey-labeler.held-push-action != 0
            && hotkey-labeler.key-name(text) == hotkey-labeler.held-push-key
            && hotkey-labeler.release(hotkey-labeler.held-push-action)) {
            return true;
        }
        if (text == " ") {
            root.space-held = false;
            return true;
        }
        false
    }
}
