import { Button, ScrollView, HorizontalBox, VerticalBox, Slider } from "std-widgets.slint";
import { CompactButton } from "theme.slint";
import { MixerRow } from "models.slint";

export component MixerDock inherits Rectangle {
    in property <string> locale;
    in property <[MixerRow]> mixer-rows;
    callback set-mixer-gain(string, int);
    callback toggle-mixer-mute(string);

    background: rgb(31, 41, 55);
    border-width: 1px;
    border-color: rgb(45, 58, 78);
    border-radius: 8px;
    horizontal-stretch: 2;
    VerticalBox {
        padding: 10px;
        spacing: 7px;
        Text {
            text: locale == "es" ? "Mezclador de audio" : "Audio Mixer";
            color: rgb(249, 250, 251);
            font-size: 15px;
            font-weight: 700;
        }
        ScrollView {
            vertical-stretch: 1;
            for channel in mixer-rows : Rectangle {
                height: 84px;
                background: rgb(39, 52, 73);
                border-radius: 4px;
                VerticalBox {
                    padding: 8px;
                    spacing: 4px;
                    HorizontalBox {
                        spacing: 5px;
                        Text {
                            text: channel.name;
                            color: rgb(249, 250, 251);
                            font-size: 12px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: channel.muted
                                ? (locale == "es" ? "SILENCIADO" : "MUTED")
                                : (locale == "es" ? "ACTIVO" : "LIVE");
                            color: channel.muted ? rgb(252, 165, 165) : rgb(134, 239, 172);
                            font-size: 9px;
                        }
                        CompactButton {
                            label: channel.muted ? "▶" : "×";
                            hint: channel.muted
                                ? (locale == "es" ? "Activar" : "Unmute")
                                : (locale == "es" ? "Silenciar" : "Mute");
                            clicked => toggle-mixer-mute(channel.id);
                        }
                    }
                    Slider {
                        minimum: 0;
                        maximum: 2;
                        step: 0.01;
                        value: channel.gain;
                        changed => set-mixer-gain(channel.id, round(self.value * 1000));
                    }
                    Rectangle {
                        width: 100%;
                        height: 5px;
                        background: rgb(15, 23, 42);
                        Rectangle {
                            width: channel.peak * 100px;
                            height: 100%;
                            background: channel.muted ? rgb(127, 29, 29) : rgb(34, 197, 94);
                        }
                    }
                }
            }
        }
        HorizontalBox {
            spacing: 5px;
            CompactButton { label: "Ⅱ"; hint: locale == "es" ? "Pausar medidores" : "Pause meters"; }
            CompactButton { label: "⚙"; hint: locale == "es" ? "Opciones del mezclador" : "Mixer options"; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: mixer-rows.length + (locale == "es" ? " canales" : " channels");
                color: rgb(100, 116, 139);
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }
}
