import { Button, ScrollView, HorizontalBox, VerticalBox, Slider } from "std-widgets.slint";
import { CompactButton, DockHeader } from "theme.slint";
import { MixerRow } from "models.slint";
import { I18n } from "i18n.slint";

export component MixerDock inherits Rectangle {
    in property <string> locale;
    in property <[MixerRow]> mixer-rows;
    in property <int> panel-kind;
    callback move-panel(int, int);
    callback set-mixer-gain(string, int);
    callback toggle-mixer-mute(string);

    background: rgb(31, 34, 41);
    border-width: 1px;
    border-color: rgb(55, 60, 69);
    VerticalBox {
        padding: 0px;
        spacing: 0px;
        DockHeader {
            title: I18n.text.mixer_title;
            panel-kind: root.panel-kind;
            move-panel(kind, delta) => { root.move-panel(kind, delta); }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalBox {
                padding: 8px;
                spacing: 6px;
                ScrollView {
                    vertical-stretch: 1;
                    // Rows stack from the top of the dock the way a
                    // list widget does, instead of centring in the view.
                    VerticalLayout {
                        alignment: start;
                        spacing: 1px;
                    for channel in mixer-rows : Rectangle {
                        height: 78px;
                        background: rgb(39, 43, 50);
                        border-width: 1px;
                        border-color: rgb(55, 60, 69);
                        VerticalBox {
                            padding: 7px;
                            spacing: 3px;
                            HorizontalBox {
                                spacing: 5px;
                                Text {
                                    text: channel.name;
                                    color: rgb(226, 232, 240);
                                    font-size: 11px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: channel.muted ? "MUTE" : "0.0 dB";
                                    color: rgb(148, 163, 184);
                                    font-size: 9px;
                                }
                            }
                            Slider {
                                minimum: 0;
                                maximum: 2;
                                step: 0.01;
                                value: channel.gain;
                                changed => set-mixer-gain(channel.id, round(self.value * 1000));
                            }
                            Rectangle {
                                width: 100%;
                                height: 7px;
                                background: rgb(15, 23, 42);
                                Rectangle {
                                    width: channel.peak * 100px;
                                    height: 100%;
                                    background: channel.muted ? rgb(127, 29, 29) : rgb(34, 197, 94);
                                }
                            }
                            HorizontalBox {
                                alignment: end;
                                CompactButton {
                                    icon-name: channel.muted ? "volume-mute" : "volume";
                                    hint: channel.muted
                                        ? I18n.text.unmute
                                        : I18n.text.mute;
                                    clicked => toggle-mixer-mute(channel.id);
                                }
                            }
                        }
                    }
                    }
                }
                HorizontalBox {
                    spacing: 4px;
                    CompactButton { icon-name: "pause"; hint: I18n.text.pause_meters; }
                    CompactButton { icon-name: "settings"; hint: I18n.text.mixer_options; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}
