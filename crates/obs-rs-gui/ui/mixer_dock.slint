import { Button, ScrollView, HorizontalBox, VerticalBox, Slider } from "std-widgets.slint";
import { CompactButton, DockHeader } from "theme.slint";
import { MixerRow } from "models.slint";
import { MixerContextMenuArea } from "context_menus.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

export component MixerDock inherits Rectangle {
    in property <string> locale;
    in property <[MixerRow]> mixer-rows;
    in property <int> panel-kind;
    in property <bool> floating;
    in property <bool> meters-paused;
    callback move-panel(int, int);
    callback dock-drag-start(int, float, float);
    callback dock-drag-moved(int, float, float);
    callback dock-drag-end(int, float, float);
    callback float-panel(int);
    callback close-panel(int);
    callback set-mixer-gain(string, int);
    callback set-mixer-pan(string, int);
    callback toggle-mixer-mute(string);
    callback toggle-meters-paused();
    callback open-mixer-settings();

    background: Palette.tokens.panel-bg;
    border-width: 1px;
    border-color: Palette.tokens.border;
    VerticalBox {
        padding: 0px;
        spacing: 0px;
        DockHeader {
            title: I18n.text.mixer_title;
            panel-kind: root.panel-kind;
            floating: root.floating;
            move-panel(kind, delta) => { root.move-panel(kind, delta); }
            dock-drag-start(kind, x, y) => { root.dock-drag-start(kind, x, y); }
            dock-drag-moved(kind, x, y) => { root.dock-drag-moved(kind, x, y); }
            dock-drag-end(kind, x, y) => { root.dock-drag-end(kind, x, y); }
            float-panel(kind) => { root.float-panel(kind); }
            close-panel(kind) => { root.close-panel(kind); }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalBox {
                padding: 8px;
                spacing: 6px;
                ScrollView {
                    vertical-stretch: 1;
                    // Rows stack from the top of the dock the way a
                    // list widget does, instead of centring in the view.
                    VerticalLayout {
                        alignment: start;
                        spacing: 1px;
                    for channel in mixer-rows : MixerContextMenuArea {
                        height: 98px;
                        channel-id: channel.id;
                        channel-muted: channel.muted;
                        channel-gain: round(channel.gain * 1000);
                        toggle-mixer-mute(id) => { root.toggle-mixer-mute(id); }
                        set-mixer-gain(id, gain) => { root.set-mixer-gain(id, gain); }
                        background: Palette.tokens.row-bg;
                        border-width: 1px;
                        border-color: Palette.tokens.border;
                        VerticalBox {
                            padding: 7px;
                            spacing: 3px;
                            HorizontalBox {
                                spacing: 5px;
                                Text {
                                    text: channel.name;
                                    color: Palette.tokens.text;
                                    font-size: 11px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: channel.clipped
                                        ? "CLIP"
                                        : (channel.muted
                                            ? "MUTE"
                                            : round(channel.peak-db * 10) / 10 + " dB");
                                    color: channel.clipped
                                        ? #ffffff
                                        : (channel.peak-db > -6
                                            ? #ef4444
                                            : (channel.peak-db > -18 ? #eab308 : Palette.tokens.text-muted));
                                    font-size: 9px;
                                }
                            }
                            Slider {
                                minimum: 0;
                                maximum: 2;
                                step: 0.01;
                                value: channel.gain;
                                changed => set-mixer-gain(channel.id, round(self.value * 1000));
                            }
                            HorizontalBox {
                                spacing: 3px;
                                Text {
                                    text: "L";
                                    color: Palette.tokens.text-muted;
                                    font-size: 9px;
                                }
                                Slider {
                                    horizontal-stretch: 1;
                                    minimum: -1;
                                    maximum: 1;
                                    step: 0.01;
                                    value: channel.pan;
                                    changed => set-mixer-pan(channel.id, round(self.value * 1000));
                                }
                                Text {
                                    text: "R";
                                    color: Palette.tokens.text-muted;
                                    font-size: 9px;
                                }
                            }
                            Rectangle {
                                width: 100%;
                                height: 9px;
                                background: Palette.tokens.window-bg;
                                meter-fill := Rectangle {
                                    // A logarithmic -60..0 dBFS scale makes
                                    // ordinary speech visible instead of
                                    // compressing it into a few linear pixels.
                                    width: Math.clamp((channel.peak-db + 60) / 60, 0, 1) * parent.width;
                                    height: 100%;
                                    background: channel.muted
                                        ? Palette.tokens.meter-muted
                                        : (channel.peak-db > -6
                                            ? #ef4444
                                            : (channel.peak-db > -18 ? #eab308 : Palette.tokens.meter));
                                }
                                Rectangle {
                                    x: Math.clamp((channel.peak-hold-db + 60) / 60, 0, 1) * parent.width - 1px;
                                    width: 2px;
                                    height: 100%;
                                    background: channel.clipped ? #ffffff : Palette.tokens.text;
                                }
                                Rectangle { x: parent.width * 0.7; width: 1px; height: 100%; background: Palette.tokens.border-strong; }
                                Rectangle { x: parent.width * 0.9; width: 1px; height: 100%; background: Palette.tokens.border-strong; }
                            }
                            HorizontalBox {
                                alignment: end;
                                CompactButton {
                                    icon-name: channel.muted ? "volume-mute" : "volume";
                                    hint: channel.muted
                                        ? I18n.text.unmute
                                        : I18n.text.mute;
                                    clicked => toggle-mixer-mute(channel.id);
                                }
                            }
                        }
                    }
                    }
                }
                HorizontalBox {
                    spacing: 4px;
                    CompactButton {
                        icon-name: root.meters-paused ? "volume" : "pause";
                        hint: root.meters-paused ? I18n.text.resume_meters : I18n.text.pause_meters;
                        clicked => { root.toggle-meters-paused(); }
                    }
                    CompactButton {
                        icon-name: "settings";
                        hint: I18n.text.mixer_options;
                        clicked => { root.open-mixer-settings(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}
