import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { CompactButton, DockHeader, MutedText } from "theme.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

// The OBS controls dock: one full-width button per output action, with the
// virtual camera gear docked beside its button.
export component ControlsDock inherits Rectangle {
    in property <bool> recording;
    in property <bool> streaming;
    in property <bool> replay-buffering;
    in property <bool> replay-saving;
    in property <bool> remux-recovery-supported;
    in property <bool> remux-recovery-running;
    in property <int> panel-kind;

    in property <bool> floating;
    /// Whether the unavailable virtual camera is currently explaining itself.
    property <bool> virtual-camera-explained: false;
    callback move-panel(int, int);
    callback dock-drag-start(int, float, float);
    callback dock-drag-moved(int, float, float);
    callback dock-drag-end(int, float, float);
    callback float-panel(int);
    callback close-panel(int);
    callback toggle-recording();
    callback toggle-streaming();
    callback toggle-replay-buffer();
    callback save-replay-buffer();
    callback recover-recording();
    callback set-view-mode(int);
    callback open-settings-window();

    background: Palette.tokens.panel-bg;
    border-width: 1px;
    border-color: Palette.tokens.border;

    VerticalBox {
        padding: 0px;
        spacing: 0px;
        DockHeader {
            title: I18n.text.controls_title;
            panel-kind: root.panel-kind;
            floating: root.floating;
            move-panel(kind, delta) => { root.move-panel(kind, delta); }
            dock-drag-start(kind, x, y) => { root.dock-drag-start(kind, x, y); }
            dock-drag-moved(kind, x, y) => { root.dock-drag-moved(kind, x, y); }
            dock-drag-end(kind, x, y) => { root.dock-drag-end(kind, x, y); }
            float-panel(kind) => { root.float-panel(kind); }
            close-panel(kind) => { root.close-panel(kind); }
        }
        VerticalBox {
            padding: 8px;
            spacing: 6px;
            Button {
                text: streaming
                    ? I18n.text.stop_streaming
                    : I18n.text.start_streaming;
                height: 30px;
                clicked => toggle-streaming();
            }
            Button {
                text: recording
                    ? I18n.text.stop_recording
                    : I18n.text.start_recording;
                height: 30px;
                clicked => toggle-recording();
            }
            Button {
                text: replay-buffering
                    ? I18n.text.stop_replay_buffer
                    : I18n.text.start_replay_buffer;
                height: 30px;
                clicked => toggle-replay-buffer();
            }
            Button {
                text: I18n.text.save_replay_buffer;
                height: 30px;
                enabled: replay-buffering && !replay-saving;
                clicked => save-replay-buffer();
            }
            if root.remux-recovery-supported : Button {
                text: I18n.text.recover_recording;
                height: 30px;
                enabled: !recording && !streaming && !remux-recovery-running;
                clicked => recover-recording();
            }
            // OBS-RS has no virtual camera backend yet. The control keeps its
            // place in the dock but stays disabled, and clicking it explains
            // the missing capability instead of doing nothing — a dead button
            // reads as a bug, an answered one reads as a limitation.
            Rectangle {
                height: 30px;
                // The disabled child controls describe the unavailable
                // capability; this wrapper remains an enabled information
                // action so keyboard and assistive-technology users can get
                // the same explanation as pointer users.
                accessible-role: button;
                accessible-label: I18n.text.start_virtual_camera;
                accessible-description: I18n.text.camera_unsupported_hint;
                accessible-enabled: true;
                accessible-checkable: true;
                accessible-checked: root.virtual-camera-explained;
                accessible-action-default => {
                    root.virtual-camera-explained = !root.virtual-camera-explained;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 4px;
                    Button {
                        text: I18n.text.start_virtual_camera;
                        height: 30px;
                        enabled: false;
                        horizontal-stretch: 1;
                    }
                    CompactButton {
                        icon-name: "settings";
                        hint: I18n.text.virtual_camera_options;
                        enabled: false;
                        height: 30px;
                    }
                }
                TouchArea {
                    clicked => {
                        root.virtual-camera-explained = !root.virtual-camera-explained;
                    }
                }
            }
            if root.virtual-camera-explained : MutedText {
                text: I18n.text.camera_unsupported_hint;
                wrap: word-wrap;
            }
            Button {
                text: I18n.text.studio_mode;
                height: 30px;
                clicked => set-view-mode(-1);
            }
            Button {
                text: I18n.text.settings;
                height: 30px;
                clicked => { root.open-settings-window(); }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
