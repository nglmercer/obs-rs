import { ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { CompactButton, DockHeader } from "theme.slint";
import { SceneRow } from "models.slint";
import { I18n } from "i18n.slint";

export component SceneDock inherits Rectangle {
    in property <string> locale;
    in property <[SceneRow]> scene-rows;
    in property <int> panel-kind;
    callback move-panel(int, int);
    callback select-preview(string);
    callback select-program(string);
    callback remove-scene(string);

    background: rgb(31, 34, 41);
    border-width: 1px;
    border-color: rgb(55, 60, 69);
    VerticalBox {
        DockHeader {
            title: I18n.text.scenes_title;
            panel-kind: root.panel-kind;
            move-panel(kind, delta) => { root.move-panel(kind, delta); }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalBox {
                padding: 8px;
                spacing: 6px;
                ScrollView {
                    vertical-stretch: 1;
                    for scene in scene-rows : Rectangle {
                        height: 38px;
                        background: scene.role != "" ? rgb(51, 73, 105) : rgb(39, 43, 50);
                        border-width: 1px;
                        border-color: rgb(55, 60, 69);
                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            VerticalBox {
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text {
                                    text: scene.name;
                                    color: rgb(226, 232, 240);
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                        TouchArea {
                            clicked => select-preview(scene.id);
                            double-clicked => select-program(scene.id);
                        }
                    }
                }
                HorizontalBox {
                    spacing: 4px;
                    CompactButton { icon-name: "add"; hint: I18n.text.add_scene; }
                    CompactButton { icon-name: "remove"; hint: I18n.text.remove_scene; }
                    CompactButton { icon-name: "settings"; hint: I18n.text.scene_properties; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}
