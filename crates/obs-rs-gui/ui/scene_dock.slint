import { ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { CompactButton, DockHeader } from "theme.slint";
import { SceneRow } from "models.slint";
import { SceneContextMenuArea } from "context_menus.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

export component SceneDock inherits Rectangle {
    in property <string> locale;
    in property <[SceneRow]> scene-rows;
    in property <string> preview-scene;
    in property <int> panel-kind;
    in property <bool> floating;
    callback move-panel(int, int);
    callback dock-drag-start(int, float, float);
    callback dock-drag-moved(int, float, float);
    callback dock-drag-end(int, float, float);
    callback float-panel(int);
    callback close-panel(int);
    callback open-modal(int);
    callback select-preview(string);
    callback select-program(string);
    callback duplicate-scene(string);
    callback move-scene(string, int);
    callback remove-scene(string);
    callback open-scene-projector(string);

    background: Palette.tokens.panel-bg;
    border-width: 1px;
    border-color: Palette.tokens.border;
    VerticalBox {
        padding: 0px;
        spacing: 0px;
        DockHeader {
            title: I18n.text.scenes_title;
            panel-kind: root.panel-kind;
            floating: root.floating;
            move-panel(kind, delta) => { root.move-panel(kind, delta); }
            dock-drag-start(kind, x, y) => { root.dock-drag-start(kind, x, y); }
            dock-drag-moved(kind, x, y) => { root.dock-drag-moved(kind, x, y); }
            dock-drag-end(kind, x, y) => { root.dock-drag-end(kind, x, y); }
            float-panel(kind) => { root.float-panel(kind); }
            close-panel(kind) => { root.close-panel(kind); }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalBox {
                padding: 8px;
                spacing: 6px;
                ScrollView {
                    vertical-stretch: 1;
                    // Rows stack from the top of the dock the way a
                    // list widget does, instead of centring in the view.
                    VerticalLayout {
                        alignment: start;
                        spacing: 1px;
                    for scene in scene-rows : scene-menu := SceneContextMenuArea {
                        height: 38px;
                        scene-id: scene.id;
                        can-remove: scene-rows.length > 1;
                        select-scene(id) => { root.select-preview(id); }
                        add-scene() => { root.open-modal(2); }
                        duplicate-scene(id) => { root.select-preview(id); root.duplicate-scene(id); }
                        open-scene-projector(id) => { root.open-scene-projector(id); }
                        rename-scene(id) => { root.select-preview(id); root.open-modal(5); }
                        move-scene(id, delta) => { root.select-preview(id); root.move-scene(id, delta); }
                        remove-scene(id) => { root.select-preview(id); root.remove-scene(id); }
                        background: scene.role != "" ? Palette.tokens.row-selected-bg : Palette.tokens.row-bg;
                        border-width: 1px;
                        border-color: Palette.tokens.border;
                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            VerticalBox {
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text {
                                    text: scene.name;
                                    color: Palette.tokens.text;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                        TouchArea {
                            clicked => select-preview(scene.id);
                            double-clicked => select-program(scene.id);
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down
                                    && event.button == PointerEventButton.right {
                                    select-preview(scene.id);
                                    scene-menu.show-at({ x: self.mouse-x, y: self.mouse-y });
                                }
                            }
                        }
                    }
                    }
                }
                HorizontalBox {
                    spacing: 4px;
                    CompactButton {
                        icon-name: "add";
                        hint: I18n.text.add_scene;
                        clicked => { root.open-modal(2); }
                    }
                    CompactButton {
                        icon-name: "remove";
                        hint: I18n.text.remove_scene;
                        enabled: root.preview-scene != "";
                        clicked => { root.remove-scene(root.preview-scene); }
                    }
                    CompactButton {
                        icon-name: "settings";
                        hint: I18n.text.scene_properties;
                        enabled: root.preview-scene != "";
                        clicked => { root.open-modal(5); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}
