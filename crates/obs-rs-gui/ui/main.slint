                multiview-select-preview(id) => { root.select-preview(id); }
                multiview-select-program(id) => { root.select-program(id); }
            }

            HorizontalSplitter {
                resized(delta) => {
                    root.dock-height = Math.clamp(
                        root.dock-height - delta,
                        150px,
                        Math.max(150px, root.height - 320px));
                }
            }

            DockWorkspace {
                height: root.dock-height;
                panes: root.dock-panes;
                splitters: root.dock-splitters;
                panel-floating: root.panel-floating;
                dock-dragging: root.dock-dragging;
                dock-drag-panel: root.dock-drag-panel;
