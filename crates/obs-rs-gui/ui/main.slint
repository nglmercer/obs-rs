import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { LocaleOption, ProfileRow, SceneRow, SourceRow, MixerRow } from "models.slint";
import { I18n } from "i18n.slint";
import { AppNavbar } from "navbar.slint";
import { StagePanel } from "stage.slint";
import { DockSlot } from "dock_slot.slint";
import { HorizontalSplitter, VerticalSplitter } from "theme.slint";
import { StatusBar } from "status_bar.slint";
import { Palette } from "palette.slint";
import {
    AboutDialog,
    CollectionDialog,
    ConfirmDialog,
    DiscardChangesDialog,
    OutputDialog,
    ProjectDialog,
    RecoveryDialog,
    RenameSceneDialog,
    RenameSourceDialog,
    SceneDialog,
} from "dialogs.slint";

export { AddSourceText, I18n, MonitorText, PropertyText, SettingsText, UiText } from "i18n.slint";
export { Metrics, Palette, ThemeTokens, UiMetrics } from "palette.slint";
export { SettingsWindow } from "settings_window.slint";
export { SetupWindow } from "setup_window.slint";
export { AddSourceWindow } from "add_source_window.slint";
export { SourcePropertiesWindow } from "source_properties_window.slint";
export { SourceFiltersWindow } from "source_filters_window.slint";
export { SourceTransformWindow } from "source_transform_window.slint";
export { MonitorWindow } from "monitor_window.slint";
export { ProjectorWindow } from "projector_window.slint";
export { FloatingDockWindow } from "floating_dock.slint";
export { MonitorRow, PropertyRow, SourceCandidate, SourceFilterRow, SourceKindRow } from "models.slint";

export component MainWindow inherits Window {
        width: 1180px;
        height: 900px;
        title: I18n.text.app_name;
        background: Palette.tokens.window-bg;

        in property <string> project-title;
        in property <string> profile-name;
        in property <string> locale;
        in property <string> preview-scene;
        in property <string> program-scene;
        in property <string> transition;
        in property <bool> recording;
        in property <bool> streaming;
        in property <bool> dirty;
        in property <string> status-message;
        in property <string> recovery-status;
        in property <string> setup-benchmark-summary;
        in property <string> output-status;
        in property <string> output-metrics;
        in property <string> recording-elapsed;
        in property <string> preview-metrics;
        in property <string> snapshot;
        in property <image> preview-image;
        in property <image> program-image;
        in property <int> canvas-width: 1920;
        in property <int> canvas-height: 1080;
        in property <[SceneRow]> scene-rows;
        in property <[SourceRow]> source-rows;
        in property <[ProfileRow]> profile-rows;
        in property <[ProfileRow]> collection-rows;
        in property <[LocaleOption]> locale-options;
        // Undo/redo availability comes from the project history, so the Edit
        // menu greys out an entry rather than offering a silent no-op.
        in property <bool> can-undo;
        in property <bool> can-redo;
        in property <string> active-collection;
        in property <string> app-version;
        in property <string> app-platform;
        in-out property <string> collection-name;
        in property <string> source-scene;
        in property <string> capture-capabilities;
        in property <[MixerRow]> mixer-rows;
        // OBS ships sources left of scenes; the ids stay stable so a reorder
        // never touches the data model.
        in-out property <[int]> panel-order: [1, 0, 2, 3, 4];
        // Width share per dock kind, adjusted by the splitters between docks.
        in-out property <[float]> panel-weights: [1.0, 1.0, 1.85, 1.0, 1.4];
        // Dock kinds currently detached into their own windows.
        in-out property <[bool]> panel-floating: [false, false, false, false, false];
        in property <string> scene-name-version;
        in-out property <string> scene-name;
        in property <string> selected-source;
        in property <bool> selected-source-visible: false;
        in property <bool> selected-source-locked: false;
        in property <bool> selected-source-first: false;
        in property <bool> selected-source-last: false;
        in property <bool> can-paste: false;
        in property <string> source-settings-version;
        in-out property <string> source-settings;
        in-out property <string> project-path;
        in-out property <string> diagnostics-path;
        in-out property <string> recording-path;
        in-out property <string> streaming-address;
        in-out property <string> new-scene-id;
        in-out property <string> new-scene-name;
        in-out property <string> new-source-id;
        in-out property <string> new-source-kind;
        in-out property <string> new-source-name;
        in-out property <string> source-name-draft;

        // Driven by the settings window; empty means the action is unbound.
        in property <string> hotkey-swap;
        in property <string> hotkey-start-recording;
        in property <string> hotkey-stop-recording;
        in property <string> hotkey-start-streaming;
        in property <string> hotkey-stop-streaming;
        in property <bool> confirm-start-stream;
        in property <bool> confirm-stop-stream;
        in property <bool> confirm-stop-recording;
        in property <bool> auto-record-when-streaming;

        // 0 = studio mode (preview + program), 1 = the single-canvas default.
        in-out property <int> view-mode: 1;
        // Dock visibility is restored from the settings document, so these are
        // readable and writable from Rust rather than window-private.
        in-out property <bool> show-sources: true;
        in-out property <bool> show-scenes: true;
        in-out property <bool> show-mixer: true;
        in-out property <bool> show-transitions: true;
        in-out property <bool> show-controls: true;
        // Pausing freezes the last measured levels without stopping capture.
        in-out property <bool> meters-paused: false;
        // 1 project · 2 add scene · 3 add source · 4 output · 5 rename scene
        // · 6 source properties · 7 source filters · 9 new collection
        // · 10 about · 12 rename source
        in-out property <int> active-modal: 0;
        // 0 none · 1 start stream · 2 stop stream · 3 stop recording
        property <int> pending-confirm: 0;
        // Actions that would throw away unsaved project edits, held until the
        // discard prompt is answered. 0 none · 4 new project · 5 exit
        // · 6 switch collection.
        property <int> pending-discard: 0;
        property <string> pending-collection;
        in-out property <length> dock-height: 248px;
        // The first-run wizard is a separate movable window, while this scrim
        // keeps the studio non-interactive until the wizard is applied or
        // skipped.
        in-out property <bool> setup-active: false;

        callback swap-scenes();
        callback toggle-recording();
        callback toggle-streaming();
        callback cut-transition();
        callback fade-transition();
        callback select-preview(string);
        callback select-program(string);
        callback duplicate-scene(string);
        callback remove-scene(string);
        callback rename-scene();
        callback select-profile(string);
        callback set-locale(string);
        callback select-source(string);
        callback toggle-source-visibility(string);
        callback toggle-source-locked(string);
        callback move-source(string, int);
        callback move-source-to(string, int);
        callback reset-source-transform(string);
        callback flip-source(string, bool);
        callback open-source-rename(string);
        callback apply-source-name();
        callback duplicate-source(string);
        callback copy-source(string);
        callback paste-reference();
        callback paste-duplicate();
        callback remove-source(string);
        callback apply-source-settings();
        callback set-mixer-gain(string, int);
        callback toggle-mixer-mute(string);
        callback toggle-meters-paused();
        callback save-project();
        callback load-project();
        callback recover-project();
        callback export-diagnostics();
        callback add-scene(string, string);
        callback add-source(string, string, string);
        callback move-panel(int, int);
        callback float-panel(int);
        callback resize-panel(int, int);
        callback open-settings-window();
        callback open-setup-window();
        callback open-add-source-window();
        callback open-source-properties-window();
        callback open-source-filters-window();
        callback open-source-transform-window();
        callback open-monitor-window();
        callback undo-edit();
        callback redo-edit();
        callback new-project();
        callback quit-app();
        callback reset-dock-layout();
        callback open-documentation();
        // `true` opens the program feed, `false` the preview feed.
        callback open-projector(bool);
        callback select-collection(string);
        callback create-collection(string);
        callback save-collection();
        // Reports the desktop portal's answer back onto the UI thread.
        // Includes the source that initiated the request so a selection
        // change while the compositor dialog is open cannot apply the token
        // to a different source.
        callback apply-portal-token(string, string);
        // Interactive canvas editing: `handle` is 0 for a move and 1-8 for the
        // resize handles, with the deltas already in canvas pixels.
        callback transform-dragged(int, int, int);
        callback transform-committed();
        callback canvas-clicked(int, int);

        // The selected scene item's rectangle in canvas pixels.
        in property <int> item-x;
        in property <int> item-y;
        in property <int> item-width;
        in property <int> item-height;
        in property <bool> item-active;
        in property <bool> item-locked;

        // Only a screen capture source has a display to choose, so the
        // affordance is derived from the selected row rather than duplicated in
        // every dock that offers it.
        in property <bool> selected-source-is-screen: false;

        // A mode of -1 means "toggle studio mode", which is how both the View
        // menu and the controls dock drive the canvas.
        function apply-view-mode(mode: int) {
            root.view-mode = mode == -1 ? (root.view-mode == 0 ? 1 : 0) : mode;
        }

        // Output actions route through these so the General settings page can
        // insert a confirmation without every caller knowing about it.
        function request-streaming() {
            if (!root.streaming && root.confirm-start-stream) {
                root.pending-confirm = 1;
            } else if (root.streaming && root.confirm-stop-stream) {
                root.pending-confirm = 2;
            } else {
                root.toggle-streaming();
            }
        }
        function request-recording() {
            if (root.recording && root.confirm-stop-recording) {
                root.pending-confirm = 3;
            } else {
                root.toggle-recording();
            }
        }
        // Discarding actions all share one prompt, and all skip it when there
        // is nothing to lose, so a clean session is never interrupted.
        function request-discarding-action(action: int) {
            if (root.dirty) {
                root.pending-discard = action;
            } else {
                root.resolve-discard(action);
            }
        }
        function request-collection(id: string) {
            root.pending-collection = id;
            root.request-discarding-action(6);
        }
        function resolve-discard(action: int) {
            if (action == 4) {
                root.new-project();
            } else if (action == 5) {
                root.quit-app();
            } else if (action == 6) {
                root.select-collection(root.pending-collection);
            }
            root.pending-discard = 0;
        }
        function resolve-confirm() {
            if (root.pending-confirm == 3) {
                root.toggle-recording();
            } else {
                root.toggle-streaming();
            }
            root.pending-confirm = 0;
        }

        // Rebuilds the "Ctrl+Shift+R" form the settings window stores, so a
        // binding is compared as text rather than as a compiled key list.
        pure function key-name(text: string) -> string {
            text == " " ? "Space"
                : text == Key.Return ? "Enter"
                : text == Key.Tab ? "Tab"
                : text == Key.F1 ? "F1"
                : text == Key.F2 ? "F2"
                : text == Key.F3 ? "F3"
                : text == Key.F4 ? "F4"
                : text == Key.F5 ? "F5"
                : text == Key.F6 ? "F6"
                : text == Key.F7 ? "F7"
                : text == Key.F8 ? "F8"
                : text == Key.F9 ? "F9"
                : text == Key.F10 ? "F10"
                : text == Key.F11 ? "F11"
                : text == Key.F12 ? "F12"
                : text.to-uppercase();
        }
        pure function hotkey-label(event: KeyEvent) -> string {
            (event.modifiers.control ? "Ctrl+" : "")
                + (event.modifiers.shift ? "Shift+" : "")
                + (event.modifiers.alt ? "Alt+" : "")
                + root.key-name(event.text);
        }

    FocusScope {
        key-pressed(event) => {
            // An unbound action stores an empty string, which must never match.
            if (root.hotkey-swap != "" && root.hotkey-label(event) == root.hotkey-swap) {
                root.swap-scenes();
                return accept;
            }
            if (root.hotkey-start-recording != ""
                && root.hotkey-label(event) == root.hotkey-start-recording
                && !root.recording) {
                root.request-recording();
                return accept;
            }
            if (root.hotkey-stop-recording != ""
                && root.hotkey-label(event) == root.hotkey-stop-recording
                && root.recording) {
                root.request-recording();
                return accept;
            }
            if (root.hotkey-start-streaming != ""
                && root.hotkey-label(event) == root.hotkey-start-streaming
                && !root.streaming) {
                root.request-streaming();
                return accept;
            }
            if (root.hotkey-stop-streaming != ""
                && root.hotkey-label(event) == root.hotkey-stop-streaming
                && root.streaming) {
                root.request-streaming();
                return accept;
            }
            reject
        }

        KeyBinding {
            keys: @keys(Control + S);
            activated => save-project();
        }
        KeyBinding {
            keys: @keys(Control + Shift + F);
            activated => fade-transition();
        }
        KeyBinding {
            keys: @keys(Control + Z);
            activated => undo-edit();
        }
        KeyBinding {
            keys: @keys(Control + Y);
            activated => redo-edit();
        }

        VerticalBox {
            padding: 0px;
            spacing: 0px;

            AppNavbar {
                locale: root.locale;
                profile-rows: root.profile-rows;
                collection-rows: root.collection-rows;
                locale-options: root.locale-options;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                studio-mode: root.view-mode == 0;
                show-sources: root.show-sources;
                show-scenes: root.show-scenes;
                show-mixer: root.show-mixer;
                show-transitions: root.show-transitions;
                show-controls: root.show-controls;
                set-locale(code) => { root.set-locale(code); }
                select-collection(id) => { root.request-collection(id); }
                menu-action(action) => {
                    if action == "new-project" {
                        root.request-discarding-action(4);
                    } else if action == "exit" {
                        root.request-discarding-action(5);
                    } else if action == "undo" {
                        root.undo-edit();
                    } else if action == "redo" {
                        root.redo-edit();
                    } else if action == "projector-program" {
                        root.open-projector(true);
                    } else if action == "projector-preview" {
                        root.open-projector(false);
                    } else if action == "reset-layout" {
                        root.reset-dock-layout();
                    } else if action == "new-collection" {
                        root.active-modal = 9;
                    } else if action == "save-collection" {
                        root.save-collection();
                    } else if action == "documentation" {
                        root.open-documentation();
                    } else if action == "about" {
                        root.active-modal = 10;
                    } else if action == "save-project" {
                        root.save-project();
                    } else if action == "load-project" {
                        root.load-project();
                    } else if action == "recover-project" {
                        root.recover-project();
                    } else if action == "export-diagnostics" {
                        root.export-diagnostics();
                    } else if action == "settings" {
                        root.open-settings-window();
                    } else if action == "auto-configuration" {
                        root.open-setup-window();
                    } else if action == "source-properties" {
                        root.open-source-properties-window();
                    } else if action == "source-filters" {
                        root.open-source-filters-window();
                    } else if action == "toggle-sources" {
                        root.show-sources = !root.show-sources;
                    } else if action == "toggle-scenes" {
                        root.show-scenes = !root.show-scenes;
                    } else if action == "toggle-mixer" {
                        root.show-mixer = !root.show-mixer;
                    } else if action == "toggle-transitions" {
                        root.show-transitions = !root.show-transitions;
                    } else if action == "toggle-controls" {
                        root.show-controls = !root.show-controls;
                    }
                }
                select-view-mode(mode) => { root.apply-view-mode(mode); }
                select-profile(id) => { root.select-profile(id); }
            }

            StagePanel {
                vertical-stretch: 1;
                locale: root.locale;
                preview-scene: root.preview-scene;
                program-scene: root.program-scene;
                preview-image: root.preview-image;
                program-image: root.program-image;
                canvas-width: root.canvas-width;
                canvas-height: root.canvas-height;
                selected-source: root.selected-source;
                selected-source-is-screen: root.selected-source-is-screen;
                item-x: root.item-x;
                item-y: root.item-y;
                item-width: root.item-width;
                item-height: root.item-height;
                item-active: root.item-active;
                item-locked: root.item-locked;
                view-mode: root.view-mode;
                open-source-properties() => { root.open-source-properties-window(); }
                open-source-filters() => { root.open-source-filters-window(); }
                open-monitor-window() => { root.open-monitor-window(); }
                transform-dragged(handle, dx, dy) => { root.transform-dragged(handle, dx, dy); }
                transform-committed() => { root.transform-committed(); }
                canvas-clicked(x, y) => { root.canvas-clicked(x, y); }
            }

            HorizontalSplitter {
                resized(delta) => {
                    root.dock-height = Math.clamp(
                        root.dock-height - delta,
                        150px,
                        Math.max(150px, root.height - 320px));
                }
            }

            Rectangle {
                height: root.dock-height;
                background: Palette.tokens.window-bg;
                HorizontalBox {
                    padding: 0px;
                    spacing: 1px;
                    for panel[index] in root.panel-order : HorizontalLayout {
                        spacing: 0px;
                        // A detached dock leaves the row entirely, and a hidden
                        // one keeps its place free rather than collapsing.
                        visible: !root.panel-floating[panel]
                            && ((panel == 0 && root.show-scenes)
                            || (panel == 1 && root.show-sources)
                            || (panel == 2 && root.show-mixer)
                            || (panel == 3 && root.show-transitions)
                            || (panel == 4 && root.show-controls));
                        horizontal-stretch: root.panel-weights[panel];
                        if index > 0 : VerticalSplitter {
                            resized(delta) => { root.resize-panel(index, delta / 1px); }
                        }
                        DockSlot {
                        panel-kind: panel;
                        weight: 1.0;
                        locale: root.locale;
                        scene-rows: root.scene-rows;
                        source-rows: root.source-rows;
                        mixer-rows: root.mixer-rows;
                        source-scene: root.source-scene;
                        preview-scene: root.preview-scene;
                        selected-source: root.selected-source;
                        selected-source-is-screen: root.selected-source-is-screen;
                        selected-source-visible: root.selected-source-visible;
                        selected-source-locked: root.selected-source-locked;
                        selected-source-first: root.selected-source-first;
                        selected-source-last: root.selected-source-last;
                        transition: root.transition;
                        recording: root.recording;
                        streaming: root.streaming;
                        meters-paused: root.meters-paused;
                        move-panel(kind, delta) => { root.move-panel(kind, delta); }
                        open-modal(modal) => {
                            // Adding a source has its own window now; the
                            // remaining modals stay in-window.
                            if modal == 3 {
                                root.open-add-source-window();
                            } else if modal == 6 {
                                root.open-source-properties-window();
                            } else if modal == 13 {
                                root.open-source-filters-window();
                            } else if modal == 14 {
                                root.open-source-transform-window();
                            } else if modal == 8 {
                                root.open-monitor-window();
                            } else {
                                root.active-modal = modal;
                            }
                        }
                        select-preview(id) => { root.select-preview(id); }
                        select-program(id) => { root.select-program(id); }
                        duplicate-scene(id) => { root.duplicate-scene(id); }
                        remove-scene(id) => { root.remove-scene(id); }
                        select-source(id) => { root.select-source(id); }
                        toggle-source-visibility(id) => { root.toggle-source-visibility(id); }
                        toggle-source-locked(id) => { root.toggle-source-locked(id); }
                        move-source(id, delta) => { root.move-source(id, delta); }
                        move-source-to(id, index) => { root.move-source-to(id, index); }
                        reset-source-transform(id) => { root.reset-source-transform(id); }
                        flip-source(id, horizontal) => { root.flip-source(id, horizontal); }
                        open-source-rename(id) => { root.open-source-rename(id); }
                        duplicate-source(id) => { root.duplicate-source(id); }
                        remove-source(id) => { root.remove-source(id); }
                        set-mixer-gain(id, gain) => { root.set-mixer-gain(id, gain); }
                        toggle-mixer-mute(id) => { root.toggle-mixer-mute(id); }
                        toggle-meters-paused() => { root.toggle-meters-paused(); }
                        cut-transition() => { root.cut-transition(); }
                        fade-transition() => { root.fade-transition(); }
                        toggle-recording() => { root.request-recording(); }
                        toggle-streaming() => { root.request-streaming(); }
                        open-settings-window() => { root.open-settings-window(); }
                        set-view-mode(mode) => { root.apply-view-mode(mode); }
                        float-panel(kind) => { root.float-panel(kind); }
                        close-panel(kind) => {
                            if kind == 0 { root.show-scenes = false; }
                            if kind == 1 { root.show-sources = false; }
                            if kind == 2 { root.show-mixer = false; }
                            if kind == 3 { root.show-transitions = false; }
                            if kind == 4 { root.show-controls = false; }
                        }
                        }
                    }
                }
            }

            StatusBar {
                locale: root.locale;
                recording: root.recording;
                streaming: root.streaming;
                output-status: root.output-status;
                output-metrics: root.output-metrics;
                recording-elapsed: root.recording-elapsed;
                view-mode: root.view-mode;
            }
        }
    }

    // Modals live at the window root so their scrim covers the whole window
    // instead of being clipped to the dock that opened them.
    if root.setup-active : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: 1000;
        background: rgb(0, 0, 0, 185);
        TouchArea { }
        Text {
            text: I18n.text.settings_ui.setup_title;
            color: Palette.tokens.text-strong;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            y: parent.height / 2 - 18px;
        }
    }
    ConfirmDialog {
        open: root.pending-confirm != 0;
        locale: root.locale;
        message: root.pending-confirm == 1
            ? I18n.text.settings_ui.prompt_start_stream
            : root.pending-confirm == 2
                ? I18n.text.settings_ui.prompt_stop_stream
                : I18n.text.settings_ui.prompt_stop_recording;
        close => { root.pending-confirm = 0; }
        accepted => { root.resolve-confirm(); }
    }
    ProjectDialog {
        open: root.active-modal == 1;
        locale: root.locale;
        project-path <=> root.project-path;
        diagnostics-path <=> root.diagnostics-path;
        save-project() => { root.save-project(); }
        close => { root.active-modal = 0; }
        accepted => { root.active-modal = 0; }
    }
    SceneDialog {
        open: root.active-modal == 2;
        locale: root.locale;
        new-scene-id <=> root.new-scene-id;
        new-scene-name <=> root.new-scene-name;
        add-scene(id, name) => { root.add-scene(id, name); }
        close => { root.active-modal = 0; }
        accepted => { root.active-modal = 0; }
    }
    OutputDialog {
        open: root.active-modal == 4;
        locale: root.locale;
        recording-path <=> root.recording-path;
        streaming-address <=> root.streaming-address;
        close => { root.active-modal = 0; }
        accepted => { root.active-modal = 0; }
    }
    RenameSceneDialog {
        open: root.active-modal == 5;
        locale: root.locale;
        scene-name <=> root.scene-name;
        rename-scene() => { root.rename-scene(); }
        close => { root.active-modal = 0; }
        accepted => { root.active-modal = 0; }
    }
    RenameSourceDialog {
        open: root.active-modal == 12;
        locale: root.locale;
        source-name <=> root.source-name-draft;
        rename-source() => { root.apply-source-name(); }
        close => { root.active-modal = 0; }
        accepted => { root.active-modal = 0; }
    }
    CollectionDialog {
        open: root.active-modal == 9;
        locale: root.locale;
        active-collection: root.active-collection;
        collection-name <=> root.collection-name;
        create-collection(name) => { root.create-collection(name); }
        close => { root.active-modal = 0; }
        accepted => { root.active-modal = 0; }
    }
    AboutDialog {
        open: root.active-modal == 10;
        locale: root.locale;
        version: root.app-version;
        platform: root.app-platform;
        close => { root.active-modal = 0; }
        accepted => { root.active-modal = 0; }
    }
    DiscardChangesDialog {
        open: root.pending-discard != 0;
        locale: root.locale;
        close => { root.pending-discard = 0; }
        accepted => { root.resolve-discard(root.pending-discard); }
    }
    RecoveryDialog {
        open: root.active-modal == 11;
        detail: root.status-message;
        close => { root.active-modal = 0; }
        accepted => {
            root.active-modal = 0;
            root.open-settings-window();
        }
    }
}
