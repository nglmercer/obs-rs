                remux-recovery-running: root.remux-recovery-running;
                meters-paused: root.meters-paused;
                show-scenes <=> root.show-scenes;
                show-sources <=> root.show-sources;
                show-mixer <=> root.show-mixer;
                show-transitions <=> root.show-transitions;
                show-controls <=> root.show-controls;
                show-stats <=> root.show-stats;
                status-message: root.status-message;
                capture-capabilities: root.capture-capabilities;
                preview-metrics: root.preview-metrics;
                output-metrics: root.output-metrics;
                move-panel(kind, delta) => { root.move-panel(kind, delta); }
                resize-panel(index, delta) => { root.resize-panel(index, delta); }
                select-dock-tab(kind) => { root.select-dock-tab(kind); }
                dock-drag-start(kind, x, y) => { root.dock-drag-start(kind, x, y); }
                dock-drag-moved(kind, x, y) => { root.dock-drag-moved(kind, x, y); }
                dock-drag-end(kind, x, y) => { root.dock-drag-end(kind, x, y); }
                resize-dock-splitter(id, delta) => { root.resize-dock-splitter(id, delta); }
                open-main-modal(modal) => { root.active-modal = modal; }
                open-add-source-window() => { root.open-add-source-window(); }
                open-source-properties-window() => { root.open-source-properties-window(); }
