    }

    // Window-level dialogs live in their own overlay component while all
    // state and mutations remain owned by MainWindow/Rust.
    MainModals {
        locale: root.locale;
        setup-active: root.setup-active;
        pending-confirm: root.pending-confirm;
        active-modal: root.active-modal;
        pending-discard: root.pending-discard;
        project-path <=> root.project-path;
        collection-transfer-path <=> root.collection-transfer-path;
        diagnostics-path <=> root.diagnostics-path;
        project-dialog-mode <=> root.project-dialog-mode;
        recording-path <=> root.recording-path;
