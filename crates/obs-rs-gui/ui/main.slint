import { VerticalBox } from "std-widgets.slint";
import { DockPane, DockSplitter, LocaleOption, MoveTarget, MultiviewScene, ProfileRow, SceneRow, SourceRow, MixerRow } from "models.slint";
import { I18n } from "i18n.slint";
import { MainNavbar } from "main_navbar.slint";
import { StagePanel } from "stage.slint";
import { DockWorkspace } from "dock_workspace.slint";
import { HorizontalSplitter } from "theme.slint";
import { StatusBar } from "status_bar.slint";
import { Palette } from "palette.slint";
import { MainModals } from "main_modals.slint";
import { MainKeyboard } from "main_keyboard.slint";

export { AddSourceText, I18n, MonitorText, PropertyText, SettingsText, UiText } from "i18n.slint";
export { Metrics, Palette, ThemeTokens, UiMetrics } from "palette.slint";
export { SettingsWindow } from "settings_window.slint";
export { SetupWindow } from "setup_window.slint";
export { AddSourceWindow } from "add_source_window.slint";
export { SourcePropertiesWindow } from "source_properties_window.slint";
export { SourceFiltersWindow } from "source_filters_window.slint";
export { SourceTransformWindow } from "source_transform_window.slint";
export { MonitorWindow } from "monitor_window.slint";
export { ProjectorWindow } from "projector_window.slint";
export { FloatingDockWindow } from "floating_dock.slint";
export { DockPane, DockSplitter, MonitorRow, MoveTarget, MultiviewScene, PropertyRow, SourceCandidate, SourceFilterRow, SourceKindRow } from "models.slint";

export component MainWindow inherits Window {
        width: 1180px;
        height: 900px;
        title: I18n.text.app_name;
        background: Palette.tokens.window-bg;

        in property <string> project-title;
        in property <string> profile-name;
        in property <string> locale;
        in property <string> preview-scene;
        in property <string> program-scene;
        in property <string> transition;
        in property <string> transition-kind;
        in-out property <int> transition-direction-index: 0;
        in-out property <bool> swipe-in: false;
        in-out property <int> luma-pattern-index: 0;
        in-out property <bool> luma-invert: false;
        in-out property <string> luma-softness: "30";
        in property <bool> recording;
        in property <bool> streaming;
        in property <bool> replay-buffering;
        in property <bool> replay-saving;
        in property <bool> remux-recovery-supported;
        in property <bool> remux-recovery-running;
        in property <[string]> remux-recovery-candidates;
        in-out property <string> remux-recovery-path;
        in property <bool> dirty;
        in property <string> status-message;
        in property <string> recovery-status;
        in property <string> setup-benchmark-summary;
        in property <string> output-status;
        in property <string> output-metrics;
        in property <string> recording-elapsed;
        in property <string> preview-metrics;
        in property <string> snapshot;
        in property <image> preview-image;
        in property <image> program-image;
        in property <image> multiview-image;
        in property <image> source-projector-image;
        in property <image> scene-projector-image;
        in property <string> multiview-status;
        in property <string> multiview-metrics;
        in property <float> multiview-audio-db: -60.0;
        // Transient canvas viewport state is owned by the Rust canvas
        // controller; this property only presents its current zoom choice.
        in property <int> canvas-zoom: 0;
        in property <int> canvas-pan-x: 0;
        in property <int> canvas-pan-y: 0;
        in property <int> canvas-pointer-mode: 0;
        in property <bool> selection-box-active: false;
        in property <int> selection-box-x;
        in property <int> selection-box-y;
        in property <int> selection-box-width;
        in property <int> selection-box-height;
        in property <int> canvas-width: 1920;
        in property <int> canvas-height: 1080;
        in property <bool> show-safe-areas: false;
        in property <[SceneRow]> scene-rows;
        in property <[MultiviewScene]> multiview-scenes;
        in property <[SourceRow]> source-rows;
        in property <[ProfileRow]> profile-rows;
        in property <[ProfileRow]> collection-rows;
        in property <[LocaleOption]> locale-options;
        // Undo/redo availability comes from the project history, so the Edit
        // menu greys out an entry rather than offering a silent no-op.
        in property <bool> can-undo;
        in property <bool> can-redo;
        in property <string> active-collection;
        in property <string> app-version;
        in property <string> app-platform;
        in-out property <string> collection-name;
        in-out property <bool> duplicate-collection-dialog: false;
        in-out property <bool> rename-collection-dialog: false;
        in property <string> source-scene;
        in property <string> capture-capabilities;
        in property <[MixerRow]> mixer-rows;
        in property <[DockPane]> dock-panes;
        in property <[DockSplitter]> dock-splitters;
        // OBS ships sources left of scenes; the ids stay stable so a reorder
        // never touches the data model.
        in-out property <[int]> panel-order: [1, 0, 2, 3, 4, 5];
        // Width share per dock kind, adjusted by the splitters between docks.
        in-out property <[float]> panel-weights: [1.0, 1.0, 1.85, 1.0, 1.4, 1.1];
        // Dock kinds currently detached into their own windows.
        in-out property <[bool]> panel-floating: [false, false, false, false, false, false];
        // Transient drag state is UI interaction state, not project or layout
        // state. Rust owns the target resolution; Slint only paints it.
        in-out property <bool> dock-dragging: false;
        in-out property <int> dock-drag-panel: -1;
        in-out property <int> dock-drop-target: -1;
        in-out property <int> dock-drop-zone: -1;
        in property <string> scene-name-version;
        in-out property <string> scene-name;
        in-out property <int> scene-transition-index: 0;
        in-out property <int> scene-transition-direction-index: 0;
        in-out property <bool> scene-transition-swipe-in: false;
        in-out property <int> scene-transition-luma-pattern-index: 0;
        in-out property <bool> scene-transition-luma-invert: false;
        in-out property <string> scene-transition-luma-softness: "30";
        in-out property <string> scene-transition-duration;
        in-out property <string> scene-transition-color;
        in-out property <string> scene-stinger-path;
        in-out property <string> scene-stinger-transition-point: "500";
        in-out property <bool> scene-stinger-preload: true;
        in-out property <bool> scene-stinger-hardware-decode: false;
        in-out property <bool> scene-stinger-hardware-decode-enabled: false;
        in-out property <bool> file-picker-enabled: false;
        in property <string> scene-properties-version;
        in property <string> selected-source;
        in property <bool> selected-source-visible: false;
        in property <bool> selected-source-locked: false;
        in property <bool> selected-source-first: false;
        in property <bool> selected-source-last: false;
        in property <[MoveTarget]> selected-source-move-targets;
        in property <int> source-count: 0;
        in property <bool> can-paste: false;
        in property <bool> can-group-sources: false;
        in property <string> source-settings-version;
        in-out property <string> source-settings;
        in-out property <string> project-path;
        in-out property <string> collection-transfer-path;
        in-out property <string> diagnostics-path;
        in-out property <int> project-dialog-mode: 0;
        in-out property <string> recording-path;
        in-out property <string> streaming-address;
        in-out property <string> new-scene-id;
        in-out property <string> new-scene-name;
        in-out property <string> new-source-id;
        in-out property <string> new-source-kind;
        in-out property <string> new-source-name;
        in-out property <string> source-name-draft;
        // The rename modal applies to the row that opened it, even if the
        // transient canvas selection changes while the dialog is visible.
        in-out property <string> source-rename-target;

        in property <bool> confirm-start-stream;
        in property <bool> confirm-stop-stream;
        in property <bool> confirm-stop-recording;
        in property <bool> auto-record-when-streaming;

        // 0 = studio mode, 1 = the single-canvas default, 2 = bounded multiview.
        in-out property <int> view-mode: 1;
        // Held while the spacebar temporarily turns the preview into a pan
        // surface, matching OBS's Space+drag navigation.
        in-out property <bool> space-held: false;
        // Dock visibility is restored from the settings document, so these are
        // readable and writable from Rust rather than window-private.
        in-out property <bool> show-sources: true;
        in-out property <bool> show-scenes: true;
        in-out property <bool> show-mixer: true;
        in-out property <bool> show-transitions: true;
        in-out property <bool> show-controls: true;
        in-out property <bool> show-stats: true;
        // Pausing freezes the last measured levels without stopping capture.
        in-out property <bool> meters-paused: false;
        // 1 project/save/export/import · 2 add scene · 3 add source · 4 output
        // · 5 rename scene · 6 source properties · 7 source filters
        // · 9 new collection · 10 about · 11 output failure · 12 rename source
        // · 13 interrupted-remux candidate chooser · 14 project recovery review
        // · 15 project recovery discard confirmation
        in-out property <int> active-modal: 0;
        // 0 none · 1 start stream · 2 stop stream · 3 stop recording
        property <int> pending-confirm: 0;
        // Actions that would throw away unsaved project edits, held until the
        // discard prompt is answered. 0 none · 4 new project · 5 exit
        // · 6 switch collection · 7 import collection · 8 load project
        // · 9 recover project.
        in-out property <int> pending-discard: 0;
        in-out property <string> pending-collection;
        in-out property <length> dock-height: 248px;
        // The first-run wizard is a separate movable window, while this scrim
        // keeps the studio non-interactive until the wizard is applied or
        // skipped.
        in-out property <bool> setup-active: false;

        callback swap-scenes();
        callback navigate-preview-scene(int);
        // Returns a bounded action ID for the canonical key label supplied by
        // the event bridge. Rust owns parsing and lookup; Slint only executes
        // the already-resolved UI action.
        callback trigger-shortcut(string) -> int;
        callback toggle-recording();
        callback toggle-streaming();
        callback toggle-studio-mode();
        callback toggle-replay-buffer();
        callback save-replay-buffer();
        callback recover-recording();
        callback recover-remux-candidate(string);
        callback cut-transition();
        callback take-stinger(string);
        callback browse-scene-stinger();
        callback browse-project-save-as();
        callback fade-transition();
        callback fade-transition-duration(string);
        callback slide-transition(string);
        callback swipe-transition(string);
        callback slide-transition-direction(string, int);
        callback swipe-transition-direction(string, int);
        callback swipe-transition-direction-mode(string, int, bool);
        callback fade-to-color(string, string);
        callback luma-transition(string, int, bool, string);
        callback set-scene-transition(string, string, string);
        callback set-scene-transition-direction(string, string, string, int);
        callback set-scene-transition-direction-mode(string, string, string, int, bool);
        callback set-scene-transition-luma(string, string, int, bool, string);
        callback clear-scene-transition();
        // Display-only menu labels. Runtime matching uses the typed table.
        in property <string> hotkey-undo;
        in property <string> hotkey-redo;
        in property <string> hotkey-save-project;
        in property <string> hotkey-cut-transition;
        in property <string> hotkey-fade-transition;
        in property <string> hotkey-previous-scene;
        in property <string> hotkey-next-scene;
        in property <string> hotkey-save-replay;
        in property <string> hotkey-toggle-studio-mode;
        callback select-preview(string);
        callback select-program(string);
        callback duplicate-scene(string);
        callback move-scene(string, int);
        callback drop-scene(data-transfer, string, int);
        callback remove-scene(string);
        callback rename-scene();
        callback select-profile(string);
        callback set-locale(string);
        callback select-source(string);
        callback select-source-with-mode(string, int);
        callback select-all-sources();
        callback navigate-source-selection(int, int);
        callback toggle-source-visibility(string);
        callback toggle-source-locked(string);
        callback move-source(string, int);
        callback move-source-to(string, int);
        callback move-source-to-group(string, string);
        callback reset-source-transform(string);
        callback flip-source(string, bool);
        callback transform-source(string, string);
        callback open-source-rename(string);
        callback apply-source-name();
        callback duplicate-source(string);
        callback group-sources();
        callback ungroup-source(string);
        callback copy-source(string);
        callback paste-reference(string);
        callback paste-duplicate(string);
        callback remove-source(string);
        callback remove-selected-sources();
        callback drop-source(data-transfer, string, int);
        callback apply-source-settings();
        callback set-mixer-gain(string, int);
        callback set-mixer-pan(string, int);
        callback toggle-mixer-mute(string);
        callback set-mixer-muted(string, bool);
        callback toggle-meters-paused();
        callback save-project();
        callback open-save-project-as();
        callback save-project-as(string);
        callback save-discard(int);
        callback load-project();
        callback recover-project();
        callback discard-project-recovery();
        callback export-diagnostics();
        callback add-scene(string, string);
        callback add-source(string, string, string);
        callback move-panel(int, int);
        callback select-dock-tab(int);
        // These are the toolkit-neutral insertion operations used by the
        // drag/drop packet and kept as typed callbacks at the window boundary.
        callback tab-dock-with(int, int);
        callback split-dock-with(int, int, int, int);
        callback dock-drag-start(int, float, float);
        callback dock-drag-moved(int, float, float);
        callback dock-drag-end(int, float, float);
        callback resize-dock-splitter(int, float);
        callback float-panel(int);
        callback resize-panel(int, int);
        callback open-settings-window();
        callback open-audio-settings-window();
        callback open-setup-window();
        callback open-add-source-window();
        callback open-source-properties-window();
        callback open-source-properties-for(string);
        callback open-source-filters-window();
        callback open-source-filters-for(string);
        callback open-source-transform-window();
        callback open-source-transform-for(string);
        callback open-monitor-window();
        callback undo-edit();
        callback redo-edit();
        callback new-project();
        callback quit-app();
        callback reset-dock-layout();
        callback open-documentation();
        // `true` opens the program feed, `false` the preview feed.
        callback open-projector(bool);
        callback open-multiview-projector();
        callback open-source-projector();
        callback open-scene-projector(string);
        callback select-collection(string);
        callback create-collection(string);
        callback duplicate-collection(string);
        callback rename-collection(string);
        callback export-collection(string);
        callback import-collection(string);
        callback save-collection();
        // Reports the desktop portal's answer back onto the UI thread.
        // Includes the source that initiated the request so a selection
        // change while the compositor dialog is open cannot apply the token
        // to a different source.
        callback apply-portal-token(string, string);
        // Interactive canvas editing: `handle` is 0 for a move and 1-8 for the
        // resize handles, with the deltas already in canvas pixels.
        callback transform-dragged(int, int, int, int);
        callback transform-committed();
        callback rotation-started(int, int);
        callback rotation-dragged(int, int, int);
        callback canvas-pointer-pressed(int, int, bool);
        callback canvas-selection-dragged(int, int);
        callback canvas-selection-committed();
        callback canvas-nudged(int, int);
        callback canvas-zoom-changed(int);
        callback canvas-zoom-step(int);
        callback canvas-zoom-at(int, int, int, int, int, int, int, int);
        callback canvas-pan-dragged(int, int);

        // The selected scene item's rectangle in canvas pixels.
        in property <int> item-x;
        in property <int> item-y;
        in property <int> item-width;
        in property <int> item-height;
        in property <[int]> item-handle-x: [0, 0, 0, 0, 0, 0, 0, 0];
        in property <[int]> item-handle-y: [0, 0, 0, 0, 0, 0, 0, 0];
        in property <int> rotation-handle-x;
        in property <int> rotation-handle-y;
        in property <bool> rotation-handle-active: false;
        in property <string> item-selection-path: "";
        in property <bool> item-active;
        in property <bool> item-locked;

        // Only a screen capture source has a display to choose, so the
                // affordance is derived from the selected row rather than duplicated in
                // every dock that offers it.
        in property <bool> selected-source-is-screen: false;
        in property <bool> selected-source-is-group: false;
        in property <bool> selected-source-is-scene: false;
        in property <bool> selected-source-is-nested: false;

        // A mode of -1 means "toggle studio mode", which is how both the View
        // menu and the controls dock drive the canvas.
        function apply-view-mode(mode: int) {
            root.view-mode = mode == -1 ? (root.view-mode == 0 ? 1 : 0) : mode;
        }

        // Output actions route through these so the General settings page can
        // insert a confirmation without every caller knowing about it.
        function request-streaming() {
            if (!root.streaming && root.confirm-start-stream) {
                root.pending-confirm = 1;
            } else if (root.streaming && root.confirm-stop-stream) {
                root.pending-confirm = 2;
            } else {
                root.toggle-streaming();
            }
        }
        function request-recording() {
            if (root.recording && root.confirm-stop-recording) {
                root.pending-confirm = 3;
            } else {
                root.toggle-recording();
            }
        }
        // Discarding actions all share one prompt, and all skip it when there
        // is nothing to lose, so a clean session is never interrupted.
        function request-discarding-action(action: int) {
            if (root.dirty) {
                root.pending-discard = action;
            } else {
                root.resolve-discard(action);
            }
        }
        function request-collection(id: string) {
            root.pending-collection = id;
            root.request-discarding-action(6);
        }
        function open-import-collection() {
            root.project-dialog-mode = 2;
            root.active-modal = 1;
        }
        function request-import-collection() {
            root.collection-transfer-path = "";
            root.request-discarding-action(7);
        }
        function request-load-project() {
            root.request-discarding-action(8);
        }
        function request-recover-project() {
            root.request-discarding-action(9);
        }
        function resolve-discard(action: int) {
            if (action == 4) {
                root.new-project();
            } else if (action == 5) {
                root.quit-app();
            } else if (action == 6) {
                root.select-collection(root.pending-collection);
            } else if (action == 7) {
                root.open-import-collection();
            } else if (action == 8) {
                root.project-dialog-mode = 4;
                root.active-modal = 1;
            } else if (action == 9) {
                root.recover-project();
            }
            root.pending-discard = 0;
        }
        function resolve-confirm() {
            if (root.pending-confirm == 3) {
                root.toggle-recording();
            } else {
                root.toggle-streaming();
            }
            root.pending-confirm = 0;
        }

    keyboard := MainKeyboard {
        recording: root.recording;
        streaming: root.streaming;
        replay-buffering: root.replay-buffering;
        selected-source: root.selected-source;
        selected-source-is-group: root.selected-source-is-group;
        selected-source-is-scene: root.selected-source-is-scene;
        selected-source-first: root.selected-source-first;
        selected-source-last: root.selected-source-last;
        source-count: root.source-count;
        can-paste: root.can-paste;
        preview-scene: root.preview-scene;
        space-held <=> root.space-held;
        swap-scenes() => { root.swap-scenes(); }
        navigate-preview-scene(direction) => { root.navigate-preview-scene(direction); }
        trigger-shortcut(label) => { root.trigger-shortcut(label); }
        request-recording() => { root.request-recording(); }
        request-streaming() => { root.request-streaming(); }
        undo-edit() => { root.undo-edit(); }
        redo-edit() => { root.redo-edit(); }
        save-project() => { root.save-project(); }
        cut-transition() => { root.cut-transition(); }
        fade-transition() => { root.fade-transition(); }
        save-replay-buffer() => { root.save-replay-buffer(); }
        toggle-replay-buffer() => { root.toggle-replay-buffer(); }
        toggle-mixer-mute(id) => { root.toggle-mixer-mute(id); }
        set-mixer-muted(id, muted) => { root.set-mixer-muted(id, muted); }
        toggle-studio-mode() => { root.toggle-studio-mode(); }
        toggle-source-visibility(id) => { root.toggle-source-visibility(id); }
        toggle-source-locked(id) => { root.toggle-source-locked(id); }
        open-source-projector() => { root.open-source-projector(); }
        open-scene-projector(id) => { root.open-scene-projector(id); }
        move-source(id, delta) => { root.move-source(id, delta); }
        move-source-to(id, index) => { root.move-source-to(id, index); }
        copy-source(id) => { root.copy-source(id); }
        paste-reference(target) => { root.paste-reference(target); }
        select-all-sources() => { root.select-all-sources(); }
        remove-selected-sources() => { root.remove-selected-sources(); }
        canvas-nudged(dx, dy) => { root.canvas-nudged(dx, dy); }
    }

    FocusScope {
        key-pressed(event) => {
            if (keyboard.handle-key-pressed(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt)) {
                return accept;
            }
            reject
        }

        key-released(event) => {
            if (keyboard.handle-key-released(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt)) {
                return accept;
            }
            reject
        }

        VerticalBox {
            padding: 0px;
            spacing: 0px;

            MainNavbar {
                locale: root.locale;
                profile-rows: root.profile-rows;
                collection-rows: root.collection-rows;
                locale-options: root.locale-options;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                studio-mode: root.view-mode == 0;
                show-sources <=> root.show-sources;
                show-scenes <=> root.show-scenes;
                show-mixer <=> root.show-mixer;
                show-transitions <=> root.show-transitions;
                show-controls <=> root.show-controls;
                show-stats <=> root.show-stats;
                hotkey-undo: root.hotkey-undo;
                hotkey-redo: root.hotkey-redo;
                hotkey-save-project: root.hotkey-save-project;
                hotkey-cut-transition: root.hotkey-cut-transition;
                hotkey-fade-transition: root.hotkey-fade-transition;
                hotkey-toggle-studio-mode: root.hotkey-toggle-studio-mode;
                view-mode: root.view-mode;
                set-locale(code) => { root.set-locale(code); }
                select-collection(id) => { root.request-collection(id); }
                request-discarding-action(action) => { root.request-discarding-action(action); }
                undo-edit() => { root.undo-edit(); }
                redo-edit() => { root.redo-edit(); }
                open-projector(program) => { root.open-projector(program); }
                open-multiview-projector() => { root.open-multiview-projector(); }
                open-source-projector() => { root.open-source-projector(); }
                reset-dock-layout() => { root.reset-dock-layout(); }
                new-collection() => {
                    root.duplicate-collection-dialog = false;
                    root.rename-collection-dialog = false;
                    root.collection-name = "";
                    root.active-modal = 9;
                }
                duplicate-collection() => {
                    root.duplicate-collection-dialog = true;
                    root.rename-collection-dialog = false;
                    root.collection-name = "";
                    root.active-modal = 9;
                }
                rename-collection() => {
                    root.duplicate-collection-dialog = false;
                    root.rename-collection-dialog = true;
                    root.collection-name = root.active-collection;
                    root.active-modal = 9;
                }
                export-collection() => {
                    root.project-dialog-mode = 1;
                    root.collection-transfer-path = "obs-rs-collection-export.obsrproj";
                    root.active-modal = 1;
                }
                request-import-collection() => { root.request-import-collection(); }
                save-collection() => { root.save-collection(); }
                open-documentation() => { root.open-documentation(); }
                about() => { root.active-modal = 10; }
                save-project() => { root.save-project(); }
                open-save-project-as() => { root.open-save-project-as(); }
                load-project() => { root.request-load-project(); }
                recover-project() => { root.request-recover-project(); }
                discard-project-recovery() => { root.discard-project-recovery(); }
                export-diagnostics() => { root.export-diagnostics(); }
                open-settings-window() => { root.open-settings-window(); }
                open-setup-window() => { root.open-setup-window(); }
                open-source-properties-window() => { root.open-source-properties-window(); }
                open-source-filters-window() => { root.open-source-filters-window(); }
                select-view-mode(mode) => { root.apply-view-mode(mode); }
                select-profile(id) => { root.select-profile(id); }
            }

            StagePanel {
                vertical-stretch: 1;
                locale: root.locale;
                preview-scene: root.preview-scene;
                program-scene: root.program-scene;
                preview-image: root.preview-image;
                program-image: root.program-image;
