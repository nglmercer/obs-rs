import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { I18n } from "i18n.slint";

component StageCard inherits Rectangle {
    in property <string> title;
    in property <string> scene;
    in property <image> frame;
    in property <bool> program;

    background: rgb(15, 17, 21);
    border-width: 1px;
    border-color: program ? rgb(104, 45, 45) : rgb(55, 60, 69);
    horizontal-stretch: 1;

    VerticalBox {
        spacing: 0px;
        Text {
            height: 24px;
            text: root.title;
            color: root.program ? rgb(248, 113, 113) : rgb(96, 165, 250);
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle {
            vertical-stretch: 1;
            background: black;
            Image {
                source: root.frame;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }
        Text {
            height: 22px;
            text: root.scene;
            color: rgb(148, 163, 184);
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component StagePanel inherits Rectangle {
    in property <string> locale;
    in property <string> preview-scene;
    in property <string> program-scene;
    in property <image> preview-image;
    in property <image> program-image;
    in property <int> view-mode;

    horizontal-stretch: 1;
    vertical-stretch: 4;
    min-height: 300px;
    background: rgb(18, 20, 25);
    border-width: 1px;
    border-color: rgb(55, 60, 69);

    VerticalBox {
        padding: 6px;
        spacing: 6px;
        if view-mode == 0 : HorizontalBox {
            spacing: 6px;
            vertical-stretch: 1;
            StageCard {
                title: I18n.text.preview;
                scene: preview-scene;
                frame: preview-image;
                program: false;
            }
            StageCard {
                title: I18n.text.program;
                scene: program-scene;
                frame: program-image;
                program: true;
            }
        }
        if view-mode == 1 : StageCard {
            title: I18n.text.preview;
            scene: preview-scene;
            frame: preview-image;
            program: false;
            vertical-stretch: 1;
        }
    }
}
