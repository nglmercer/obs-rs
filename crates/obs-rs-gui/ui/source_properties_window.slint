import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox, TextEdit } from "std-widgets.slint";
import { FieldHeading, MutedText } from "theme.slint";
import { SettingsGroup, SettingRow, SettingHint, ColorSwatch } from "settings_widgets.slint";
import { PropertyRow } from "models.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

// One property, rendered as the widget its kind calls for. Keeping the choice
// here rather than in Rust means a new property is data, not new UI.
component PropertyField inherits VerticalLayout {
    in property <PropertyRow> field;
    callback edited(string, string);
    spacing: 2px;

    // 0 text · 1 number · 2 toggle · 3 choice · 4 colour
    if field.kind == 0 : SettingRow {
        label: root.field.label;
        LineEdit {
            text: root.field.text;
            edited => { root.edited(root.field.key, self.text); }
            horizontal-stretch: 1;
        }
    }
    if field.kind == 1 : SettingRow {
        label: root.field.label;
        SpinBox {
            value: root.field.number;
            minimum: root.field.minimum;
            maximum: root.field.maximum;
            edited(value) => { root.edited(root.field.key, value); }
            horizontal-stretch: 1;
        }
    }
    if field.kind == 2 : SettingRow {
        label: root.field.label;
        CheckBox {
            checked: root.field.toggle;
            toggled => { root.edited(root.field.key, self.checked ? "true" : "false"); }
            horizontal-stretch: 1;
        }
    }
    if field.kind == 3 : SettingRow {
        label: root.field.label;
        ComboBox {
            model: root.field.choices;
            current-index: root.field.choice_index;
            // A choice reports its index; Rust maps it back to the stored value.
            selected(value) => { root.edited(root.field.key, self.current-index); }
            horizontal-stretch: 1;
        }
    }
    if field.kind == 4 : SettingRow {
        label: root.field.label;
        ColorSwatch { value: root.field.swatch; }
        LineEdit {
            text: root.field.text;
            placeholder-text: "#405070FF";
            edited => { root.edited(root.field.key, self.text); }
            horizontal-stretch: 1;
        }
    }
    if field.hint != "" : SettingHint { text: root.field.hint; }
}

// The OBS source properties dialog as its own window, so it can be moved aside
// while the canvas is watched. Edits stay local until OK, which is what lets
// Cancel and Defaults both be meaningful.
export component SourcePropertiesWindow inherits Window {
    title: I18n.text.add_source_ui.properties_for + "'" + root.source-name + "'";
    width: 720px;
    height: 640px;
    background: Palette.tokens.window-bg;

    in property <string> source-name;
    in property <string> source-kind;
    in property <string> source-kind-label;
    in property <string> capture-capabilities;
    in property <[PropertyRow]> property-rows;
    in property <bool> monitor-visible;
    in property <string> monitor-summary;
    in-out property <string> source-settings;
    in-out property <string> source-transform;
    in-out property <string> source-filters;
    in-out property <int> item-scale-x: 1000;
    in-out property <int> item-scale-y: 1000;
    in-out property <int> item-x: 0;
    in-out property <int> item-y: 0;
    in-out property <bool> item-flip-x: false;
    in-out property <bool> item-flip-y: false;
    in-out property <int> item-opacity: 255;
    in-out property <int> crop-left: 0;
    in-out property <int> crop-top: 0;
    in-out property <int> crop-right: 0;
    in-out property <int> crop-bottom: 0;
    in-out property <bool> show-advanced: false;

    callback accept-properties();
    callback cancel-properties();
    callback restore-defaults();
    callback edit-property(string, string);
    callback edit-transform(string, string);
    callback open-monitor-window();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Text {
            text: root.source-name + "  ·  " + root.source-kind-label;
            color: Palette.tokens.text-strong;
            font-size: 14px;
            font-weight: 700;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                alignment: start;

                SettingsGroup {
                    title: I18n.text.property_ui.settings_group;
                    for entry in root.property-rows : PropertyField {
                        field: entry;
                        edited(key, value) => { root.edit-property(key, value); }
                    }
                    // A display-backed source is pointed at a screen through
                    // the picker rather than by typing a monitor name.
                    if root.monitor-visible : SettingRow {
                        label: I18n.text.monitor_ui.select_monitor;
                        Button {
                            text: root.monitor-summary;
                            clicked => { root.open-monitor-window(); }
                            horizontal-stretch: 1;
                        }
                    }
                }

                SettingsGroup {
                    title: I18n.text.transform;
                    SettingRow {
                        label: I18n.text.property_ui.scale_axes;
                        SpinBox { value: root.item-scale-x; minimum: 1; maximum: 100000; edited(value) => root.edit-transform("scale-x", value); horizontal-stretch: 1; }
                        SpinBox { value: root.item-scale-y; minimum: 1; maximum: 100000; edited(value) => root.edit-transform("scale-y", value); horizontal-stretch: 1; }
                    }
                    SettingRow {
                        label: I18n.text.property_ui.position_axes;
                        SpinBox { value: root.item-x; minimum: -32768; maximum: 32768; edited(value) => root.edit-transform("x", value); horizontal-stretch: 1; }
                        SpinBox { value: root.item-y; minimum: -32768; maximum: 32768; edited(value) => root.edit-transform("y", value); horizontal-stretch: 1; }
                    }
                    SettingRow {
                        label: I18n.text.property_ui.opacity;
                        SpinBox { value: root.item-opacity; minimum: 0; maximum: 255; edited(value) => root.edit-transform("opacity", value); horizontal-stretch: 1; }
                    }
                    SettingRow {
                        label: I18n.text.property_ui.flip;
                        CheckBox { text: I18n.text.property_ui.flip_horizontal; checked: root.item-flip-x; toggled => root.edit-transform("flip-x", self.checked ? "1" : "0"); }
                        CheckBox { text: I18n.text.property_ui.flip_vertical; checked: root.item-flip-y; toggled => root.edit-transform("flip-y", self.checked ? "1" : "0"); }
                    }
                    SettingRow {
                        label: I18n.text.property_ui.crop_left_top;
                        SpinBox { value: root.crop-left; minimum: 0; maximum: 32768; edited(value) => root.edit-transform("crop-left", value); horizontal-stretch: 1; }
                        SpinBox { value: root.crop-top; minimum: 0; maximum: 32768; edited(value) => root.edit-transform("crop-top", value); horizontal-stretch: 1; }
                    }
                    SettingRow {
                        label: I18n.text.property_ui.crop_right_bottom;
                        SpinBox { value: root.crop-right; minimum: 0; maximum: 32768; edited(value) => root.edit-transform("crop-right", value); horizontal-stretch: 1; }
                        SpinBox { value: root.crop-bottom; minimum: 0; maximum: 32768; edited(value) => root.edit-transform("crop-bottom", value); horizontal-stretch: 1; }
                    }
                    CheckBox {
                        text: I18n.text.property_ui.show_advanced;
                        checked <=> root.show-advanced;
                    }
                    if root.show-advanced : SettingRow {
                        label: I18n.text.transform;
                        LineEdit {
                            text <=> root.source-transform;
                            placeholder-text: "1000,1000,0,0,0,0,255,0,0,0,0";
                            horizontal-stretch: 1;
                        }
                    }
                    SettingHint { text: I18n.text.property_ui.transform_hint; }
                }

                SettingsGroup {
                    title: I18n.text.filters_group;
                    SettingRow {
                        label: I18n.text.filters_prefix;
                        LineEdit {
                            text <=> root.source-filters;
                            placeholder-text: "gray,brightness:750,opacity:200";
                            horizontal-stretch: 1;
                        }
                    }
                    SettingHint { text: I18n.text.property_ui.filters_hint; }
                }

                SettingsGroup {
                    title: I18n.text.property_ui.advanced_group;
                    CheckBox {
                        text: I18n.text.property_ui.show_advanced;
                        checked <=> root.show-advanced;
                    }
                    if root.show-advanced : TextEdit {
                        text <=> root.source-settings;
                        placeholder-text: "width=640\nheight=360\ncolor=#202840FF";
                        min-height: 140px;
                    }
                    MutedText { text: root.capture-capabilities; }
                }
            }
        }

        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Button {
                text: I18n.text.add_source_ui.defaults;
                width: 130px;
                clicked => { root.restore-defaults(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: I18n.text.add_source_ui.ok;
                width: 110px;
                clicked => { root.accept-properties(); }
            }
            Button {
                text: I18n.text.cancel;
                width: 110px;
                clicked => { root.cancel-properties(); }
            }
        }
    }
}
