import { Button, VerticalBox } from "std-widgets.slint";
import { MutedText, PanelHeading, StudioPanel } from "theme.slint";
import { I18n } from "i18n.slint";

export component DiagnosticsPanel inherits Rectangle {
    in property <string> locale;
    in property <string> capture-capabilities;
    in property <string> preview-metrics;
    in property <string> output-status;
    in property <string> output-metrics;
    in property <string> snapshot;
    in property <string> status-message;
    callback export-diagnostics();

    background: transparent;
    VerticalBox {
        spacing: 10px;
        PanelHeading {
            text: I18n.text.diagnostics_title;
        }
        MutedText {
            text: I18n.text.diagnostics_description;
        }
        StudioPanel {
            height: 80px;
            VerticalBox {
                padding: 12px;
                spacing: 6px;
                Text {
                    text: I18n.text.runtime;
                    color: rgb(226, 232, 240);
                    font-size: 12px;
                    font-weight: 700;
                }
                MutedText { text: capture-capabilities; }
                MutedText { text: preview-metrics; }
            }
        }
        StudioPanel {
            height: 86px;
            VerticalBox {
                padding: 12px;
                spacing: 5px;
                Text {
                    text: I18n.text.tabs_output;
                    color: rgb(226, 232, 240);
                    font-size: 12px;
                    font-weight: 700;
                }
                Text { text: output-status; color: rgb(251, 191, 36); font-size: 11px; }
                MutedText { text: output-metrics; }
            }
        }
        StudioPanel {
            vertical-stretch: 1;
            min-height: 100px;
            VerticalBox {
                padding: 12px;
                spacing: 6px;
                Text {
                        text: I18n.text.accessible_snapshot;
                    color: rgb(226, 232, 240);
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: snapshot;
                    color: rgb(148, 163, 184);
                    font-size: 10px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
            }
        }
        Text {
            text: status-message;
            color: rgb(147, 197, 253);
            font-size: 11px;
            wrap: word-wrap;
        }
        Button {
            text: I18n.text.export_diagnostics;
            clicked => export-diagnostics();
        }
    }
}
