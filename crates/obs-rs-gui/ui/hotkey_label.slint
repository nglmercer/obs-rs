// Converts Slint key event pieces into the bounded canonical label consumed
// by the Rust-owned Shortcut table. Keeping this pure helper outside the main
// window prevents keyboard normalization from becoming another MainWindow
// responsibility as the action catalog grows.
export component HotkeyLabel inherits Rectangle {
    public pure function key-name(text: string) -> string {
        text == " " ? "Space"
            : text == Key.Return ? "Enter"
            : text == Key.Tab ? "Tab"
            : text == Key.F1 ? "F1"
            : text == Key.F2 ? "F2"
            : text == Key.F3 ? "F3"
            : text == Key.F4 ? "F4"
            : text == Key.F5 ? "F5"
            : text == Key.F6 ? "F6"
            : text == Key.F7 ? "F7"
            : text == Key.F8 ? "F8"
            : text == Key.F9 ? "F9"
            : text == Key.F10 ? "F10"
            : text == Key.F11 ? "F11"
            : text == Key.F12 ? "F12"
            : text.to-uppercase();
    }

    public pure function label(text: string, control: bool, shift: bool, alt: bool) -> string {
        (control ? "Ctrl+" : "")
            + (shift ? "Shift+" : "")
            + (alt ? "Alt+" : "")
            + root.key-name(text);
    }
}
