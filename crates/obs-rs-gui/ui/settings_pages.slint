import { Button, CheckBox, ComboBox, LineEdit, SpinBox, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { CheckRow, ColorSwatch, SettingHint, SettingRow, SettingsGroup } from "settings_widgets.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

// One component per settings category. Each takes only the properties it edits
// and reports changes upward; the window owns the draft state.

export component GeneralPage inherits VerticalLayout {
    in property <[string]> language-names;
    in property <int> language-index;
    in-out property <bool> confirm-start-stream;
    in-out property <bool> confirm-stop-stream;
    in-out property <bool> confirm-stop-recording;
    in-out property <bool> auto-record-when-streaming;
    callback select-language(int);
    callback changed();
    spacing: 14px;

    SettingsGroup {
        title: I18n.text.settings_ui.group_general;
        SettingRow {
            label: I18n.text.settings_ui.language;
            ComboBox {
                model: root.language-names;
                current-index: root.language-index;
                selected(value) => { root.select-language(self.current-index); }
                horizontal-stretch: 1;
            }
        }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_output_behaviour;
        CheckRow {
            label: I18n.text.settings_ui.confirm_start_stream;
            checked <=> root.confirm-start-stream;
            toggled(value) => { root.changed(); }
        }
        CheckRow {
            label: I18n.text.settings_ui.confirm_stop_stream;
            checked <=> root.confirm-stop-stream;
            toggled(value) => { root.changed(); }
        }
        CheckRow {
            label: I18n.text.settings_ui.confirm_stop_recording;
            checked <=> root.confirm-stop-recording;
            toggled(value) => { root.changed(); }
        }
        CheckRow {
            label: I18n.text.settings_ui.auto_record_when_streaming;
            checked <=> root.auto-record-when-streaming;
            toggled(value) => { root.changed(); }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

export component AppearancePage inherits VerticalLayout {
    in property <[string]> theme-names;
    in property <int> theme-index;
    callback select-theme(int);
    spacing: 14px;

    SettingsGroup {
        title: I18n.text.settings_ui.group_theme;
        SettingRow {
            label: I18n.text.settings_ui.theme;
            ComboBox {
                model: root.theme-names;
                current-index: root.theme-index;
                selected(value) => { root.select-theme(self.current-index); }
                horizontal-stretch: 1;
            }
        }
        SettingHint { text: I18n.text.settings_ui.theme_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component StreamPage inherits VerticalLayout {
    in property <[string]> protocol-names;
    in-out property <int> protocol-index;
    in property <bool> show-rtmp;
    in property <bool> show-srt;
    in property <bool> show-whip;
    in property <bool> show-reference;
    in-out property <string> rtmp-service;
    in-out property <string> rtmp-server;
    in-out property <string> rtmp-stream-key;
    in property <[string]> video-encoder-names;
    in-out property <int> video-encoder-index;
    in property <[string]> audio-encoder-names;
    in-out property <int> audio-encoder-index;
    in-out property <int> video-bitrate;
    in-out property <int> audio-bitrate;
    in-out property <string> rate-control;
    in-out property <int> keyframe-interval;
    in-out property <string> encoder-preset;
    in-out property <string> encoder-profile;
    in-out property <int> b-frames;
    in-out property <bool> reconnect;
    in-out property <int> maximum-retries;
    in-out property <int> network-buffer;
    in property <[string]> srt-mode-names;
    in-out property <int> srt-mode-index;
    in-out property <string> srt-host;
    in-out property <int> srt-port;
    in-out property <int> srt-latency;
    in-out property <string> srt-passphrase;
    in property <[string]> srt-key-length-names;
    in-out property <int> srt-key-length-index;
    in-out property <string> srt-stream-id;
    in-out property <int> srt-timeout;
    in-out property <string> whip-endpoint;
    in-out property <string> reference-address;
    callback select-protocol(int);
    callback select-video-encoder(int);
    callback select-audio-encoder(int);
    callback select-srt-mode(int);
    callback select-srt-key-length(int);
    callback changed();
    spacing: 14px;

    SettingsGroup {
        title: I18n.text.settings_ui.group_service;
        SettingRow {
            label: "Protocol";
            ComboBox {
                model: root.protocol-names;
                current-index: root.protocol-index;
                selected(value) => { root.select-protocol(self.current-index); }
                horizontal-stretch: 1;
            }
        }
        if root.show-rtmp : SettingRow {
            label: "Service";
            LineEdit { text <=> root.rtmp-service; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Server";
            LineEdit { text <=> root.rtmp-server; placeholder-text: "ingest.example/live"; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Stream Key";
            LineEdit { text <=> root.rtmp-stream-key; input-type: InputType.password; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Video Encoder";
            ComboBox { model: root.video-encoder-names; current-index: root.video-encoder-index; selected(value) => { root.select-video-encoder(self.current-index); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Audio Encoder";
            ComboBox { model: root.audio-encoder-names; current-index: root.audio-encoder-index; selected(value) => { root.select-audio-encoder(self.current-index); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Video Bitrate (kbps)";
            SpinBox { value <=> root.video-bitrate; minimum: 100; maximum: 100000; edited(value) => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Audio Bitrate (kbps)";
            SpinBox { value <=> root.audio-bitrate; minimum: 32; maximum: 1024; edited(value) => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Rate Control";
            LineEdit { text <=> root.rate-control; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Keyframe Interval (s)";
            SpinBox { value <=> root.keyframe-interval; minimum: 0; maximum: 20; edited(value) => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Preset";
            LineEdit { text <=> root.encoder-preset; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Profile";
            LineEdit { text <=> root.encoder-profile; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "B-frames";
            SpinBox { value <=> root.b-frames; minimum: 0; maximum: 16; edited(value) => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : CheckRow {
            label: "Automatically reconnect";
            checked <=> root.reconnect;
            toggled(value) => { root.changed(); }
        }
        if root.show-rtmp : SettingRow {
            label: "Maximum Retries";
            SpinBox { value <=> root.maximum-retries; minimum: 0; maximum: 1000; edited(value) => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-rtmp : SettingRow {
            label: "Network Buffer (ms)";
            SpinBox { value <=> root.network-buffer; minimum: 0; maximum: 60000; edited(value) => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-srt : SettingRow {
            label: "Mode";
            ComboBox { model: root.srt-mode-names; current-index: root.srt-mode-index; selected(value) => { root.select-srt-mode(self.current-index); } horizontal-stretch: 1; }
        }
        if root.show-srt : SettingRow {
            label: "Address";
            LineEdit { text <=> root.srt-host; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-srt : SettingRow {
            label: "Port";
            SpinBox { value <=> root.srt-port; minimum: 1; maximum: 65535; edited(value) => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-srt : SettingRow {
            label: "Latency (ms)";
            SpinBox { value <=> root.srt-latency; minimum: 20; maximum: 60000; edited(value) => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-srt : SettingRow {
            label: "Passphrase";
            LineEdit { text <=> root.srt-passphrase; input-type: InputType.password; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-srt : SettingRow {
            label: "PBKeyLen";
            ComboBox { model: root.srt-key-length-names; current-index: root.srt-key-length-index; selected(value) => { root.select-srt-key-length(self.current-index); } horizontal-stretch: 1; }
        }
        if root.show-srt : SettingRow {
            label: "Stream ID";
            LineEdit { text <=> root.srt-stream-id; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-srt : SettingRow {
            label: "Connection Timeout (ms)";
            SpinBox { value <=> root.srt-timeout; minimum: 100; maximum: 120000; edited(value) => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-whip : SettingRow {
            label: "WHIP Endpoint";
            LineEdit { text <=> root.whip-endpoint; placeholder-text: "https://service.example/whip"; edited => { root.changed(); } horizontal-stretch: 1; }
        }
        if root.show-reference : SettingRow {
            label: I18n.text.settings_ui.stream_server;
            LineEdit {
                text <=> root.reference-address;
                placeholder-text: "127.0.0.1:9000";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
        }
        SettingHint { text: "Only protocols and encoder implementations detected at runtime are listed."; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component OutputPage inherits VerticalLayout {
    in-out property <string> recording-path;
    in property <[string]> recording-format-names;
    in-out property <int> recording-format-index;
    callback select-recording-format(int);
    callback changed();
    spacing: 14px;

    SettingsGroup {
        title: I18n.text.settings_ui.group_recording;
        SettingRow {
            label: I18n.text.settings_ui.recording_path;
            LineEdit {
                text <=> root.recording-path;
                placeholder-text: "obs-rs-recording.obsr";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.recording_format;
            ComboBox {
                model: root.recording-format-names;
                current-index: root.recording-format-index;
                selected(value) => { root.select-recording-format(self.current-index); }
                horizontal-stretch: 1;
            }
        }
        SettingHint { text: I18n.text.settings_ui.recording_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component AudioPage inherits VerticalLayout {
    in property <[string]> sample-rate-names;
    in property <int> sample-rate-index;
    in property <[string]> channel-names;
    in property <int> channel-index;
    in property <[string]> audio-device-names;
    in-out property <int> audio-device-index;
    in property <string> devices-summary;
    // True when the selected input is not currently in the audio graph.
    in property <bool> audio-input-missing;
    callback select-sample-rate(int);
    callback select-channels(int);
    callback select-audio-device(int);
    callback refresh-audio-devices();
    spacing: 14px;

    SettingsGroup {
        title: I18n.text.settings_ui.group_audio_general;
        SettingRow {
            label: I18n.text.settings_ui.sample_rate;
            ComboBox {
                model: root.sample-rate-names;
                current-index: root.sample-rate-index;
                selected(value) => { root.select-sample-rate(self.current-index); }
                horizontal-stretch: 1;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.channels;
            ComboBox {
                model: root.channel-names;
                current-index: root.channel-index;
                selected(value) => { root.select-channels(self.current-index); }
                horizontal-stretch: 1;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.audio_input_device;
            ComboBox {
                model: root.audio-device-names;
                current-index: root.audio-device-index;
                selected(value) => { root.select-audio-device(self.current-index); }
                horizontal-stretch: 1;
            }
            Button {
                text: I18n.text.settings_ui.refresh_devices;
                clicked => { root.refresh-audio-devices(); }
            }
        }
        // Shown only while the choice cannot be honoured, so a working setup
        // is not permanently carrying a warning it does not need.
        if root.audio-input-missing : SettingHint {
            text: I18n.text.settings_ui.audio_input_missing_hint;
        }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_audio_devices;
        SettingHint { text: root.devices-summary; }
        SettingHint { text: I18n.text.settings_ui.audio_devices_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component VideoPage inherits VerticalLayout {
    in property <[string]> resolution-names;
    in property <int> base-resolution-index;
    in property <string> output-resolution;
    in property <[string]> frame-rate-names;
    in property <int> frame-rate-index;
    callback select-base-resolution(int);
    callback select-frame-rate(int);
    spacing: 14px;

    SettingsGroup {
        title: I18n.text.settings_ui.group_resolution;
        SettingRow {
            label: I18n.text.settings_ui.base_resolution;
            ComboBox {
                model: root.resolution-names;
                current-index: root.base-resolution-index;
                selected(value) => { root.select-base-resolution(self.current-index); }
                horizontal-stretch: 1;
            }
        }
        // OBS-RS renders one canvas and encodes it unscaled, so the output
        // resolution is reported rather than chosen.
        SettingRow {
            label: I18n.text.settings_ui.output_resolution;
            Text {
                text: root.output-resolution;
                color: Palette.tokens.text-muted;
                font-size: 12px;
                vertical-alignment: center;
                height: 28px;
                horizontal-stretch: 1;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.frame_rate;
            ComboBox {
                model: root.frame-rate-names;
                current-index: root.frame-rate-index;
                selected(value) => { root.select-frame-rate(self.current-index); }
                horizontal-stretch: 1;
            }
        }
        SettingHint { text: I18n.text.settings_ui.video_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component HotkeysPage inherits VerticalLayout {
    in-out property <string> hotkey-swap;
    in-out property <string> hotkey-start-recording;
    in-out property <string> hotkey-stop-recording;
    in-out property <string> hotkey-start-streaming;
    in-out property <string> hotkey-stop-streaming;
    callback changed();
    spacing: 14px;

    SettingsGroup {
        title: I18n.text.settings_ui.group_hotkeys;
        SettingRow {
            label: I18n.text.settings_ui.hotkey_swap;
            LineEdit {
                text <=> root.hotkey-swap;
                placeholder-text: "Space";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_start_recording;
            LineEdit {
                text <=> root.hotkey-start-recording;
                placeholder-text: "Ctrl+R";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_stop_recording;
            LineEdit {
                text <=> root.hotkey-stop-recording;
                placeholder-text: "Ctrl+Shift+R";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_start_streaming;
            LineEdit {
                text <=> root.hotkey-start-streaming;
                placeholder-text: "Ctrl+B";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_stop_streaming;
            LineEdit {
                text <=> root.hotkey-stop-streaming;
                placeholder-text: "Ctrl+Shift+B";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
        }
        SettingHint { text: I18n.text.settings_ui.hotkeys_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component AccessibilityPage inherits VerticalLayout {
    in-out property <string> preview-border-color;
    in-out property <string> program-border-color;
    in property <brush> preview-swatch;
    in property <brush> program-swatch;
    callback changed();
    spacing: 14px;

    SettingsGroup {
        title: I18n.text.settings_ui.group_colors;
        SettingRow {
            label: I18n.text.settings_ui.preview_border_color;
            LineEdit {
                text <=> root.preview-border-color;
                placeholder-text: "#60A5FA";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
            ColorSwatch { value: root.preview-swatch; }
        }
        SettingRow {
            label: I18n.text.settings_ui.program_border_color;
            LineEdit {
                text <=> root.program-border-color;
                placeholder-text: "#F87171";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
            ColorSwatch { value: root.program-swatch; }
        }
        SettingHint { text: I18n.text.settings_ui.accessibility_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component AdvancedPage inherits VerticalLayout {
    in-out property <string> project-path;
    in-out property <string> diagnostics-path;
    in-out property <bool> restore-project;
    in-out property <bool> save-project-on-exit;
    callback changed();
    spacing: 14px;

    SettingsGroup {
        title: I18n.text.settings_ui.group_project_files;
        SettingRow {
            label: I18n.text.settings_ui.project_file;
            LineEdit {
                text <=> root.project-path;
                placeholder-text: "obs-rs-project.json";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.diagnostics_file;
            LineEdit {
                text <=> root.diagnostics-path;
                placeholder-text: "obs-rs-diagnostics.obsrdg";
                edited => { root.changed(); }
                horizontal-stretch: 1;
            }
        }
        SettingHint { text: I18n.text.settings_ui.advanced_hint; }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_session;
        CheckRow {
            label: I18n.text.settings_ui.restore_project;
            checked <=> root.restore-project;
            toggled(value) => { root.changed(); }
        }
        CheckRow {
            label: I18n.text.settings_ui.save_project_on_exit;
            checked <=> root.save-project-on-exit;
            toggled(value) => { root.changed(); }
        }
        SettingHint { text: I18n.text.settings_ui.session_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}
