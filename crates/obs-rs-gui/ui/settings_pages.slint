import { Button, CheckBox, ComboBox, LineEdit, SpinBox, VerticalBox, HorizontalBox } from "std-widgets.slint";
import {
    AspectRatioLabel,
    BrowsePathRow,
    CheckRow,
    ColorSwatch,
    EditableResolutionCombo,
    SegmentedControl,
    SettingHint,
    SettingRow,
    SettingsCombo,
    SettingsField,
    SettingsGroup,
    SettingsSection,
    SettingsSlider,
    SettingsSpinBox,
    SettingsWarning,
} from "settings_widgets.slint";
import { I18n } from "i18n.slint";
import { Metrics, Palette } from "palette.slint";

// One component per settings category. Each takes only the properties it edits
// and reports changes upward; the window owns the draft state.

export component GeneralPage inherits VerticalLayout {
    in property <[string]> language-names;
    in property <int> language-index;
    in-out property <bool> confirm-start-stream;
    in-out property <bool> confirm-stop-stream;
    in-out property <bool> confirm-stop-recording;
    in-out property <bool> auto-record-when-streaming;
    in-out property <int> snap-distance;
    in-out property <bool> show-safe-areas;
    callback select-language(int);
    callback changed();
    spacing: Metrics.ui.page-spacing;

    SettingsGroup {
        title: I18n.text.settings_ui.group_general;
        SettingRow {
            label: I18n.text.settings_ui.language;
            SettingsCombo {
                model: root.language-names;
                current-index: root.language-index;
                selected(value) => { root.select-language(self.current-index); }
            }
        }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_output_behaviour;
        CheckRow {
            label: I18n.text.settings_ui.confirm_start_stream;
            checked <=> root.confirm-start-stream;
            toggled(value) => { root.changed(); }
        }
        CheckRow {
            label: I18n.text.settings_ui.confirm_stop_stream;
            checked <=> root.confirm-stop-stream;
            toggled(value) => { root.changed(); }
        }
        CheckRow {
            label: I18n.text.settings_ui.confirm_stop_recording;
            checked <=> root.confirm-stop-recording;
            toggled(value) => { root.changed(); }
        }
        CheckRow {
            label: I18n.text.settings_ui.auto_record_when_streaming;
            checked <=> root.auto-record-when-streaming;
            toggled(value) => { root.changed(); }
        }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_canvas;
        SettingRow {
            label: I18n.text.settings_ui.snap_distance;
            SettingsSpinBox {
                value <=> root.snap-distance;
                minimum: 1;
                maximum: 100;
                edited(value) => { root.changed(); }
            }
        }
        SettingHint { text: I18n.text.settings_ui.snap_distance_hint; }
        CheckRow {
            label: I18n.text.settings_ui.show_safe_areas;
            checked <=> root.show-safe-areas;
            toggled(value) => { root.changed(); }
        }
        SettingHint { text: I18n.text.settings_ui.show_safe_areas_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component AppearancePage inherits VerticalLayout {
    in property <[string]> theme-names;
    in property <int> theme-index;
    in property <[string]> style-names;
    in property <int> style-index;
    in property <[string]> density-names;
    in property <int> density-index;
    in property <float> font-size;
    in property <float> font-size-minimum;
    in property <float> font-size-maximum;
    callback select-theme(int);
    callback select-style(int);
    callback select-density(int);
    callback set-font-size(float);
    spacing: Metrics.ui.page-spacing;

    SettingsGroup {
        title: I18n.text.settings_ui.group_theme;
        SettingRow {
            label: I18n.text.settings_ui.theme;
            SettingsCombo {
                model: root.theme-names;
                current-index: root.theme-index;
                selected(value) => { root.select-theme(self.current-index); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.style;
            SettingsCombo {
                model: root.style-names;
                current-index: root.style-index;
                selected(value) => { root.select-style(self.current-index); }
            }
        }
        SettingHint { text: I18n.text.settings_ui.theme_hint; }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_layout;
        SettingRow {
            label: I18n.text.settings_ui.font_size;
            SettingsSlider {
                minimum: root.font-size-minimum;
                maximum: root.font-size-maximum;
                value: root.font-size;
                edited(value) => { root.set-font-size(value); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.density;
            SegmentedControl {
                options: root.density-names;
                current-index: root.density-index;
                selected(index) => { root.select-density(index); }
            }
        }
        SettingHint { text: I18n.text.settings_ui.density_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

// Stream owns the destination only: where the frames go and how the connection
// behaves. Everything about how they are encoded lives on the Output page,
// which is the split OBS uses.
export component StreamPage inherits VerticalLayout {
    in property <[string]> protocol-names;
    in-out property <int> protocol-index;
    in property <bool> show-rtmp;
    in property <bool> show-srt;
    in property <bool> show-whip;
    in property <bool> show-hls;
    in property <bool> show-rist;
    in property <bool> show-reference;
    in property <[string]> rtmp-service-names;
    in-out property <int> rtmp-service-index;
    in property <[string]> rtmp-server-names;
    in-out property <int> rtmp-server-index;
    in-out property <string> rtmp-server;
    in-out property <string> rtmp-stream-key;
    in-out property <bool> reconnect;
    in-out property <int> maximum-retries;
    in-out property <int> network-buffer;
    in property <[string]> srt-mode-names;
    in-out property <int> srt-mode-index;
    in-out property <string> srt-host;
    in-out property <int> srt-port;
    in-out property <int> srt-latency;
    in-out property <string> srt-passphrase;
    in property <[string]> srt-key-length-names;
    in-out property <int> srt-key-length-index;
    in-out property <string> srt-stream-id;
    in-out property <int> srt-timeout;
    in-out property <string> whip-endpoint;
    in-out property <string> whip-bearer-token;
    in-out property <string> hls-directory;
    in-out property <int> hls-segment-duration;
    in-out property <int> hls-playlist-size;
    in-out property <bool> hls-low-latency;
    in-out property <string> rist-host;
    in-out property <int> rist-port;
    in-out property <int> rist-buffer;
    in-out property <string> rist-shared-secret;
    in-out property <string> reference-address;
    callback select-protocol(int);
    callback select-service(int);
    callback select-server(int);
    callback select-srt-mode(int);
    callback select-srt-key-length(int);
    callback changed();
    spacing: Metrics.ui.page-spacing;

    SettingsGroup {
        title: I18n.text.settings_ui.group_service;
        SettingRow {
            label: I18n.text.settings_ui.protocol;
            SettingsCombo {
                model: root.protocol-names;
                current-index: root.protocol-index;
                selected(value) => { root.select-protocol(self.current-index); }
            }
        }
        if root.show-rtmp : SettingRow {
            label: I18n.text.settings_ui.service;
            SettingsCombo {
                model: root.rtmp-service-names;
                current-index: root.rtmp-service-index;
                selected(value) => { root.select-service(self.current-index); }
            }
        }
        if root.show-rtmp && root.rtmp-server-names.length > 1 : SettingRow {
            label: I18n.text.settings_ui.stream_server;
            SettingsCombo {
                model: root.rtmp-server-names;
                current-index: root.rtmp-server-index;
                selected(value) => { root.select-server(self.current-index); }
            }
        }
        if root.show-rtmp : SettingRow {
            label: I18n.text.settings_ui.stream_server;
            SettingsField { text <=> root.rtmp-server; placeholder-text: "ingest.example/live"; edited => { root.changed(); } }
        }
        if root.show-rtmp : SettingRow {
            label: I18n.text.settings_ui.stream_key;
            SettingsField { text <=> root.rtmp-stream-key; input-type: InputType.password; edited => { root.changed(); } }
        }
        if root.show-srt : SettingRow {
            label: I18n.text.settings_ui.srt_mode;
            SettingsCombo { model: root.srt-mode-names; current-index: root.srt-mode-index; selected(value) => { root.select-srt-mode(self.current-index); } }
        }
        if root.show-srt : SettingRow {
            label: I18n.text.settings_ui.address;
            SettingsField { text <=> root.srt-host; edited => { root.changed(); } }
        }
        if root.show-srt : SettingRow {
            label: I18n.text.settings_ui.port;
            SettingsSpinBox { value <=> root.srt-port; minimum: 1; maximum: 65535; edited(value) => { root.changed(); } }
        }
        if root.show-srt : SettingRow {
            label: I18n.text.settings_ui.latency_ms;
            SettingsSpinBox { value <=> root.srt-latency; minimum: 20; maximum: 60000; edited(value) => { root.changed(); } }
        }
        if root.show-srt : SettingRow {
            label: I18n.text.settings_ui.passphrase;
            SettingsField { text <=> root.srt-passphrase; input-type: InputType.password; edited => { root.changed(); } }
        }
        if root.show-srt : SettingRow {
            label: I18n.text.settings_ui.key_length;
            SettingsCombo { model: root.srt-key-length-names; current-index: root.srt-key-length-index; selected(value) => { root.select-srt-key-length(self.current-index); } }
        }
        if root.show-srt : SettingRow {
            label: I18n.text.settings_ui.stream_id;
            SettingsField { text <=> root.srt-stream-id; edited => { root.changed(); } }
        }
        if root.show-srt : SettingRow {
            label: I18n.text.settings_ui.connect_timeout_ms;
            SettingsSpinBox { value <=> root.srt-timeout; minimum: 100; maximum: 120000; edited(value) => { root.changed(); } }
        }
        if root.show-whip : SettingRow {
            label: I18n.text.settings_ui.whip_endpoint;
            SettingsField { text <=> root.whip-endpoint; placeholder-text: "https://service.example/whip"; edited => { root.changed(); } }
        }
        if root.show-whip : SettingRow {
            label: I18n.text.settings_ui.bearer_token;
            SettingsField { text <=> root.whip-bearer-token; input-type: InputType.password; edited => { root.changed(); } }
        }
        if root.show-hls : SettingRow {
            label: I18n.text.settings_ui.output_directory;
            SettingsField { text <=> root.hls-directory; edited => { root.changed(); } }
        }
        if root.show-hls : SettingRow {
            label: I18n.text.settings_ui.segment_duration;
            SettingsSpinBox { value <=> root.hls-segment-duration; minimum: 1; maximum: 60; edited(value) => { root.changed(); } }
        }
        if root.show-hls : SettingRow {
            label: I18n.text.settings_ui.playlist_size;
            SettingsSpinBox { value <=> root.hls-playlist-size; minimum: 3; maximum: 1000; edited(value) => { root.changed(); } }
        }
        if root.show-hls : CheckRow {
            label: I18n.text.settings_ui.low_latency;
            checked <=> root.hls-low-latency;
            toggled(value) => { root.changed(); }
        }
        if root.show-rist : SettingRow {
            label: I18n.text.settings_ui.address;
            SettingsField { text <=> root.rist-host; edited => { root.changed(); } }
        }
        if root.show-rist : SettingRow {
            label: I18n.text.settings_ui.even_rtp_port;
            SettingsSpinBox { value <=> root.rist-port; minimum: 2; maximum: 65534; edited(value) => { root.changed(); } }
        }
        if root.show-rist : SettingRow {
            label: I18n.text.settings_ui.sender_buffer;
            SettingsSpinBox { value <=> root.rist-buffer; minimum: 0; maximum: 60000; edited(value) => { root.changed(); } }
        }
        if root.show-rist : SettingRow {
            label: I18n.text.settings_ui.shared_secret;
            SettingsField { text <=> root.rist-shared-secret; input-type: InputType.password; edited => { root.changed(); } }
        }
        if root.show-reference : SettingRow {
            label: I18n.text.settings_ui.stream_server;
            SettingsField {
                text <=> root.reference-address;
                placeholder-text: "127.0.0.1:9000";
                edited => { root.changed(); }
            }
        }
        SettingHint { text: I18n.text.settings_ui.stream_hint; }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_connection;
        CheckRow {
            label: I18n.text.settings_ui.reconnect;
            checked <=> root.reconnect;
            toggled(value) => { root.changed(); }
        }
        SettingRow {
            label: I18n.text.settings_ui.maximum_retries;
            SettingsSpinBox { value <=> root.maximum-retries; minimum: 0; maximum: 1000; edited(value) => { root.changed(); } }
        }
        SettingRow {
            label: I18n.text.settings_ui.network_buffer;
            SettingsSpinBox { value <=> root.network-buffer; minimum: 0; maximum: 60000; edited(value) => { root.changed(); } }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

// Output owns every encoding decision, in the two presentations OBS offers:
// Simple is bitrate and quality presets, Advanced is the encoder configuration
// the engine actually accepts.
export component OutputPage inherits VerticalLayout {
    in property <[string]> output-mode-names;
    in property <int> output-mode-index;
    in property <bool> simple-mode;
    // Streaming
    in-out property <int> stream-video-bitrate;
    in-out property <int> stream-audio-bitrate;
    in property <[string]> video-encoder-names;
    in property <int> video-encoder-index;
    in property <[string]> audio-encoder-names;
    in property <int> audio-encoder-index;
    in property <[string]> encoder-preset-names;
    in property <int> encoder-preset-index;
    in-out property <bool> custom-encoder-settings;
    in-out property <string> rate-control;
    in-out property <int> keyframe-interval;
    in-out property <string> encoder-profile;
    in-out property <int> b-frames;
    // Recording
    in-out property <string> recording-directory;
    in property <bool> browse-enabled;
    in property <string> browse-hint;
    in-out property <bool> filename-without-spaces;
    in property <[string]> recording-quality-names;
    in property <int> recording-quality-index;
    in property <[string]> recording-format-names;
    in property <int> recording-format-index;
    in property <bool> recording-format-locked;
    in-out property <bool> recording-auto-remux;
    in property <bool> recording-auto-remux-supported;
    in property <[string]> recording-codec-names;
    in property <int> recording-codec-index;
    in property <[string]> recording-audio-encoder-names;
    in property <int> recording-audio-encoder-index;
    in property <string> recording-file-preview;
    in property <bool> software-encoding-warning;
    in-out property <int> replay-buffer-duration;
    in-out property <int> replay-buffer-capacity;
    in-out property <bool> recording-split-enabled;
    in property <bool> recording-split-supported;
    in-out property <int> recording-split-duration-minutes;
    in-out property <int> recording-split-size-mib;
    in-out property <int> recording-split-max-segments;
    callback select-output-mode(int);
    callback select-video-encoder(int);
    callback select-audio-encoder(int);
    callback select-encoder-preset(int);
    callback select-recording-quality(int);
    callback select-recording-format(int);
    callback refresh-recording-page();
    callback select-recording-codec(int);
    callback select-recording-audio-encoder(int);
    callback browse-recording-directory();
    callback changed();
    spacing: Metrics.ui.page-spacing;

    SettingsGroup {
        title: I18n.text.settings_ui.group_output_mode;
        SettingRow {
            label: I18n.text.settings_ui.output_mode;
            SettingsCombo {
                model: root.output-mode-names;
                current-index: root.output-mode-index;
                selected(value) => { root.select-output-mode(self.current-index); }
            }
        }
        SettingHint { text: I18n.text.settings_ui.output_mode_hint; }
    }

    SettingsGroup {
        title: I18n.text.settings_ui.group_streaming;
        SettingRow {
            label: I18n.text.settings_ui.video_bitrate;
            SettingsSpinBox { value <=> root.stream-video-bitrate; minimum: 100; maximum: 100000; edited(value) => { root.changed(); } }
        }
        SettingRow {
            label: I18n.text.settings_ui.audio_bitrate;
            SettingsSpinBox { value <=> root.stream-audio-bitrate; minimum: 32; maximum: 1024; edited(value) => { root.changed(); } }
        }
        SettingRow {
            label: I18n.text.settings_ui.video_encoder;
            SettingsCombo {
                model: root.video-encoder-names;
                current-index: root.video-encoder-index;
                selected(value) => { root.select-video-encoder(self.current-index); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.encoder_preset;
            SettingsCombo {
                model: root.encoder-preset-names;
                current-index: root.encoder-preset-index;
                selected(value) => { root.select-encoder-preset(self.current-index); }
            }
        }
        if root.simple-mode : CheckRow {
            label: I18n.text.settings_ui.custom_encoder_settings;
            checked <=> root.custom-encoder-settings;
            toggled(value) => { root.changed(); }
        }
        SettingRow {
            label: I18n.text.settings_ui.audio_encoder;
            SettingsCombo {
                model: root.audio-encoder-names;
                current-index: root.audio-encoder-index;
                selected(value) => { root.select-audio-encoder(self.current-index); }
            }
        }
        // The detailed encoder controls appear in Advanced mode, and in Simple
        // mode only when the custom-settings box is ticked — which is exactly
        // what that box means in OBS.
        if !root.simple-mode || root.custom-encoder-settings : SettingRow {
            label: I18n.text.settings_ui.rate_control;
            SettingsField { text <=> root.rate-control; edited => { root.changed(); } }
        }
        if !root.simple-mode || root.custom-encoder-settings : SettingRow {
            label: I18n.text.settings_ui.keyframe_interval;
            SettingsSpinBox { value <=> root.keyframe-interval; minimum: 0; maximum: 20; edited(value) => { root.changed(); } }
        }
        if !root.simple-mode || root.custom-encoder-settings : SettingRow {
            label: I18n.text.settings_ui.encoder_profile;
            SettingsField { text <=> root.encoder-profile; edited => { root.changed(); } }
        }
        if !root.simple-mode || root.custom-encoder-settings : SettingRow {
            label: I18n.text.settings_ui.b_frames;
            SettingsSpinBox { value <=> root.b-frames; minimum: 0; maximum: 16; edited(value) => { root.changed(); } }
        }
    }

    SettingsGroup {
        title: I18n.text.settings_ui.group_recording;
        SettingRow {
            label: I18n.text.settings_ui.recording_path;
            BrowsePathRow {
                path <=> root.recording-directory;
                browse-label: I18n.text.settings_ui.browse;
                browse-enabled: root.browse-enabled;
                edited(value) => { root.changed(); }
                browse() => { root.browse-recording-directory(); }
            }
        }
        if !root.browse-enabled : SettingHint { text: root.browse-hint; }
        CheckRow {
            label: I18n.text.settings_ui.filename_without_spaces;
            checked <=> root.filename-without-spaces;
            toggled(value) => { root.changed(); }
        }
        // Composed here rather than in Rust so the sentence follows the
        // catalog the window is currently showing, not the committed locale.
        SettingHint {
            text: I18n.text.settings_ui.recording_saves_as + " " + root.recording-file-preview;
        }
        SettingRow {
            label: I18n.text.settings_ui.recording_quality;
            SettingsCombo {
                model: root.recording-quality-names;
                current-index: root.recording-quality-index;
                selected(value) => { root.select-recording-quality(self.current-index); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.recording_format;
            SettingsCombo {
                model: root.recording-format-names;
                current-index: root.recording-format-index;
                enabled: !root.recording-format-locked;
                selected(value) => { root.select-recording-format(self.current-index); }
            }
        }
        // The lossless preset only exists in the OBS-RS packet container, so
        // the format is shown fixed rather than silently ignored.
        if root.recording-format-locked : SettingHint {
            text: I18n.text.settings_ui.recording_format_locked_hint;
        }
        CheckRow {
            label: I18n.text.settings_ui.recording_auto_remux;
            enabled: root.recording-auto-remux-supported && !root.recording-split-enabled;
            checked <=> root.recording-auto-remux;
            toggled(value) => {
                root.changed();
                root.refresh-recording-page();
            }
        }
        if !root.recording-auto-remux-supported || root.recording-split-enabled : SettingHint {
            text: I18n.text.settings_ui.recording_auto_remux_unavailable;
        }
        if !root.recording-format-locked : SettingRow {
            label: I18n.text.settings_ui.video_encoder;
            SettingsCombo {
                model: root.recording-codec-names;
                current-index: root.recording-codec-index;
                selected(value) => { root.select-recording-codec(self.current-index); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.audio_encoder;
            SettingsCombo {
                model: root.recording-audio-encoder-names;
                current-index: root.recording-audio-encoder-index;
                selected(value) => { root.select-recording-audio-encoder(self.current-index); }
            }
        }
        if root.software-encoding-warning : SettingsWarning {
            text: I18n.text.settings_ui.software_encoding_warning;
        }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.replay_buffer;
        SettingRow {
            label: I18n.text.settings_ui.replay_buffer_duration;
            SettingsSpinBox {
                value <=> root.replay-buffer-duration;
                minimum: 1;
                maximum: 3600;
                edited(value) => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.replay_buffer_capacity;
            SettingsSpinBox {
                value <=> root.replay-buffer-capacity;
                minimum: 1;
                maximum: 256;
                edited(value) => { root.changed(); }
            }
        }
        SettingHint { text: I18n.text.settings_ui.replay_buffer_hint; }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.recording_split;
        CheckRow {
            label: I18n.text.settings_ui.recording_split_enabled;
            enabled: root.recording-split-supported;
            checked <=> root.recording-split-enabled;
            toggled(value) => {
                root.changed();
                root.refresh-recording-page();
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.recording_split_duration;
            SettingsSpinBox {
                value <=> root.recording-split-duration-minutes;
                minimum: 1;
                maximum: 1440;
                enabled: root.recording-split-supported && root.recording-split-enabled;
                edited(value) => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.recording_split_size;
            SettingsSpinBox {
                value <=> root.recording-split-size-mib;
                minimum: 1;
                maximum: 256;
                enabled: root.recording-split-supported && root.recording-split-enabled;
                edited(value) => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.recording_split_segments;
            SettingsSpinBox {
                value <=> root.recording-split-max-segments;
                minimum: 1;
                maximum: 1024;
                enabled: root.recording-split-supported && root.recording-split-enabled;
                edited(value) => { root.changed(); }
            }
        }
        if root.recording-split-supported : SettingHint {
            text: I18n.text.settings_ui.recording_split_hint;
        }
        if !root.recording-split-supported : SettingHint {
            text: I18n.text.settings_ui.recording_split_unavailable;
        }
    }
    Rectangle { vertical-stretch: 1; }
}

export component AudioPage inherits VerticalLayout {
    in property <[string]> sample-rate-names;
    in property <int> sample-rate-index;
    in property <[string]> channel-names;
    in property <int> channel-index;
    in property <[string]> audio-device-names;
    in-out property <int> audio-device-index;
    in property <string> devices-summary;
    // True when the selected input is not currently in the audio graph.
    in property <bool> audio-input-missing;
    callback select-sample-rate(int);
    callback select-channels(int);
    callback select-audio-device(int);
    callback refresh-audio-devices();
    spacing: Metrics.ui.page-spacing;

    SettingsGroup {
        title: I18n.text.settings_ui.group_audio_general;
        SettingRow {
            label: I18n.text.settings_ui.sample_rate;
            SettingsCombo {
                model: root.sample-rate-names;
                current-index: root.sample-rate-index;
                selected(value) => { root.select-sample-rate(self.current-index); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.channels;
            SettingsCombo {
                model: root.channel-names;
                current-index: root.channel-index;
                selected(value) => { root.select-channels(self.current-index); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.audio_input_device;
            SettingsCombo {
                model: root.audio-device-names;
                current-index: root.audio-device-index;
                selected(value) => { root.select-audio-device(self.current-index); }
            }
            Button {
                text: I18n.text.settings_ui.refresh_devices;
                height: Metrics.ui.control-height;
                clicked => { root.refresh-audio-devices(); }
            }
        }
        // Shown only while the choice cannot be honoured, so a working setup
        // is not permanently carrying a warning it does not need.
        if root.audio-input-missing : SettingHint {
            text: I18n.text.settings_ui.audio_input_missing_hint;
        }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_audio_devices;
        SettingHint { text: root.devices-summary; }
        SettingHint { text: I18n.text.settings_ui.audio_devices_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

// Video owns the canvas, the encoded output, and the frame rate as three
// separate values: the output resolution is no longer an alias for the canvas,
// which is what makes the downscale filter meaningful.
export component VideoPage inherits VerticalLayout {
    in property <[string]> resolution-names;
    in-out property <string> base-resolution;
    in-out property <string> output-resolution;
    in property <bool> base-resolution-valid;
    in property <bool> output-resolution-valid;
    in property <int> base-suggestion-index;
    in property <int> output-suggestion-index;
    in property <string> base-aspect-ratio;
    in property <string> output-aspect-ratio;
    in property <[string]> scale-filter-names;
    in property <int> scale-filter-index;
    in property <[string]> fps-mode-names;
    in property <int> fps-mode-index;
    in property <bool> fps-common;
    in property <bool> fps-integer;
    in property <bool> fps-fractional;
    in property <[string]> frame-rate-names;
    in property <int> frame-rate-index;
    in-out property <int> fps-numerator;
    in-out property <int> fps-denominator;
    in property <bool> downscale-active;
    callback edit-base-resolution(string);
    callback edit-output-resolution(string);
    callback select-scale-filter(int);
    callback select-fps-mode(int);
    callback select-frame-rate(int);
    callback changed();
    spacing: Metrics.ui.page-spacing;

    SettingsGroup {
        title: I18n.text.settings_ui.group_resolution;
        SettingRow {
            label: I18n.text.settings_ui.base_resolution;
            EditableResolutionCombo {
                suggestions: root.resolution-names;
                value <=> root.base-resolution;
                valid: root.base-resolution-valid;
                suggestion-index: root.base-suggestion-index;
                edited(value) => { root.edit-base-resolution(value); }
                selected(value) => { root.edit-base-resolution(value); }
            }
            AspectRatioLabel {
                caption: I18n.text.settings_ui.aspect_ratio;
                ratio: root.base-aspect-ratio;
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.output_resolution;
            EditableResolutionCombo {
                suggestions: root.resolution-names;
                value <=> root.output-resolution;
                valid: root.output-resolution-valid;
                suggestion-index: root.output-suggestion-index;
                edited(value) => { root.edit-output-resolution(value); }
                selected(value) => { root.edit-output-resolution(value); }
            }
            AspectRatioLabel {
                caption: I18n.text.settings_ui.aspect_ratio;
                ratio: root.output-aspect-ratio;
            }
        }
        if !root.base-resolution-valid || !root.output-resolution-valid : SettingsWarning {
            text: I18n.text.settings_ui.resolution_invalid;
        }
        SettingRow {
            label: I18n.text.settings_ui.downscale_filter;
            SettingsCombo {
                model: root.scale-filter-names;
                current-index: root.scale-filter-index;
                // The filter only does anything when the two resolutions
                // differ, so it says so rather than pretending otherwise.
                enabled: root.downscale-active;
                selected(value) => { root.select-scale-filter(self.current-index); }
            }
        }
        if !root.downscale-active : SettingHint {
            text: I18n.text.settings_ui.downscale_inactive_hint;
        }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_frame_rate;
        SettingRow {
            label: I18n.text.settings_ui.fps_type;
            SettingsCombo {
                model: root.fps-mode-names;
                current-index: root.fps-mode-index;
                selected(value) => { root.select-fps-mode(self.current-index); }
            }
        }
        if root.fps-common : SettingRow {
            label: I18n.text.settings_ui.frame_rate;
            SettingsCombo {
                model: root.frame-rate-names;
                current-index: root.frame-rate-index;
                selected(value) => { root.select-frame-rate(self.current-index); }
            }
        }
        if root.fps-integer : SettingRow {
            label: I18n.text.settings_ui.integer_fps;
            SettingsSpinBox {
                value <=> root.fps-numerator;
                minimum: 1;
                maximum: 240;
                edited(value) => { root.changed(); }
            }
        }
        if root.fps-fractional : SettingRow {
            label: I18n.text.settings_ui.fps_numerator;
            SettingsSpinBox {
                value <=> root.fps-numerator;
                minimum: 1;
                maximum: 1000000;
                edited(value) => { root.changed(); }
            }
        }
        if root.fps-fractional : SettingRow {
            label: I18n.text.settings_ui.fps_denominator;
            SettingsSpinBox {
                value <=> root.fps-denominator;
                minimum: 1;
                maximum: 100000;
                edited(value) => { root.changed(); }
            }
        }
        SettingHint { text: I18n.text.settings_ui.video_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component HotkeysPage inherits VerticalLayout {
    in-out property <string> hotkey-swap;
    in-out property <string> hotkey-start-recording;
    in-out property <string> hotkey-stop-recording;
    in-out property <string> hotkey-start-streaming;
    in-out property <string> hotkey-stop-streaming;
    in-out property <string> hotkey-undo;
    in-out property <string> hotkey-redo;
    in-out property <string> hotkey-save-project;
    in-out property <string> hotkey-fade-transition;
    in-out property <string> hotkey-save-replay;
    in-out property <string> hotkey-start-replay;
    in-out property <string> hotkey-stop-replay;
    in property <string> conflict-warning;
    callback changed();
    spacing: Metrics.ui.page-spacing;

    SettingsGroup {
        title: I18n.text.settings_ui.group_hotkeys;
        SettingRow {
            label: I18n.text.settings_ui.hotkey_swap;
            SettingsField {
                text <=> root.hotkey-swap;
                placeholder-text: "Space";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_start_recording;
            SettingsField {
                text <=> root.hotkey-start-recording;
                placeholder-text: "Ctrl+R";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_stop_recording;
            SettingsField {
                text <=> root.hotkey-stop-recording;
                placeholder-text: "Ctrl+Shift+R";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_start_streaming;
            SettingsField {
                text <=> root.hotkey-start-streaming;
                placeholder-text: "Ctrl+B";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_stop_streaming;
            SettingsField {
                text <=> root.hotkey-stop-streaming;
                placeholder-text: "Ctrl+Shift+B";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_undo;
            SettingsField {
                text <=> root.hotkey-undo;
                placeholder-text: "Ctrl+Z";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_redo;
            SettingsField {
                text <=> root.hotkey-redo;
                placeholder-text: "Ctrl+Y";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_save_project;
            SettingsField {
                text <=> root.hotkey-save-project;
                placeholder-text: "Ctrl+S";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_fade_transition;
            SettingsField {
                text <=> root.hotkey-fade-transition;
                placeholder-text: "Ctrl+Shift+F";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_save_replay;
            SettingsField {
                text <=> root.hotkey-save-replay;
                placeholder-text: "F8";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_start_replay;
            SettingsField {
                text <=> root.hotkey-start-replay;
                placeholder-text: "Ctrl+Shift+F8";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.hotkey_stop_replay;
            SettingsField {
                text <=> root.hotkey-stop-replay;
                placeholder-text: "Ctrl+Alt+F8";
                edited => { root.changed(); }
            }
        }
        if root.conflict-warning != "" : SettingsWarning {
            text: I18n.text.settings_ui.hotkeys_conflict + ": " + root.conflict-warning;
        }
        SettingHint { text: I18n.text.settings_ui.hotkeys_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component AccessibilityPage inherits VerticalLayout {
    in-out property <string> preview-border-color;
    in-out property <string> program-border-color;
    in property <brush> preview-swatch;
    in property <brush> program-swatch;
    callback changed();
    spacing: Metrics.ui.page-spacing;

    SettingsGroup {
        title: I18n.text.settings_ui.group_colors;
        SettingRow {
            label: I18n.text.settings_ui.preview_border_color;
            SettingsField {
                text <=> root.preview-border-color;
                placeholder-text: "#60A5FA";
                edited => { root.changed(); }
            }
            ColorSwatch { value: root.preview-swatch; }
        }
        SettingRow {
            label: I18n.text.settings_ui.program_border_color;
            SettingsField {
                text <=> root.program-border-color;
                placeholder-text: "#F87171";
                edited => { root.changed(); }
            }
            ColorSwatch { value: root.program-swatch; }
        }
        SettingHint { text: I18n.text.settings_ui.accessibility_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}

export component AdvancedPage inherits VerticalLayout {
    in-out property <string> project-path;
    in-out property <string> diagnostics-path;
    in-out property <bool> restore-project;
    in-out property <bool> save-project-on-exit;
    callback changed();
    spacing: Metrics.ui.page-spacing;

    SettingsGroup {
        title: I18n.text.settings_ui.group_project_files;
        SettingRow {
            label: I18n.text.settings_ui.project_file;
            SettingsField {
                text <=> root.project-path;
                placeholder-text: "obs-rs-project.json";
                edited => { root.changed(); }
            }
        }
        SettingRow {
            label: I18n.text.settings_ui.diagnostics_file;
            SettingsField {
                text <=> root.diagnostics-path;
                placeholder-text: "obs-rs-diagnostics.obsrdg";
                edited => { root.changed(); }
            }
        }
        SettingHint { text: I18n.text.settings_ui.advanced_hint; }
    }
    SettingsGroup {
        title: I18n.text.settings_ui.group_session;
        CheckRow {
            label: I18n.text.settings_ui.restore_project;
            checked <=> root.restore-project;
            toggled(value) => { root.changed(); }
        }
        CheckRow {
            label: I18n.text.settings_ui.save_project_on_exit;
            checked <=> root.save-project-on-exit;
            toggled(value) => { root.changed(); }
        }
        SettingHint { text: I18n.text.settings_ui.session_hint; }
    }
    Rectangle { vertical-stretch: 1; }
}
