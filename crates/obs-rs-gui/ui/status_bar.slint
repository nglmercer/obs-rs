import { HorizontalBox } from "std-widgets.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

export component StatusBar inherits Rectangle {
    in property <string> locale;
    in property <bool> recording;
    in property <bool> streaming;
    in property <string> output-status;
    in property <string> output-metrics;
    in property <int> view-mode;
    height: 24px;
    background: Palette.tokens.panel-bg;
    border-width: 1px;
    border-color: Palette.tokens.border;

    HorizontalBox {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: streaming
                ? I18n.text.streaming_status
                : I18n.text.stream_stopped;
            color: streaming ? Palette.tokens.program-border : Palette.tokens.text-muted;
            font-size: 10px;
            vertical-alignment: center;
        }
        Text {
            text: recording
                ? I18n.text.recording_status
                : I18n.text.recording_stopped;
            color: recording ? Palette.tokens.program-border : Palette.tokens.text-muted;
            font-size: 10px;
            vertical-alignment: center;
        }
        Text {
            text: "00:00:00";
            color: Palette.tokens.text-muted;
            font-size: 10px;
            vertical-alignment: center;
        }
        Text {
            text: "CPU: --   60.00 / 60.00 FPS";
            color: Palette.tokens.text-muted;
            font-size: 10px;
            vertical-alignment: center;
        }
        Text {
            text: output-status;
            color: Palette.tokens.warning;
            font-size: 10px;
            vertical-alignment: center;
            max-width: 260px;
            overflow: elide;
        }
    }
}
