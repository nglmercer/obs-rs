import { ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { CompactButton, DockHeader } from "theme.slint";
import { SourceRow } from "models.slint";

export component SourceDock inherits Rectangle {
    in property <string> locale;
    in property <string> source-scene;
    in property <[SourceRow]> source-rows;
    in property <int> panel-kind;
    callback move-panel(int, int);
    callback select-source(string);
    callback toggle-source-visibility(string);
    callback toggle-source-locked(string);
    callback move-source(string, int);
    callback remove-source(string);

    background: rgb(31, 34, 41);
    border-width: 1px;
    border-color: rgb(55, 60, 69);
    VerticalBox {
        DockHeader {
            title: (locale == "es" ? "Fuentes · " : "Sources · ") + source-scene;
            panel-kind: root.panel-kind;
            move-panel(kind, delta) => { root.move-panel(kind, delta); }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalBox {
                padding: 8px;
                spacing: 6px;
                ScrollView {
                    vertical-stretch: 1;
                    for source in source-rows : Rectangle {
                        height: 36px;
                        background: source.selected ? rgb(51, 73, 105) : rgb(39, 43, 50);
                        border-width: 1px;
                        border-color: rgb(55, 60, 69);
                        TouchArea {
                            clicked => select-source(source.id);
                        }
                        HorizontalBox {
                            padding-left: 7px;
                            padding-right: 4px;
                            spacing: 5px;
                            VerticalBox {
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text {
                                    text: source.name;
                                    color: rgb(226, 232, 240);
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            CompactButton {
                                label: source.visible ? "◉" : "○";
                                hint: source.visible
                                    ? (locale == "es" ? "Ocultar fuente" : "Hide source")
                                    : (locale == "es" ? "Mostrar fuente" : "Show source");
                                clicked => toggle-source-visibility(source.id);
                            }
                            CompactButton {
                                label: source.locked ? "▣" : "□";
                                hint: source.locked
                                    ? (locale == "es" ? "Desbloquear fuente" : "Unlock source")
                                    : (locale == "es" ? "Bloquear fuente" : "Lock source");
                                clicked => toggle-source-locked(source.id);
                            }
                        }
                    }
                }
                HorizontalBox {
                    spacing: 4px;
                    CompactButton { width: 22px; label: "+"; hint: locale == "es" ? "Añadir fuente" : "Add source"; }
                    CompactButton { width: 22px; label: "▥"; hint: locale == "es" ? "Eliminar fuente seleccionada" : "Remove selected source"; }
                    CompactButton { width: 22px; label: "⚙"; hint: locale == "es" ? "Propiedades de fuente" : "Source properties"; }
                    CompactButton { width: 22px; label: "↑"; hint: locale == "es" ? "Subir fuente" : "Move source up"; }
                    CompactButton { width: 22px; label: "↓"; hint: locale == "es" ? "Bajar fuente" : "Move source down"; }
                    Rectangle { horizontal-stretch: 1; }
                    CompactButton { width: 22px; label: "⋮"; hint: locale == "es" ? "Más opciones" : "More options"; }
                }
            }
        }
    }
}
