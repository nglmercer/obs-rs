import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { MutedText, PanelHeading, StudioPanel } from "theme.slint";
import { I18n } from "i18n.slint";

export component ProjectPanel inherits Rectangle {
    in property <string> locale;
    in property <string> project-path;
    in property <string> diagnostics-path;
    in property <string> recovery-status;
    callback open-project-dialog();
    callback save-project();
    callback load-project();
    callback recover-project();
    callback export-diagnostics();

    background: transparent;
    VerticalBox {
        spacing: 10px;
        PanelHeading {
            text: I18n.text.project_title;
        }
        MutedText {
            text: I18n.text.project_description;
        }
        StudioPanel {
            height: 86px;
            VerticalBox {
                padding: 12px;
                spacing: 7px;
                Text {
                    text: I18n.text.file_prefix + project-path;
                    color: rgb(226, 232, 240);
                    font-size: 12px;
                    overflow: elide;
                }
                HorizontalBox {
                    spacing: 6px;
                    Button {
                        text: I18n.text.configure;
                        clicked => open-project-dialog();
                    }
                    Button {
                        text: I18n.text.menu_save;
                        clicked => save-project();
                    }
                    Button {
                        text: I18n.text.load;
                        clicked => load-project();
                    }
                }
            }
        }
        StudioPanel {
            height: 88px;
            VerticalBox {
                padding: 12px;
                spacing: 7px;
                Text {
                    text: I18n.text.recovery_title;
                    color: rgb(226, 232, 240);
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: recovery-status;
                    color: rgb(251, 191, 36);
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalBox {
                    spacing: 6px;
                    Button {
                        text: I18n.text.recover;
                        clicked => recover-project();
                    }
                    Button {
                        text: I18n.text.tabs_diagnostics;
                        clicked => export-diagnostics();
                    }
                }
            }
        }
        MutedText {
            text: I18n.text.diagnostics_prefix + diagnostics-path;
            overflow: elide;
        }
        Rectangle { vertical-stretch: 1; }
    }
}
