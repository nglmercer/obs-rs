import { Button, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { CategoryRow, SettingsFooter } from "settings_widgets.slint";
import {
    AccessibilityPage,
    AdvancedPage,
    AppearancePage,
    AudioPage,
    GeneralPage,
    HotkeysPage,
    OutputPage,
    StreamPage,
    VideoPage,
} from "settings_pages.slint";
import { I18n } from "i18n.slint";
import { Metrics, Palette } from "palette.slint";

// A real top-level window, not a modal inside the main one, so it can be moved,
// resized, and left open beside the studio the way the OBS settings window is.
//
// The shell is three fixed regions: a category list of a fixed width, a page
// area that scrolls, and a button strip pinned to the bottom. The strip lives
// outside the scroll area on purpose — letting page height push the buttons
// around was the largest visual difference from the reference.
//
// Every editable value here is *draft* state: the window mutates its own copy
// and only pushes it to the application on Apply or OK, which is what makes
// Cancel meaningful.
export component SettingsWindow inherits Window {
    title: I18n.text.settings_ui.window_title;
    // The reference window is about 1000x740 at the default density; the
    // minimum is the smallest size the widest page still lays out at.
    preferred-width: 1000px;
    preferred-height: 740px;
    min-width: 820px;
    min-height: 560px;
    background: Palette.tokens.window-bg;

    in-out property <int> category: 0;
    in-out property <bool> dirty: false;

    // General
    in property <[string]> language-names;
    in-out property <int> language-index;
    in-out property <bool> confirm-start-stream;
    in-out property <bool> confirm-stop-stream;
    in-out property <bool> confirm-stop-recording;
    in-out property <bool> auto-record-when-streaming;
    in-out property <int> snap-distance;
    in-out property <bool> show-safe-areas;
    // Appearance
    in property <[string]> theme-names;
    in-out property <int> theme-index;
    in property <[string]> style-names;
    in-out property <int> style-index;
    in property <[string]> density-names;
    in-out property <int> density-index;
    in-out property <float> font-size;
    in property <float> font-size-minimum;
    in property <float> font-size-maximum;
    // Stream
    in property <[string]> protocol-names;
    in-out property <int> protocol-index;
    in property <bool> stream-show-rtmp;
    in property <bool> stream-show-srt;
    in property <bool> stream-show-whip;
    in property <bool> stream-show-hls;
    in property <bool> stream-show-rist;
    in property <bool> stream-show-reference;
    in-out property <string> rtmp-service;
    in-out property <string> rtmp-server;
    in-out property <string> rtmp-stream-key;
    in-out property <bool> stream-reconnect;
    in-out property <int> stream-maximum-retries;
    in-out property <int> stream-network-buffer;
    in property <[string]> srt-mode-names;
    in-out property <int> srt-mode-index;
    in-out property <string> srt-host;
    in-out property <int> srt-port;
    in-out property <int> srt-latency;
    in-out property <string> srt-passphrase;
    in property <[string]> srt-key-length-names;
    in-out property <int> srt-key-length-index;
    in-out property <string> srt-stream-id;
    in-out property <int> srt-timeout;
    in-out property <string> whip-endpoint;
    in-out property <string> whip-bearer-token;
    in-out property <string> hls-directory;
    in-out property <int> hls-segment-duration;
    in-out property <int> hls-playlist-size;
    in-out property <bool> hls-low-latency;
    in-out property <string> rist-host;
    in-out property <int> rist-port;
    in-out property <int> rist-buffer;
    in-out property <string> rist-shared-secret;
    in-out property <string> reference-address;
    // Output
    in property <[string]> output-mode-names;
    in-out property <int> output-mode-index;
    in property <bool> output-simple-mode: true;
    in-out property <int> stream-video-bitrate;
    in-out property <int> stream-audio-bitrate;
    in property <[string]> video-encoder-names;
    in-out property <int> video-encoder-index;
    in property <[string]> audio-encoder-names;
    in-out property <int> audio-encoder-index;
    in property <[string]> encoder-preset-names;
    in-out property <int> encoder-preset-index;
    in-out property <bool> custom-encoder-settings;
    in-out property <string> stream-rate-control;
    in-out property <int> stream-keyframe-interval;
    in-out property <string> stream-encoder-profile;
    in-out property <int> stream-b-frames;
    in-out property <string> recording-directory;
    in property <bool> browse-enabled;
    in property <string> browse-hint;
    in-out property <bool> recording-filename-without-spaces;
    in property <[string]> recording-quality-names;
    in-out property <int> recording-quality-index;
    in property <[string]> recording-format-names;
    in-out property <int> recording-format-index;
    in property <bool> recording-format-locked;
    in property <[string]> recording-codec-names;
    in-out property <int> recording-codec-index;
    in property <[string]> recording-audio-encoder-names;
    in-out property <int> recording-audio-encoder-index;
    in property <string> recording-file-preview;
    in property <bool> software-encoding-warning;
    // Audio
    in property <[string]> sample-rate-names;
    in-out property <int> sample-rate-index;
    in property <[string]> channel-names;
    in-out property <int> channel-index;
    in property <[string]> audio-device-names;
    in-out property <int> audio-device-index;
    in property <string> devices-summary;
    in property <bool> audio-input-missing;
    callback refresh-audio-devices();
    // Video
    in property <[string]> resolution-names;
    in-out property <string> base-resolution;
    in-out property <string> output-resolution;
    in property <bool> base-resolution-valid: true;
    in property <bool> output-resolution-valid: true;
    in property <int> base-suggestion-index;
    in property <int> output-suggestion-index;
    in property <string> base-aspect-ratio;
    in property <string> output-aspect-ratio;
    in property <[string]> scale-filter-names;
    in-out property <int> scale-filter-index;
    in property <[string]> fps-mode-names;
    in-out property <int> fps-mode-index;
    in property <bool> fps-common: true;
    in property <bool> fps-integer;
    in property <bool> fps-fractional;
    in property <[string]> frame-rate-names;
    in-out property <int> frame-rate-index;
    in-out property <int> fps-numerator: 60;
    in-out property <int> fps-denominator: 1;
    in property <bool> downscale-active;
    // Hotkeys
    in-out property <string> hotkey-swap;
    in-out property <string> hotkey-start-recording;
    in-out property <string> hotkey-stop-recording;
    in-out property <string> hotkey-start-streaming;
    in-out property <string> hotkey-stop-streaming;
    in-out property <string> hotkey-undo;
    in-out property <string> hotkey-redo;
    in-out property <string> hotkeys-conflict;
    // Accessibility
    in-out property <string> preview-border-color;
    in-out property <string> program-border-color;
    in property <brush> preview-swatch;
    in property <brush> program-swatch;
    // Advanced
    in-out property <string> project-path;
    in-out property <string> diagnostics-path;
    in-out property <bool> restore-project;
    in-out property <bool> save-project-on-exit;

    callback apply-settings();
    callback accept-settings();
    callback cancel-settings();
    // Appearance and language preview live immediately so the choice is visible
    // before the user commits it.
    callback preview-theme(int);
    callback preview-style(int);
    callback preview-font-size(float);
    callback preview-density(int);
    callback preview-language(int);
    callback select-stream-protocol(int);
    callback select-output-mode(int);
    callback select-recording-quality(int);
    callback edit-base-resolution(string);
    callback edit-output-resolution(string);
    callback select-fps-mode(int);
    callback select-frame-rate(int);
    callback browse-recording-directory();

    HorizontalLayout {
        padding: Metrics.ui.content-margin;
        spacing: Metrics.ui.content-margin;

        // The category list is a plain column on the window background: the
        // reference has no framed panel around it.
        Rectangle {
            width: Metrics.ui.sidebar-width;
            background: Palette.tokens.panel-bg;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                alignment: start;
                CategoryRow {
                    label: I18n.text.settings_ui.cat_general;
                    icon-name: "settings";
                    active: root.category == 0;
                    clicked => { root.category = 0; }
                }
                CategoryRow {
                    label: I18n.text.settings_ui.cat_appearance;
                    icon-name: "appearance";
                    active: root.category == 1;
                    clicked => { root.category = 1; }
                }
                CategoryRow {
                    label: I18n.text.settings_ui.cat_stream;
                    icon-name: "stream";
                    active: root.category == 2;
                    clicked => { root.category = 2; }
                }
                CategoryRow {
                    label: I18n.text.settings_ui.cat_output;
                    icon-name: "output";
                    active: root.category == 3;
                    clicked => { root.category = 3; }
                }
                CategoryRow {
                    label: I18n.text.settings_ui.cat_audio;
                    icon-name: "audio";
                    active: root.category == 4;
                    clicked => { root.category = 4; }
                }
                CategoryRow {
                    label: I18n.text.settings_ui.cat_video;
                    icon-name: "video";
                    active: root.category == 5;
                    clicked => { root.category = 5; }
                }
                CategoryRow {
                    label: I18n.text.settings_ui.cat_hotkeys;
                    icon-name: "hotkeys";
                    active: root.category == 6;
                    clicked => { root.category = 6; }
                }
                CategoryRow {
                    label: I18n.text.settings_ui.cat_accessibility;
                    icon-name: "accessibility";
                    active: root.category == 7;
                    clicked => { root.category = 7; }
                }
                CategoryRow {
                    label: I18n.text.settings_ui.cat_advanced;
                    icon-name: "advanced";
                    active: root.category == 8;
                    clicked => { root.category = 8; }
                }
            }
        }

        VerticalLayout {
            spacing: Metrics.ui.content-margin;
            horizontal-stretch: 1;

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-right: 12px;
                    alignment: start;
                    if root.category == 0 : GeneralPage {
                        language-names: root.language-names;
                        language-index: root.language-index;
                        confirm-start-stream <=> root.confirm-start-stream;
                        confirm-stop-stream <=> root.confirm-stop-stream;
                        confirm-stop-recording <=> root.confirm-stop-recording;
                        auto-record-when-streaming <=> root.auto-record-when-streaming;
                        snap-distance <=> root.snap-distance;
                        show-safe-areas <=> root.show-safe-areas;
                        select-language(index) => {
                            root.language-index = index;
                            root.dirty = true;
                            root.preview-language(index);
                        }
                        changed => { root.dirty = true; }
                    }
                    if root.category == 1 : AppearancePage {
                        theme-names: root.theme-names;
                        theme-index: root.theme-index;
                        style-names: root.style-names;
                        style-index: root.style-index;
                        density-names: root.density-names;
                        density-index: root.density-index;
                        font-size: root.font-size;
                        font-size-minimum: root.font-size-minimum;
                        font-size-maximum: root.font-size-maximum;
                        select-theme(index) => {
                            root.theme-index = index;
                            root.dirty = true;
                            root.preview-theme(index);
                        }
                        select-style(index) => {
                            root.style-index = index;
                            root.dirty = true;
                            root.preview-style(index);
                        }
                        select-density(index) => {
                            root.density-index = index;
                            root.dirty = true;
                            root.preview-density(index);
                        }
                        set-font-size(value) => {
                            root.font-size = value;
                            root.dirty = true;
                            root.preview-font-size(value);
                        }
                    }
                    if root.category == 2 : StreamPage {
                        protocol-names: root.protocol-names;
                        protocol-index: root.protocol-index;
                        show-rtmp: root.stream-show-rtmp;
                        show-srt: root.stream-show-srt;
                        show-whip: root.stream-show-whip;
                        show-hls: root.stream-show-hls;
                        show-rist: root.stream-show-rist;
                        show-reference: root.stream-show-reference;
                        rtmp-service <=> root.rtmp-service;
                        rtmp-server <=> root.rtmp-server;
                        rtmp-stream-key <=> root.rtmp-stream-key;
                        reconnect <=> root.stream-reconnect;
                        maximum-retries <=> root.stream-maximum-retries;
                        network-buffer <=> root.stream-network-buffer;
                        srt-mode-names: root.srt-mode-names;
                        srt-mode-index: root.srt-mode-index;
                        srt-host <=> root.srt-host;
                        srt-port <=> root.srt-port;
                        srt-latency <=> root.srt-latency;
                        srt-passphrase <=> root.srt-passphrase;
                        srt-key-length-names: root.srt-key-length-names;
                        srt-key-length-index: root.srt-key-length-index;
                        srt-stream-id <=> root.srt-stream-id;
                        srt-timeout <=> root.srt-timeout;
                        whip-endpoint <=> root.whip-endpoint;
                        whip-bearer-token <=> root.whip-bearer-token;
                        hls-directory <=> root.hls-directory;
                        hls-segment-duration <=> root.hls-segment-duration;
                        hls-playlist-size <=> root.hls-playlist-size;
                        hls-low-latency <=> root.hls-low-latency;
                        rist-host <=> root.rist-host;
                        rist-port <=> root.rist-port;
                        rist-buffer <=> root.rist-buffer;
                        rist-shared-secret <=> root.rist-shared-secret;
                        reference-address <=> root.reference-address;
                        select-protocol(index) => {
                            root.protocol-index = index;
                            root.dirty = true;
                            root.select-stream-protocol(index);
                        }
                        select-srt-mode(index) => {
                            root.srt-mode-index = index;
                            root.dirty = true;
                        }
                        select-srt-key-length(index) => {
                            root.srt-key-length-index = index;
                            root.dirty = true;
                        }
                        changed => { root.dirty = true; }
                    }
                    if root.category == 3 : OutputPage {
                        output-mode-names: root.output-mode-names;
                        output-mode-index: root.output-mode-index;
                        simple-mode: root.output-simple-mode;
                        stream-video-bitrate <=> root.stream-video-bitrate;
                        stream-audio-bitrate <=> root.stream-audio-bitrate;
                        video-encoder-names: root.video-encoder-names;
                        video-encoder-index: root.video-encoder-index;
                        audio-encoder-names: root.audio-encoder-names;
                        audio-encoder-index: root.audio-encoder-index;
                        encoder-preset-names: root.encoder-preset-names;
                        encoder-preset-index: root.encoder-preset-index;
                        custom-encoder-settings <=> root.custom-encoder-settings;
                        rate-control <=> root.stream-rate-control;
                        keyframe-interval <=> root.stream-keyframe-interval;
                        encoder-profile <=> root.stream-encoder-profile;
                        b-frames <=> root.stream-b-frames;
                        recording-directory <=> root.recording-directory;
                        browse-enabled: root.browse-enabled;
                        browse-hint: root.browse-hint;
                        filename-without-spaces <=> root.recording-filename-without-spaces;
                        recording-quality-names: root.recording-quality-names;
                        recording-quality-index: root.recording-quality-index;
                        recording-format-names: root.recording-format-names;
                        recording-format-index: root.recording-format-index;
                        recording-format-locked: root.recording-format-locked;
                        recording-codec-names: root.recording-codec-names;
                        recording-codec-index: root.recording-codec-index;
                        recording-audio-encoder-names: root.recording-audio-encoder-names;
                        recording-audio-encoder-index: root.recording-audio-encoder-index;
                        recording-file-preview: root.recording-file-preview;
                        software-encoding-warning: root.software-encoding-warning;
                        select-output-mode(index) => {
                            root.output-mode-index = index;
                            root.dirty = true;
                            root.select-output-mode(index);
                        }
                        select-video-encoder(index) => {
                            root.video-encoder-index = index;
                            root.dirty = true;
                        }
                        select-audio-encoder(index) => {
                            root.audio-encoder-index = index;
                            root.dirty = true;
                        }
                        select-encoder-preset(index) => {
                            root.encoder-preset-index = index;
                            root.dirty = true;
                        }
                        select-recording-quality(index) => {
                            root.recording-quality-index = index;
                            root.dirty = true;
                            root.select-recording-quality(index);
                        }
                        select-recording-format(index) => {
                            root.recording-format-index = index;
                            root.dirty = true;
                        }
                        select-recording-codec(index) => {
                            root.recording-codec-index = index;
                            root.dirty = true;
                        }
                        select-recording-audio-encoder(index) => {
                            root.recording-audio-encoder-index = index;
                            root.dirty = true;
                        }
                        browse-recording-directory() => { root.browse-recording-directory(); }
                        changed => { root.dirty = true; }
                    }
                    if root.category == 4 : AudioPage {
                        sample-rate-names: root.sample-rate-names;
                        sample-rate-index: root.sample-rate-index;
                        channel-names: root.channel-names;
                        channel-index: root.channel-index;
                        audio-device-names: root.audio-device-names;
                        audio-device-index: root.audio-device-index;
                        devices-summary: root.devices-summary;
                        audio-input-missing: root.audio-input-missing;
                        refresh-audio-devices() => { root.refresh-audio-devices(); }
                        select-sample-rate(index) => {
                            root.sample-rate-index = index;
                            root.dirty = true;
                        }
                        select-channels(index) => {
                            root.channel-index = index;
                            root.dirty = true;
                        }
                        select-audio-device(index) => {
                            root.audio-device-index = index;
                            root.dirty = true;
                        }
                    }
                    if root.category == 5 : VideoPage {
                        resolution-names: root.resolution-names;
                        base-resolution <=> root.base-resolution;
                        output-resolution <=> root.output-resolution;
                        base-resolution-valid: root.base-resolution-valid;
                        output-resolution-valid: root.output-resolution-valid;
                        base-suggestion-index: root.base-suggestion-index;
                        output-suggestion-index: root.output-suggestion-index;
                        base-aspect-ratio: root.base-aspect-ratio;
                        output-aspect-ratio: root.output-aspect-ratio;
                        scale-filter-names: root.scale-filter-names;
                        scale-filter-index: root.scale-filter-index;
                        fps-mode-names: root.fps-mode-names;
                        fps-mode-index: root.fps-mode-index;
                        fps-common: root.fps-common;
                        fps-integer: root.fps-integer;
                        fps-fractional: root.fps-fractional;
                        frame-rate-names: root.frame-rate-names;
                        frame-rate-index: root.frame-rate-index;
                        fps-numerator <=> root.fps-numerator;
                        fps-denominator <=> root.fps-denominator;
                        downscale-active: root.downscale-active;
                        edit-base-resolution(value) => {
                            root.dirty = true;
                            root.edit-base-resolution(value);
                        }
                        edit-output-resolution(value) => {
                            root.dirty = true;
                            root.edit-output-resolution(value);
                        }
                        select-scale-filter(index) => {
                            root.scale-filter-index = index;
                            root.dirty = true;
                        }
                        select-fps-mode(index) => {
                            root.fps-mode-index = index;
                            root.dirty = true;
                            root.select-fps-mode(index);
                        }
                        select-frame-rate(index) => {
                            root.frame-rate-index = index;
                            root.dirty = true;
                            root.select-frame-rate(index);
                        }
                        changed => { root.dirty = true; }
                    }
                    if root.category == 6 : HotkeysPage {
                        hotkey-swap <=> root.hotkey-swap;
                        hotkey-start-recording <=> root.hotkey-start-recording;
                        hotkey-stop-recording <=> root.hotkey-stop-recording;
                        hotkey-start-streaming <=> root.hotkey-start-streaming;
                        hotkey-stop-streaming <=> root.hotkey-stop-streaming;
                        hotkey-undo <=> root.hotkey-undo;
                        hotkey-redo <=> root.hotkey-redo;
                        conflict-warning: root.hotkeys-conflict;
                        changed => { root.dirty = true; }
                    }
                    if root.category == 7 : AccessibilityPage {
                        preview-border-color <=> root.preview-border-color;
                        program-border-color <=> root.program-border-color;
                        preview-swatch: root.preview-swatch;
                        program-swatch: root.program-swatch;
                        changed => { root.dirty = true; }
                    }
                    if root.category == 8 : AdvancedPage {
                        project-path <=> root.project-path;
                        diagnostics-path <=> root.diagnostics-path;
                        restore-project <=> root.restore-project;
                        save-project-on-exit <=> root.save-project-on-exit;
                        changed => { root.dirty = true; }
                    }
                }
            }

            SettingsFooter {
                note: root.dirty ? I18n.text.settings_ui.unsaved_changes : "";
                ok-label: I18n.text.settings_ui.ok;
                apply-label: I18n.text.settings_ui.apply;
                cancel-label: I18n.text.settings_ui.cancel;
                dirty: root.dirty;
                accept() => { root.accept-settings(); }
                apply() => { root.apply-settings(); }
                cancel() => { root.cancel-settings(); }
            }
        }
    }
}
