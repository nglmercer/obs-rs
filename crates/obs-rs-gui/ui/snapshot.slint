import { VerticalBox } from "std-widgets.slint";
import { I18n } from "i18n.slint";

export component SnapshotPanel inherits Rectangle {
    in property <string> locale;
    in property <string> snapshot;
    horizontal-stretch: 1;

                background: rgb(15, 23, 42);
                border-width: 1px;
                border-color: rgb(51, 65, 85);
                border-radius: 8px;
                min-height: 96px;
                VerticalBox {
                    padding: 12px;
                    spacing: 5px;
                    Text {
                        text: I18n.text.snapshot_title;
                        color: rgb(203, 213, 225);
                        font-size: 13px;
                        font-weight: 700;
                    }
                    Text {
                        text: snapshot;
                        color: rgb(148, 163, 184);
                        font-size: 11px;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                }
}
