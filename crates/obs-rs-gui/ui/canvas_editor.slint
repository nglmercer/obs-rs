import { Palette } from "palette.slint";

// The interactive transform overlay OBS draws on its preview: a bounding box
// around the selected scene item with eight handles. Everything here works in
// *canvas* pixels — the project's own coordinate space — and the enclosing
// component supplies the scale and offset that map them onto the widget, so the
// geometry stays correct whatever size the preview is letterboxed to.
export component CanvasEditor inherits Rectangle {
    // Selection rectangle in canvas pixels.
    in property <int> item-x;
    in property <int> item-y;
    in property <int> item-width;
    in property <int> item-height;
    in property <[int]> handle-x: [0, 0, 0, 0, 0, 0, 0, 0];
    in property <[int]> handle-y: [0, 0, 0, 0, 0, 0, 0, 0];
    in property <int> rotation-handle-x;
    in property <int> rotation-handle-y;
    in property <bool> rotation-handle-active: false;
    in property <string> selection-path: "";
    in property <bool> active;
    in property <bool> locked;
    // Canvas-to-widget mapping.
    in property <length> view-x;
    in property <length> view-y;
    in property <float> view-scale;
    in property <int> canvas-width;
    in property <int> canvas-height;
    in property <bool> show-safe-areas: false;
    in property <bool> space-held;
    in property <int> pointer-mode: 0; // 1 transform, 2 drag-box selection
    in property <bool> selection-box-active: false;
    in property <int> selection-box-x;
    in property <int> selection-box-y;
    in property <int> selection-box-width;
    in property <int> selection-box-height;

    // Both report canvas-pixel deltas. `handle` is 0 for a move and 1-8 for the
    // corner and edge handles, numbered clockwise from the top-left.
    // The modifier mask is captured when the gesture starts: bit 0 is Shift
    // (free resize), bit 1 is Ctrl (disable snapping).
    callback transform-dragged(int, int, int, int);
    callback transform-committed();
    callback rotation-started(int, int);
    callback rotation-dragged(int, int, int);
    callback canvas-pointer-pressed(int, int, bool);
    callback canvas-selection-dragged(int, int);
    callback canvas-selection-committed();
    callback canvas-pan-dragged(int, int);
    callback canvas-zoom-step(int);
    // direction, canvas anchor, pointer position, old view origin, and the
    // old view scale in fixed-point micros. The Rust controller uses these to
    // keep the point under the cursor stationary while zooming.
    callback canvas-zoom-at(int, int, int, int, int, int, int, int);

    property <length> handle-size: 9px;
    // A drag reports the delta since the previous move, so the Rust side only
    // ever applies increments and never needs the press origin.
    property <length> last-x;
    property <length> last-y;
    property <int> active-handle: -1;
    property <int> drag-modifiers: 0;
    property <bool> panning: root.active-handle == -2;

    pure function to-canvas-x(value: length) -> int {
        Math.round((value - root.view-x) / root.view-scale / 1px);
    }
    pure function to-canvas-y(value: length) -> int {
        Math.round((value - root.view-y) / root.view-scale / 1px);
    }
    pure function to-canvas-absolute-x(value: length) -> int {
        root.to-canvas-x(value - root.absolute-position.x);
    }
    pure function to-canvas-absolute-y(value: length) -> int {
        root.to-canvas-y(value - root.absolute-position.y);
    }
    pure function delta-canvas(value: length) -> int {
        Math.round(value / root.view-scale / 1px);
    }

    // Rec. ITU-R BT.1848-1 / EBU R 95 guide geometry. These are presentation
    // lines only; the Rust canvas keeps the matching integer snap guides.
    property <length> action-safe-x: root.view-x + root.canvas-width * 0.035 * root.view-scale * 1px;
    property <length> action-safe-y: root.view-y + root.canvas-height * 0.035 * root.view-scale * 1px;
    property <length> action-safe-width: root.canvas-width * 0.93 * root.view-scale * 1px;
    property <length> action-safe-height: root.canvas-height * 0.93 * root.view-scale * 1px;
    property <length> graphics-safe-x: root.view-x + root.canvas-width * 0.05 * root.view-scale * 1px;
    property <length> graphics-safe-y: root.view-y + root.canvas-height * 0.05 * root.view-scale * 1px;
    property <length> graphics-safe-width: root.canvas-width * 0.90 * root.view-scale * 1px;
    property <length> graphics-safe-height: root.canvas-height * 0.90 * root.view-scale * 1px;
    property <length> four-three-safe-x: root.view-x + root.canvas-width * 0.1625 * root.view-scale * 1px;
    property <length> four-three-safe-y: root.view-y + root.canvas-height * 0.05 * root.view-scale * 1px;
    property <length> four-three-safe-width: root.canvas-width * 0.675 * root.view-scale * 1px;
    property <length> four-three-safe-height: root.canvas-height * 0.90 * root.view-scale * 1px;

    // The whole-canvas area handles selection clicks and dragging the item.
    surface := TouchArea {
        mouse-cursor: root.panning
            ? MouseCursor.grabbing
            : (root.space-held
                ? MouseCursor.grab
                : (root.active && !root.locked ? MouseCursor.grab : MouseCursor.default));
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && (event.button == PointerEventButton.middle || root.space-held)) {
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
                root.active-handle = -2;
            } else if (event.kind == PointerEventKind.down) {
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
                root.active-handle = 0;
                root.drag-modifiers = (event.modifiers.shift ? 1 : 0)
                    + (event.modifiers.control ? 2 : 0);
                root.canvas-pointer-pressed(
                    root.to-canvas-x(self.mouse-x),
                    root.to-canvas-y(self.mouse-y),
                    event.modifiers.control);
            }
            if (event.kind == PointerEventKind.up && root.active-handle == -2) {
                root.active-handle = -1;
            } else if (event.kind == PointerEventKind.up && root.active-handle >= 0) {
                if root.pointer-mode == 2 {
                    root.canvas-selection-committed();
                } else {
                    root.transform-committed();
                }
                root.active-handle = -1;
                root.drag-modifiers = 0;
            }
        }
        moved => {
            if (root.active-handle == -2) {
                root.canvas-pan-dragged(
                    root.delta-canvas(self.mouse-x - root.last-x),
                    root.delta-canvas(self.mouse-y - root.last-y));
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
            } else if (root.active-handle == 0 && root.pointer-mode == 2) {
                root.canvas-selection-dragged(
                    root.to-canvas-x(self.mouse-x),
                    root.to-canvas-y(self.mouse-y));
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
            } else if (root.active-handle == 0
                && root.pointer-mode == 1
                && root.active
                && !root.locked) {
                root.transform-dragged(
                    0,
                    root.delta-canvas(self.mouse-x - root.last-x),
                    root.delta-canvas(self.mouse-y - root.last-y),
                    root.drag-modifiers);
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
            }
        }
        scroll-event(event) => {
            if event.delta-y > 0 {
                root.canvas-zoom-at(
                    1,
                    root.to-canvas-x(self.mouse-x),
                    root.to-canvas-y(self.mouse-y),
                    Math.round(self.mouse-x / 1px),
                    Math.round(self.mouse-y / 1px),
                    Math.round(root.view-x / 1px),
                    Math.round(root.view-y / 1px),
                    Math.round(root.view-scale * 1000000));
                return accept;
            }
            if event.delta-y < 0 {
                root.canvas-zoom-at(
                    -1,
                    root.to-canvas-x(self.mouse-x),
                    root.to-canvas-y(self.mouse-y),
                    Math.round(self.mouse-x / 1px),
                    Math.round(self.mouse-y / 1px),
                    Math.round(root.view-x / 1px),
                    Math.round(root.view-y / 1px),
                    Math.round(root.view-scale * 1000000));
                return accept;
            }
            reject
        }
    }

    if root.show-safe-areas : Rectangle {
        x: root.action-safe-x;
        y: root.action-safe-y;
        width: root.action-safe-width;
        height: root.action-safe-height;
        background: transparent;
        border-width: 1px;
        border-color: Palette.tokens.warning;
    }
    if root.show-safe-areas : Rectangle {
        x: root.graphics-safe-x;
        y: root.graphics-safe-y;
        width: root.graphics-safe-width;
        height: root.graphics-safe-height;
        background: transparent;
        border-width: 1px;
        border-color: Palette.tokens.accent;
    }
    if root.show-safe-areas : Rectangle {
        x: root.four-three-safe-x;
        y: root.four-three-safe-y;
        width: root.four-three-safe-width;
        height: root.four-three-safe-height;
        background: transparent;
        border-width: 1px;
        border-color: Palette.tokens.meter;
    }

    if root.active : Path {
        x: root.view-x;
        y: root.view-y;
        width: root.canvas-width * root.view-scale * 1px;
        height: root.canvas-height * root.view-scale * 1px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.canvas-width;
        viewbox-height: root.canvas-height;
        commands: root.selection-path;
        fill: transparent;
        stroke: root.locked ? Palette.tokens.warning : Palette.tokens.accent;
        stroke-width: 1px;
    }

    if root.selection-box-active : Rectangle {
        x: root.view-x + root.selection-box-x * root.view-scale * 1px;
        y: root.view-y + root.selection-box-y * root.view-scale * 1px;
        width: root.selection-box-width * root.view-scale * 1px;
        height: root.selection-box-height * root.view-scale * 1px;
        background: rgb(70, 130, 220, 40);
        border-width: 1px;
        border-color: Palette.tokens.accent;
    }

    // OBS exposes rotation from a ninth, detached handle. Its position is
    // supplied in canvas coordinates by Rust so it follows rotated items and
    // remains outside the axis-aligned selection bounds.
    if root.rotation-handle-active : Rectangle {
        visible: root.active && !root.locked;
        x: root.view-x + root.rotation-handle-x * root.view-scale * 1px - 6px;
        y: root.view-y + root.rotation-handle-y * root.view-scale * 1px - 6px;
        width: 12px;
        height: 12px;
        background: Palette.tokens.accent;
        border-width: 1px;
        border-color: white;
        border-radius: 6px;

        rotation-grip := TouchArea {
            mouse-cursor: MouseCursor.grab;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && (event.button == PointerEventButton.middle || root.space-held)) {
                    root.last-x = self.absolute-position.x + self.mouse-x;
                    root.last-y = self.absolute-position.y + self.mouse-y;
                    root.active-handle = -2;
                } else if (event.kind == PointerEventKind.down) {
                    root.drag-modifiers = (event.modifiers.shift ? 1 : 0)
                        + (event.modifiers.control ? 2 : 0);
                    root.active-handle = 17;
                    root.rotation-started(
                        root.to-canvas-absolute-x(self.absolute-position.x + self.mouse-x),
                        root.to-canvas-absolute-y(self.absolute-position.y + self.mouse-y));
                }
                if (event.kind == PointerEventKind.up && root.active-handle == -2) {
                    root.active-handle = -1;
                } else if (event.kind == PointerEventKind.up && root.active-handle == 17) {
                    root.active-handle = -1;
                    root.drag-modifiers = 0;
                    root.transform-committed();
                }
            }
            moved => {
                if (root.active-handle == -2) {
                    root.canvas-pan-dragged(
                        root.delta-canvas(self.absolute-position.x + self.mouse-x - root.last-x),
                        root.delta-canvas(self.absolute-position.y + self.mouse-y - root.last-y));
                    root.last-x = self.absolute-position.x + self.mouse-x;
                    root.last-y = self.absolute-position.y + self.mouse-y;
                } else if (root.active-handle == 17) {
                    root.rotation-dragged(
                        root.to-canvas-absolute-x(self.absolute-position.x + self.mouse-x),
                        root.to-canvas-absolute-y(self.absolute-position.y + self.mouse-y),
                        root.drag-modifiers);
                }
            }
        }
    }

    // Handles are laid out by hand because Rust publishes their canvas-space
    // coordinates rather than asking the UI to reproduce transform geometry.
    for handle in [
        { id: 1, fx: 0.0, fy: 0.0, cursor: MouseCursor.nwse-resize },
        { id: 2, fx: 0.5, fy: 0.0, cursor: MouseCursor.ns-resize },
        { id: 3, fx: 1.0, fy: 0.0, cursor: MouseCursor.nesw-resize },
        { id: 4, fx: 1.0, fy: 0.5, cursor: MouseCursor.ew-resize },
        { id: 5, fx: 1.0, fy: 1.0, cursor: MouseCursor.nwse-resize },
        { id: 6, fx: 0.5, fy: 1.0, cursor: MouseCursor.ns-resize },
        { id: 7, fx: 0.0, fy: 1.0, cursor: MouseCursor.nesw-resize },
        { id: 8, fx: 0.0, fy: 0.5, cursor: MouseCursor.ew-resize },
    ] : Rectangle {
        visible: root.active && !root.locked;
        x: root.view-x + root.handle-x[handle.id - 1] * root.view-scale * 1px
            - root.handle-size / 2;
        y: root.view-y + root.handle-y[handle.id - 1] * root.view-scale * 1px
            - root.handle-size / 2;
        width: root.handle-size;
        height: root.handle-size;
        background: Palette.tokens.accent;
        border-width: 1px;
        border-color: white;
        border-radius: 1px;

        grip := TouchArea {
            mouse-cursor: root.space-held ? MouseCursor.grab : handle.cursor;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                    && (event.button == PointerEventButton.middle || root.space-held)) {
                    root.last-x = self.absolute-position.x + self.mouse-x;
                    root.last-y = self.absolute-position.y + self.mouse-y;
                    root.active-handle = -2;
                } else if (event.kind == PointerEventKind.down) {
                    root.last-x = self.absolute-position.x;
                    root.last-y = self.absolute-position.y;
                    root.drag-modifiers = (event.modifiers.shift ? 1 : 0)
                        + (event.modifiers.control ? 2 : 0);
                    // OBS uses Alt+handle-drag to crop the source instead of
                    // resizing its scene-item rectangle. The Rust callback
                    // receives 9-16 for the corresponding 1-8 crop handles.
                    root.active-handle = handle.id + (event.modifiers.alt ? 8 : 0);
                }
                if (event.kind == PointerEventKind.up && root.active-handle == -2) {
                    root.active-handle = -1;
                } else if (event.kind == PointerEventKind.up && root.active-handle > 0) {
                    root.active-handle = -1;
                    root.drag-modifiers = 0;
                    root.transform-committed();
                }
            }
            moved => {
                if (root.active-handle == -2) {
                    root.canvas-pan-dragged(
                        root.delta-canvas(self.absolute-position.x + self.mouse-x - root.last-x),
                        root.delta-canvas(self.absolute-position.y + self.mouse-y - root.last-y));
                    root.last-x = self.absolute-position.x + self.mouse-x;
                    root.last-y = self.absolute-position.y + self.mouse-y;
                } else if (root.active-handle == handle.id
                    || root.active-handle == handle.id + 8) {
                    // A grip's own coordinates move with the box it resizes, so
                    // the delta is taken from the absolute pointer position.
                    root.transform-dragged(
                        root.active-handle,
                        root.delta-canvas(self.absolute-position.x + self.mouse-x - root.last-x),
                        root.delta-canvas(self.absolute-position.y + self.mouse-y - root.last-y),
                        root.drag-modifiers);
                    root.last-x = self.absolute-position.x + self.mouse-x;
                    root.last-y = self.absolute-position.y + self.mouse-y;
                }
            }
        }
    }
}
