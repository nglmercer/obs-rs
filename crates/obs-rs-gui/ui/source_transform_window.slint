import { Button, CheckBox, SpinBox } from "std-widgets.slint";
import { SettingRow, SettingsGroup } from "settings_widgets.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

// Edits the selected scene item. These values intentionally have no source
// settings or filter fields: the same source can carry different scene-item
// transforms in different scenes.
export component SourceTransformWindow inherits Window {
    title: "Scene Item Transform";
    width: 460px;
    height: 520px;
    background: Palette.tokens.window-bg;

    in property <string> source-name;
    in-out property <int> scale-x: 1000;
    in-out property <int> scale-y: 1000;
    in-out property <int> position-x: 0;
    in-out property <int> position-y: 0;
    in-out property <int> crop-left: 0;
    in-out property <int> crop-top: 0;
    in-out property <int> crop-right: 0;
    in-out property <int> crop-bottom: 0;
    in-out property <int> item-opacity: 255;
    in-out property <bool> flip-horizontal: false;
    in-out property <bool> flip-vertical: false;

    callback accept-transform();
    callback reset-transform();
    callback close-window();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Text {
            text: root.source-name == ""
                ? "Scene Item Transform"
                : "Scene Item Transform  ·  " + root.source-name;
            color: Palette.tokens.text-strong;
            font-size: 14px;
            font-weight: 700;
        }
        SettingsGroup {
            title: "Position";
            SettingRow {
                label: "X / Y";
                SpinBox { value <=> root.position-x; minimum: -32768; maximum: 32768; horizontal-stretch: 1; }
                SpinBox { value <=> root.position-y; minimum: -32768; maximum: 32768; horizontal-stretch: 1; }
            }
        }
        SettingsGroup {
            title: "Scale (‰)";
            SettingRow {
                label: "X / Y";
                SpinBox { value <=> root.scale-x; minimum: 1; maximum: 100000; horizontal-stretch: 1; }
                SpinBox { value <=> root.scale-y; minimum: 1; maximum: 100000; horizontal-stretch: 1; }
            }
        }
        SettingsGroup {
            title: "Crop";
            SettingRow {
                label: "Left / Top";
                SpinBox { value <=> root.crop-left; minimum: 0; maximum: 32768; horizontal-stretch: 1; }
                SpinBox { value <=> root.crop-top; minimum: 0; maximum: 32768; horizontal-stretch: 1; }
            }
            SettingRow {
                label: "Right / Bottom";
                SpinBox { value <=> root.crop-right; minimum: 0; maximum: 32768; horizontal-stretch: 1; }
                SpinBox { value <=> root.crop-bottom; minimum: 0; maximum: 32768; horizontal-stretch: 1; }
            }
        }
        SettingsGroup {
            title: "Appearance";
            SettingRow {
                label: "Opacity";
                SpinBox { value <=> root.item-opacity; minimum: 0; maximum: 255; horizontal-stretch: 1; }
            }
            CheckBox { text: "Flip horizontal"; checked <=> root.flip-horizontal; }
            CheckBox { text: "Flip vertical"; checked <=> root.flip-vertical; }
        }
        HorizontalLayout {
            height: 32px;
            Button {
                text: "Reset";
                width: 110px;
                clicked => root.reset-transform();
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: I18n.text.cancel;
                width: 110px;
                clicked => root.close-window();
            }
            Button {
                text: I18n.text.add_source_ui.ok;
                width: 110px;
                clicked => root.accept-transform();
            }
        }
    }
}
