import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { MenuBarButton, MenuEntry } from "theme.slint";
import { ProfileRow } from "models.slint";
import { LocaleOption } from "models.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

// Menus must be native popups: an ordinary child of the 26px bar is painted
// underneath the following canvas and cannot receive pointer events there.
component MenuPopup inherits PopupWindow {
    close-policy: close-on-click-outside;
    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.tokens.row-bg;
        border-width: 1px;
        border-color: Palette.tokens.border-strong;
        @children
    }
}

// Mirrors the OBS menu bar: a plain text strip flush with the window edge, no
// branding or iconography. Each dropdown anchors to the x of its own button so
// the layout stays correct when a translation changes the label widths.
export component AppNavbar inherits Rectangle {
    in property <string> locale;
    in property <[ProfileRow]> profile-rows;
    in property <[ProfileRow]> collection-rows;
    in property <[LocaleOption]> locale-options;
    // Undo and Redo are greyed out at the ends of the history, so the menu
    // never offers an entry that would silently do nothing.
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> show-sources;
    in property <bool> show-scenes;
    in property <bool> show-mixer;
    in property <bool> show-transitions;
    in property <bool> show-controls;
    in property <string> hotkey-undo;
    in property <string> hotkey-redo;
    in property <string> hotkey-save-project;
    in property <string> hotkey-fade-transition;
    in property <bool> studio-mode;
    in property <int> view-mode;
    callback menu-action(string);
    callback select-view-mode(int);
    callback select-profile(string);
    callback select-collection(string);
    callback set-locale(string);

    height: 26px;
    background: Palette.tokens.row-bg;
    z: 10;

    HorizontalBox {
        padding: 0px;
        padding-left: 4px;
        padding-right: 6px;
        spacing: 0px;
        alignment: start;
        file-button := MenuBarButton {
            label: I18n.text.nav_file;
            active: file-popup.is-open;
            clicked => { file-popup.show(); }
        }
        edit-button := MenuBarButton {
            label: I18n.text.nav_edit;
            active: edit-popup.is-open;
            clicked => { edit-popup.show(); }
        }
        view-button := MenuBarButton {
            label: I18n.text.nav_view;
            active: view-popup.is-open;
            clicked => { view-popup.show(); }
        }
        docks-button := MenuBarButton {
            label: I18n.text.nav_docks;
            active: docks-popup.is-open;
            clicked => { docks-popup.show(); }
        }
        profile-button := MenuBarButton {
            label: I18n.text.nav_profile;
            active: profile-popup.is-open;
            clicked => { profile-popup.show(); }
        }
        collection-button := MenuBarButton {
            label: I18n.text.nav_scene_collection;
            active: collection-popup.is-open;
            clicked => { collection-popup.show(); }
        }
        tools-button := MenuBarButton {
            label: I18n.text.nav_tools;
            active: tools-popup.is-open;
            clicked => { tools-popup.show(); }
        }
        help-button := MenuBarButton {
            label: I18n.text.nav_help;
            active: help-popup.is-open;
            clicked => { help-popup.show(); }
        }
        Rectangle { horizontal-stretch: 1; }
        for option in locale-options : MenuBarButton {
            label: option.label;
            active: root.locale == option.code;
            clicked => root.set-locale(option.code);
        }
    }

    file-popup := MenuPopup {
        x: file-button.x;
        y: root.height;
        width: 224px;
        height: 200px;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry { label: I18n.text.menu_new_project; clicked => { root.menu-action("new-project"); file-popup.close(); } }
            MenuEntry { label: I18n.text.menu_open_project; clicked => { root.menu-action("load-project"); file-popup.close(); } }
            MenuEntry { label: I18n.text.menu_save; shortcut: root.hotkey-save-project; clicked => { root.menu-action("save-project"); file-popup.close(); } }
            MenuEntry { label: I18n.text.menu_recover_project; clicked => { root.menu-action("recover-project"); file-popup.close(); } }
            MenuEntry { label: I18n.text.menu_export_diagnostics; clicked => { root.menu-action("export-diagnostics"); file-popup.close(); } }
            Rectangle { height: 1px; background: Palette.tokens.border-strong; }
            MenuEntry { label: I18n.text.menu_settings; clicked => { root.menu-action("settings"); file-popup.close(); } }
            MenuEntry { label: I18n.text.menu_exit; destructive: true; clicked => { root.menu-action("exit"); file-popup.close(); } }
        }
    }
    edit-popup := MenuPopup {
        x: edit-button.x;
        y: root.height;
        width: 224px;
        height: 108px;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry {
                label: I18n.text.menu_undo;
                shortcut: root.hotkey-undo;
                enabled: root.can-undo;
                clicked => { root.menu-action("undo"); edit-popup.close(); }
            }
            MenuEntry {
                label: I18n.text.menu_redo;
                shortcut: root.hotkey-redo;
                enabled: root.can-redo;
                clicked => { root.menu-action("redo"); edit-popup.close(); }
            }
            MenuEntry { label: I18n.text.menu_preferences; clicked => { root.menu-action("settings"); edit-popup.close(); } }
        }
    }
    view-popup := MenuPopup {
        x: view-button.x;
        y: root.height;
        width: 260px;
        height: 194px;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry {
                label: I18n.text.menu_studio_mode;
                checkable: true;
                checked: root.studio-mode;
                clicked => { root.select-view-mode(-1); view-popup.close(); }
            }
            MenuEntry {
                label: I18n.text.menu_multiview;
                checkable: true;
                checked: root.view-mode == 2;
                clicked => { root.select-view-mode(2); view-popup.close(); }
            }
            MenuEntry { label: I18n.text.menu_multiview_projector; clicked => { root.menu-action("projector-multiview"); view-popup.close(); } }
            MenuEntry { label: I18n.text.menu_preview_projector; clicked => { root.menu-action("projector-preview"); view-popup.close(); } }
            MenuEntry { label: I18n.text.menu_source_projector; clicked => { root.menu-action("projector-source"); view-popup.close(); } }
            MenuEntry { label: I18n.text.menu_program_projector; clicked => { root.menu-action("projector-program"); view-popup.close(); } }
        }
    }
    docks-popup := MenuPopup {
        x: docks-button.x;
        y: root.height;
        width: 224px;
        height: 196px;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry {
                label: I18n.text.menu_sources;
                checkable: true;
                checked: root.show-sources;
                clicked => { root.menu-action("toggle-sources"); docks-popup.close(); }
            }
            MenuEntry {
                label: I18n.text.menu_scenes;
                checkable: true;
                checked: root.show-scenes;
                clicked => { root.menu-action("toggle-scenes"); docks-popup.close(); }
            }
            MenuEntry {
                label: I18n.text.menu_audio_mixer;
                checkable: true;
                checked: root.show-mixer;
                clicked => { root.menu-action("toggle-mixer"); docks-popup.close(); }
            }
            MenuEntry {
                label: I18n.text.menu_transitions;
                checkable: true;
                checked: root.show-transitions;
                clicked => { root.menu-action("toggle-transitions"); docks-popup.close(); }
            }
            MenuEntry {
                label: I18n.text.menu_controls;
                checkable: true;
                checked: root.show-controls;
                clicked => { root.menu-action("toggle-controls"); docks-popup.close(); }
            }
            Rectangle { height: 1px; background: Palette.tokens.border-strong; }
            MenuEntry { label: I18n.text.menu_reset_layout; clicked => { root.menu-action("reset-layout"); docks-popup.close(); } }
        }
    }
    profile-popup := MenuPopup {
        x: profile-button.x;
        y: root.height;
        width: 224px;
        height: 140px;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            for profile in profile-rows : MenuEntry {
                label: profile.name;
                checkable: true;
                checked: profile.active;
                clicked => { root.select-profile(profile.id); profile-popup.close(); }
            }
            Rectangle { height: 1px; background: Palette.tokens.border-strong; }
            MenuEntry { label: I18n.text.menu_manage_profiles; clicked => { root.menu-action("settings"); profile-popup.close(); } }
        }
    }
    collection-popup := MenuPopup {
        x: collection-button.x;
        y: root.height;
        // The discovered collections are listed inline the way the profile
        // menu lists profiles, so switching is one click rather than a dialog.
        height: 224px + (root.collection-rows.length * 29px);
        width: 260px;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            for collection in collection-rows : MenuEntry {
                label: collection.name;
                checkable: true;
                checked: collection.active;
                clicked => { root.select-collection(collection.id); collection-popup.close(); }
            }
            Rectangle { height: 1px; background: Palette.tokens.border-strong; }
            MenuEntry { label: I18n.text.menu_new_collection; clicked => { root.menu-action("new-collection"); collection-popup.close(); } }
            MenuEntry { label: I18n.text.menu_duplicate_collection; clicked => { root.menu-action("duplicate-collection"); collection-popup.close(); } }
            MenuEntry { label: I18n.text.menu_rename_collection; clicked => { root.menu-action("rename-collection"); collection-popup.close(); } }
            MenuEntry { label: I18n.text.menu_export_collection; clicked => { root.menu-action("export-collection"); collection-popup.close(); } }
            MenuEntry { label: I18n.text.menu_import_collection; clicked => { root.menu-action("import-collection"); collection-popup.close(); } }
            MenuEntry { label: I18n.text.menu_save_collection; clicked => { root.menu-action("save-collection"); collection-popup.close(); } }
        }
    }
    tools-popup := MenuPopup {
        x: tools-button.x;
        y: root.height;
        width: 224px;
        height: 136px;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry { label: I18n.text.menu_auto_setup; clicked => { root.menu-action("auto-configuration"); tools-popup.close(); } }
            MenuEntry { label: I18n.text.menu_source_properties; clicked => { root.menu-action("source-properties"); tools-popup.close(); } }
            MenuEntry { label: I18n.text.menu_source_filters; clicked => { root.menu-action("source-filters"); tools-popup.close(); } }
            MenuEntry { label: I18n.text.menu_diagnostic_log; clicked => { root.menu-action("export-diagnostics"); tools-popup.close(); } }
        }
    }
    help-popup := MenuPopup {
        x: help-button.x;
        y: root.height;
        width: 224px;
        height: 80px;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry { label: I18n.text.menu_documentation; clicked => { root.menu-action("documentation"); help-popup.close(); } }
            MenuEntry { label: I18n.text.menu_about; clicked => { root.menu-action("about"); help-popup.close(); } }
        }
    }
}
