import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { MenuBarButton, MenuEntry } from "theme.slint";
import { ProfileRow } from "models.slint";
import { LocaleOption } from "models.slint";
import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

// Mirrors the OBS menu bar: a plain text strip flush with the window edge, no
// branding or iconography. Each dropdown anchors to the x of its own button so
// the layout stays correct when a translation changes the label widths.
export component AppNavbar inherits Rectangle {
    in property <string> locale;
    in property <[ProfileRow]> profile-rows;
    in property <[ProfileRow]> collection-rows;
    in property <[LocaleOption]> locale-options;
    // Undo and Redo are greyed out at the ends of the history, so the menu
    // never offers an entry that would silently do nothing.
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> show-sources;
    in property <bool> show-scenes;
    in property <bool> show-mixer;
    in property <bool> show-transitions;
    in property <bool> show-controls;
    in property <bool> studio-mode;
    callback menu-action(string);
    callback select-view-mode(int);
    callback select-profile(string);
    callback select-collection(string);
    callback set-locale(string);

    property <int> open-menu: 0;
    height: 26px;
    background: Palette.tokens.row-bg;
    z: 10;

    HorizontalBox {
        padding: 0px;
        padding-left: 4px;
        padding-right: 6px;
        spacing: 0px;
        alignment: start;
        file-button := MenuBarButton {
            label: I18n.text.nav_file;
            active: open-menu == 1;
            clicked => { root.open-menu = open-menu == 1 ? 0 : 1; }
        }
        edit-button := MenuBarButton {
            label: I18n.text.nav_edit;
            active: open-menu == 2;
            clicked => { root.open-menu = open-menu == 2 ? 0 : 2; }
        }
        view-button := MenuBarButton {
            label: I18n.text.nav_view;
            active: open-menu == 3;
            clicked => { root.open-menu = open-menu == 3 ? 0 : 3; }
        }
        docks-button := MenuBarButton {
            label: I18n.text.nav_docks;
            active: open-menu == 4;
            clicked => { root.open-menu = open-menu == 4 ? 0 : 4; }
        }
        profile-button := MenuBarButton {
            label: I18n.text.nav_profile;
            active: open-menu == 5;
            clicked => { root.open-menu = open-menu == 5 ? 0 : 5; }
        }
        collection-button := MenuBarButton {
            label: I18n.text.nav_scene_collection;
            active: open-menu == 6;
            clicked => { root.open-menu = open-menu == 6 ? 0 : 6; }
        }
        tools-button := MenuBarButton {
            label: I18n.text.nav_tools;
            active: open-menu == 7;
            clicked => { root.open-menu = open-menu == 7 ? 0 : 7; }
        }
        help-button := MenuBarButton {
            label: I18n.text.nav_help;
            active: open-menu == 8;
            clicked => { root.open-menu = open-menu == 8 ? 0 : 8; }
        }
        Rectangle { horizontal-stretch: 1; }
        for option in locale-options : MenuBarButton {
            label: option.label;
            active: root.locale == option.code;
            clicked => root.set-locale(option.code);
        }
    }

    if open-menu == 1 : Rectangle {
        x: file-button.x;
        y: root.height;
        width: 224px;
        height: 200px;
        background: Palette.tokens.row-bg;
        border-width: 1px;
        border-color: Palette.tokens.border-strong;
        z: 30;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry { label: I18n.text.menu_new_project; clicked => { root.menu-action("new-project"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_open_project; clicked => { root.menu-action("load-project"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_save; shortcut: "Ctrl+S"; clicked => { root.menu-action("save-project"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_recover_project; clicked => { root.menu-action("recover-project"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_export_diagnostics; clicked => { root.menu-action("export-diagnostics"); root.open-menu = 0; } }
            Rectangle { height: 1px; background: Palette.tokens.border-strong; }
            MenuEntry { label: I18n.text.menu_settings; clicked => { root.menu-action("settings"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_exit; destructive: true; clicked => { root.menu-action("exit"); root.open-menu = 0; } }
        }
    }
    if open-menu == 2 : Rectangle {
        x: edit-button.x;
        y: root.height;
        width: 224px;
        height: 108px;
        background: Palette.tokens.row-bg;
        border-width: 1px;
        border-color: Palette.tokens.border-strong;
        z: 30;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry {
                label: I18n.text.menu_undo;
                shortcut: "Ctrl+Z";
                enabled: root.can-undo;
                clicked => { root.menu-action("undo"); root.open-menu = 0; }
            }
            MenuEntry {
                label: I18n.text.menu_redo;
                shortcut: "Ctrl+Y";
                enabled: root.can-redo;
                clicked => { root.menu-action("redo"); root.open-menu = 0; }
            }
            MenuEntry { label: I18n.text.menu_preferences; clicked => { root.menu-action("settings"); root.open-menu = 0; } }
        }
    }
    if open-menu == 3 : Rectangle {
        x: view-button.x;
        y: root.height;
        width: 260px;
        height: 108px;
        background: Palette.tokens.row-bg;
        border-width: 1px;
        border-color: Palette.tokens.border-strong;
        z: 30;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry {
                label: I18n.text.menu_studio_mode;
                checkable: true;
                checked: root.studio-mode;
                clicked => { root.select-view-mode(-1); root.open-menu = 0; }
            }
            MenuEntry { label: I18n.text.menu_preview_projector; clicked => { root.menu-action("projector-preview"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_program_projector; clicked => { root.menu-action("projector-program"); root.open-menu = 0; } }
        }
    }
    if open-menu == 4 : Rectangle {
        x: docks-button.x;
        y: root.height;
        width: 224px;
        height: 196px;
        background: Palette.tokens.row-bg;
        border-width: 1px;
        border-color: Palette.tokens.border-strong;
        z: 30;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry {
                label: I18n.text.menu_sources;
                checkable: true;
                checked: root.show-sources;
                clicked => { root.menu-action("toggle-sources"); root.open-menu = 0; }
            }
            MenuEntry {
                label: I18n.text.menu_scenes;
                checkable: true;
                checked: root.show-scenes;
                clicked => { root.menu-action("toggle-scenes"); root.open-menu = 0; }
            }
            MenuEntry {
                label: I18n.text.menu_audio_mixer;
                checkable: true;
                checked: root.show-mixer;
                clicked => { root.menu-action("toggle-mixer"); root.open-menu = 0; }
            }
            MenuEntry {
                label: I18n.text.menu_transitions;
                checkable: true;
                checked: root.show-transitions;
                clicked => { root.menu-action("toggle-transitions"); root.open-menu = 0; }
            }
            MenuEntry {
                label: I18n.text.menu_controls;
                checkable: true;
                checked: root.show-controls;
                clicked => { root.menu-action("toggle-controls"); root.open-menu = 0; }
            }
            Rectangle { height: 1px; background: Palette.tokens.border-strong; }
            MenuEntry { label: I18n.text.menu_reset_layout; clicked => { root.menu-action("reset-layout"); root.open-menu = 0; } }
        }
    }
    if open-menu == 5 : Rectangle {
        x: profile-button.x;
        y: root.height;
        width: 224px;
        height: 140px;
        background: Palette.tokens.row-bg;
        border-width: 1px;
        border-color: Palette.tokens.border-strong;
        z: 30;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            for profile in profile-rows : MenuEntry {
                label: profile.name;
                checkable: true;
                checked: profile.active;
                clicked => { root.select-profile(profile.id); root.open-menu = 0; }
            }
            Rectangle { height: 1px; background: Palette.tokens.border-strong; }
            MenuEntry { label: I18n.text.menu_manage_profiles; clicked => { root.menu-action("settings"); root.open-menu = 0; } }
        }
    }
    if open-menu == 6 : Rectangle {
        x: collection-button.x;
        y: root.height;
        // The discovered collections are listed inline the way the profile
        // menu lists profiles, so switching is one click rather than a dialog.
        height: 108px + (root.collection-rows.length * 29px);
        width: 260px;
        background: Palette.tokens.row-bg;
        border-width: 1px;
        border-color: Palette.tokens.border-strong;
        z: 30;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            for collection in collection-rows : MenuEntry {
                label: collection.name;
                checkable: true;
                checked: collection.active;
                clicked => { root.select-collection(collection.id); root.open-menu = 0; }
            }
            Rectangle { height: 1px; background: Palette.tokens.border-strong; }
            MenuEntry { label: I18n.text.menu_new_collection; clicked => { root.menu-action("new-collection"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_save_collection; clicked => { root.menu-action("save-collection"); root.open-menu = 0; } }
        }
    }
    if open-menu == 7 : Rectangle {
        x: tools-button.x;
        y: root.height;
        width: 224px;
        height: 108px;
        background: Palette.tokens.row-bg;
        border-width: 1px;
        border-color: Palette.tokens.border-strong;
        z: 30;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry { label: I18n.text.menu_source_properties; clicked => { root.menu-action("source-properties"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_source_filters; clicked => { root.menu-action("source-filters"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_diagnostic_log; clicked => { root.menu-action("export-diagnostics"); root.open-menu = 0; } }
        }
    }
    if open-menu == 8 : Rectangle {
        x: help-button.x;
        y: root.height;
        width: 224px;
        height: 80px;
        background: Palette.tokens.row-bg;
        border-width: 1px;
        border-color: Palette.tokens.border-strong;
        z: 30;
        VerticalBox {
            padding: 6px;
            spacing: 1px;
            MenuEntry { label: I18n.text.menu_documentation; clicked => { root.menu-action("documentation"); root.open-menu = 0; } }
            MenuEntry { label: I18n.text.menu_about; clicked => { root.menu-action("about"); root.open-menu = 0; } }
        }
    }
}
