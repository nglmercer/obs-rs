    export struct SceneRow {
        id: string,
        name: string,
        role: string,
    }

    export struct SourceRow {
        id: string,
        name: string,
        kind: string,
        order: string,
        selected: bool,
        visible: bool,
        locked: bool,
        first: bool,
        last: bool,
    }

    export struct ProfileRow {
        id: string,
        name: string,
        // Marks the selected profile or scene collection so its menu entry can
        // carry a check mark instead of looking like every other row.
        active: bool,
    }

    export struct LocaleOption {
        code: string,
        label: string,
    }

    export struct MixerRow {
        id: string,
        name: string,
        gain: float,
        // Logarithmic full-scale value used by the operator-facing VU meter.
        peak-db: float,
        muted: bool,
    }

    // One entry in the Add Source kind list. `obsolete` groups deprecated kinds
    // under their own heading the way OBS does.
    export struct SourceKindRow {
        id: string,
        label: string,
        icon: string,
        obsolete: bool,
    }

    // One selectable display in the monitor picker. The normalized fields place
    // the monitor inside the layout map without the UI knowing desktop
    // coordinates: Rust divides each rectangle by the bounding desktop.
    export struct MonitorRow {
        id: string,
        name: string,
        geometry: string,
        primary: bool,
        selected: bool,
        normalized_x: float,
        normalized_y: float,
        normalized_width: float,
        normalized_height: float,
    }

    // One card in the Add Source grid: either an existing source that can be
    // added to the current scene, or a preview of what a new one would be.
    export struct SourceCandidate {
        id: string,
        name: string,
        kind: string,
        kind_label: string,
        scene: string,
        icon: string,
        selected: bool,
    }

    // One editable property in the source properties dialog.
    //
    // `kind` selects the widget: 0 text, 1 number, 2 toggle, 3 choice,
    // 4 colour. Keeping every value in one row means adding a property to a
    // source kind is a Rust-side change only.
    export struct PropertyRow {
        key: string,
        label: string,
        hint: string,
        kind: int,
        text: string,
        number: int,
        minimum: int,
        maximum: int,
        toggle: bool,
        choices: [string],
        choice_index: int,
        swatch: brush,
    }
